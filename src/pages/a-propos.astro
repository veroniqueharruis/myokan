---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import ContextualCta from "@components/contextual-cta.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "L'atelier",
      "item": "https://myokan.fr/a-propos/"
    }
  ]
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Véronique Myokan Harruis",
  "jobTitle": "Nonne zen Soto et créatrice de zafus artisanaux",
  "description": "Pratiquante de zazen depuis 1980 ordonnée bodhisattva par maître Taisen Deshimaru et couturière d'accessoires zen artisanaux à Montpellier depuis 1982.",
  "image": "https://myokan.fr/veronique-atelier.webp",
  "worksFor": {
    "@type": "LocalBusiness",
    "name": "Myokan",
    "url": "https://myokan.fr/"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montpellier",
    "addressRegion": "Occitanie",
    "addressCountry": "FR"
  }
};
---

<Layout
  fullTitle="L'atelier Myokan & Véronique Harruis — Confection artisanale depuis 1982 | Montpellier"
  description="Véronique Myokan Harruis pratique le zazen depuis 1980 et confectionne des zafus artisanaux depuis 1982 à Montpellier selon la tradition transmise par maître Deshimaru."
  image="/veronique-atelier.webp"
  imageAlt="Véronique Myokan Harruis dans son atelier artisanal à Montpellier">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />

  <Container>
    <main id="main-content" class="max-w-2xl mx-auto mt-10 mb-20">
      
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="text-xs text-gray-600 dark:text-gray-400 mb-8">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accueil</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-gray-900 dark:text-white" aria-current="page">L'atelier</li>
        </ol>
      </nav>

      <div id="veronique" class="flex flex-col sm:flex-row gap-6 sm:gap-8 items-center sm:items-start text-center sm:text-left scroll-mt-20">
        <img
          src="/veronique.webp"
          alt="Véronique Myokan Harruis, nonne zen et créatrice de zafus artisanaux à Montpellier"
          width="160"
          height="160"
          class="w-36 h-36 sm:w-40 sm:h-40 rounded-full object-cover shrink-0 shadow-md border-4 border-white dark:border-gray-800"
          loading="eager"
        />
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">Véronique Myokan Harruis</h1>
          <p class="text-lg text-gray-600 dark:text-gray-400 mt-1">Nonne zen Soto et couturière artisanale · Montpellier</p>
          <div class="mt-3 flex flex-wrap justify-center sm:justify-start gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200">
              Pratique zazen depuis 1980
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200">
              Couture artisanale depuis 1982
            </span>
          </div>
        </div>
      </div>

      <!-- Photographie authentique de Véronique à l'atelier -->
      <figure class="my-8 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs">
        <div class="relative aspect-[4/5] sm:aspect-[16/11] overflow-hidden bg-gray-100 dark:bg-gray-800">
          <img
            src="/veronique-atelier.webp"
            alt="Véronique Myokan Harruis dans son atelier de couture à Montpellier, devant sa machine et ses zafus artisanaux"
            width="1093"
            height="1439"
            class="w-full h-full object-cover object-[center_28%]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="p-3.5 text-xs sm:text-sm text-center text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800">
          Véronique Myokan Harruis à sa table de confection dans l'atelier Myokan à Montpellier, entourée de ses créations artisanales.
        </figcaption>
      </figure>

      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">La pratique du zazen</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        J'ai débuté la pratique du zazen en 1980 auprès de maître Taisen Deshimaru, fondateur
        de la Soto Zen Mission en Europe. En 1981, j'ai reçu l'ordination de bodhisattva de ses
        mains. Durant quinze ans, j'ai participé à de nombreux camps d'été et sesshins au temple
        de la Gendronnière, en Loir-et-Cher, haut lieu de la transmission zen en France.
      </p>
      <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        J'ai ensuite poursuivi mon chemin avec maître Stéphane Kosen Thibaut, dans le cadre de la Kosen Sangha.
        Aujourd'hui, je pratique au
        <a href="https://zen-montpellier.fr/" class="underline hover:text-gray-950 dark:hover:text-white font-medium" target="_blank" rel="noopener">Dojo Zen de Montpellier</a>,
        où zazen, cérémonie et vie communautaire continuent de nourrir ma pratique quotidienne.
      </p>
      <p class="text-base mt-3 text-gray-600 dark:text-gray-400">
        Pour approfondir la posture assise et son contexte traditionnel, vous pouvez également consulter nos <a href="/pratique-zazen/" class="underline hover:text-gray-950 dark:hover:text-white">repères sur la posture et la tradition du zazen</a>.
      </p>

      <h2 id="artisanat" class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4 scroll-mt-20">La confection des zafus depuis 1982</h2>

      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        C'est en 1982, à l'atelier du dojo de Paris à Pernety, que j'ai appris à confectionner
        les premiers zafus. On m'a expliqué que cette méthode traditionnelle avait été transmise
        par maître Deshimaru, qui en avait préservé la forme exacte issue de la tradition japonaise.
      </p>
      <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        Depuis, je continue à réaliser ces coussins de zazen selon cette méthode, à la demande,
        depuis Montpellier. Chaque <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zafu</a>, 
        chaque <a href="/zabutons/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zabuton</a>, 
        chaque accessoire est cousu à la machine dans le strict respect de la méthode traditionnelle, avec les matériaux et les gestes transmis depuis plus de quarante ans.
      </p>

      <!-- Preuve visuelle du travail du zafu dans l'atelier -->
      <div class="my-8 grid sm:grid-cols-2 gap-4">
        <figure class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs flex flex-col justify-between">
          <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src="/zafus-vides-gris.webp"
              alt="Housses de zafus artisanales cousues à la machine avec plis accordéon à plat"
              width="600"
              height="450"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <figcaption class="p-3 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800">
            <strong>Patronage traditionnel :</strong> plis d'aisance latéraux réguliers formés avant l'insertion du kapok.
          </figcaption>
        </figure>

        <figure class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs flex flex-col justify-between">
          <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src="/zafus-pile.webp"
              alt="Zafus artisanaux multicolores garnis de kapok végétal naturel empilés à l'atelier"
              width="600"
              height="450"
              class="w-full h-full object-cover object-[center_35%]"
              loading="lazy"
            />
          </div>
          <figcaption class="p-3 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800">
            <strong>Tassage dense du kapok :</strong> environ 1 kg de fibre végétale par zafu, assurant fermeté et longévité.
          </figcaption>
        </figure>
      </div>

      <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        Je propose également des <a href="/sacs-zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">sacs à zafu</a> en coton,
        des <a href="/fukusas/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">fukusas</a>,
        des <a href="/oryokis/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">oryokis</a> adaptés aux usages
        de la Kosen Sangha, ainsi que des <a href="/kesas/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">sacs à kesa et pochettes de ketsumyaku</a>.
      </p>

      <figure class="my-8 overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
        <img
          src="/oryokis-etagere.webp"
          alt="Étagère de présentation des confections artisanales d'oryokis et fukusas à l'atelier Myokan"
          width="800"
          height="600"
          class="w-full h-64 sm:h-80 object-cover"
          loading="lazy"
        />
        <figcaption class="p-3 text-xs text-center text-gray-500 dark:text-gray-400">
          Ensembles d'oryokis et fukusas confectionnés selon la méthode traditionnelle dans l'atelier Myokan à Montpellier
        </figcaption>
      </figure>

      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">Autres activités artistiques</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        En dehors de la pratique zen et de la couture, je me passionne pour le théâtre de marionnettes.
        En 2009, j'ai créé la compagnie «&nbsp;Les Marrons Show&nbsp;» et animé des ateliers destinés aux enfants.
        Je fais également partie d'une troupe amateur — le théâtre occupe une place vivante dans ma vie,
        au même titre que le zazen et le travail du tissu.
      </p>

      <!-- Découverte des créations -->
      <section class="mt-14 pt-8 border-t border-gray-200 dark:border-gray-800" aria-labelledby="creations-atelier-heading">
        <h3 id="creations-atelier-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-4">
          Découvrir les créations de l'atelier
        </h3>
        <div class="grid sm:grid-cols-2 gap-3">
          <a 
            href="/zafus/" 
            class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
          >
            <div>
              <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Zafus de méditation</span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Coussins traditionnels sur mesure en kapok végétal</span>
            </div>
            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir nos zafus artisanaux →</span>
          </a>

          <a 
            href="/zabutons/" 
            class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
          >
            <div>
              <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Zabutons traditionnels</span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Tapis d'assise protecteur pour chevilles et genoux</span>
            </div>
            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Voir les zabutons →</span>
          </a>

          <a 
            href="/oryokis/" 
            class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
          >
            <div>
              <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Oryokis & Fukusas</span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Bols en bois tourné et étoffes rituelles pour sesshin</span>
            </div>
            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Voir les oryokis →</span>
          </a>

          <a 
            href="/pratique-zazen/" 
            class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
          >
            <div>
              <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Posture & tradition du zazen</span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Repères d'assise, rôle du zafu et dojo</span>
            </div>
            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Consulter les repères →</span>
          </a>
        </div>
      </section>

      <ContextualCta
        eyebrow="Artisanat zen · Depuis 1982"
        title="Découvrir les zafus réalisés à l'atelier"
        description="Chaque pièce est confectionnée sur commande à Montpellier par Véronique Myokan Harruis selon la méthode traditionnelle transmise par maître Deshimaru."
        primaryCta={{
          label: "Voir les zafus de l'atelier",
          href: "/zafus/"
        }}
        secondaryCta={{
          label: "Commander ou demander un devis",
          href: "/commander/"
        }}
        variant="highlight"
        class="mt-12"
      />

    </main>
  </Container>
</Layout>
