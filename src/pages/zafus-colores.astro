---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Zafus",
      "item": "https://myokan.fr/zafus/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Zafus colorés",
      "item": "https://myokan.fr/zafus-colores/"
    }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Zafus colorés pour la maison & assise au sol — Myokan",
  "description": "Coussins de sol artisanaux colorés en toile de coton et kapok végétal naturel. Confectionnés à Montpellier pour décorer l'intérieur, s'asseoir autour d'une table basse et se détendre.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "image": "https://myokan.fr/zafus-pile.webp",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "lowPrice": "40",
    "highPrice": "50",
    "offerCount": "8",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://myokan.fr/zafus-colores/",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};

const colorModels = [
  {
    id: "rouge",
    name: "Zafu Rouge vermillon",
    colorFamily: "Chaleureux & Vivant",
    hex: "#B91C1C",
    desc: "Une teinte rouge profonde et lumineuse qui réchauffe instantanément un parquet de chêne, un carrelage ou un tapis clair.",
    image: "/zafu-plein-rouge.webp",
    alt: "Zafu artisanal rouge vermillon en toile de coton garni de kapok végétal",
    usage: "Salon, table basse, espace convivial",
    badge: "Couleur chaleureuse",
  },
  {
    id: "bleu-roi",
    name: "Zafu Bleu roi",
    colorFamily: "Éclatant & Contemporain",
    hex: "#1D4ED8",
    desc: "Un bleu franc et dynamique qui apporte du caractère et une fraîcheur contemporaine à un séjour ou une véranda ensoleillée.",
    image: "/zafu-plein-bleu.webp",
    alt: "Zafu artisanal bleu roi aux plis traditionnels garni de kapok",
    usage: "Espace détente, intérieur moderne",
    badge: "Tonique",
  },
  {
    id: "orange",
    name: "Zafu Orange lumineux",
    colorFamily: "Solaire & Accueillant",
    hex: "#EA580C",
    desc: "Une nuance tonique et solaire qui invite naturellement à s'asseoir au sol pour partager un moment détendu en famille ou entre amis.",
    image: "/zafu-plein-orange.webp",
    alt: "Zafu artisanal orange lumineux confectionné à l'atelier Myokan",
    usage: "Moments partagés, chambre, salon",
    badge: "Solaire",
  },
  {
    id: "vert",
    name: "Zafu Vert pré & mousse",
    colorFamily: "Végétal & Apaisant",
    hex: "#15803D",
    desc: "Une nuance végétale apaisante inspirée de la nature, qui s'accorde avec le mobilier en bois, les plantes vertes et les fibres brutes.",
    image: "/zafu-plein-vert.webp",
    alt: "Zafu artisanal vert en coton naturel épais pour assise au sol",
    usage: "Coin lecture, coin plantes, détente",
    badge: "Naturel",
  },
  {
    id: "violet-pois",
    name: "Zafu Violet à pois",
    colorFamily: "Poétique & Singulier",
    hex: "#7C3AED",
    desc: "Une confection textile originale sur toile violette ornée de petits pois blancs, alliant confort d'assise et touche décorative délicate.",
    image: "/zafu-plein-violet-pois.webp",
    alt: "Zafu artisanal violet à pois blancs réalisé unitairement à Montpellier",
    usage: "Chambre, salon créatif, assise d'appoint",
    badge: "Motif fantaisie",
  },
  {
    id: "violet",
    name: "Zafu Violet profond",
    colorFamily: "Feutré & Élégant",
    hex: "#6B21A8",
    desc: "Une couleur riche et veloutée qui apporte une élégance feutrée au pied d'un meuble bas, dans une bibliothèque ou un boudoir.",
    image: "/zafu-plein-violet.webp",
    alt: "Zafu artisanal violet profond garni de kapok végétal",
    usage: "Coin repos, espace lecture",
    badge: "Élégant",
  },
  {
    id: "bleu-nuit",
    name: "Zafu Bleu nuit & Indigo",
    colorFamily: "Sobre & Intemporel",
    hex: "#1E3A8A",
    desc: "Un bleu sombre et dense qui évoque les étoffes d'indigo japonais, parfait pour ceux qui souhaitent une assise discrète mais subtilement colorée.",
    image: "/zafu-bleu-fonce.webp",
    alt: "Zafu artisanal bleu nuit taille compacte en toile de coton solide",
    usage: "Tous intérieurs, assise d'appoint",
    badge: "Intemporel",
  },
  {
    id: "marron",
    name: "Zafu Marron écorce",
    colorFamily: "Terre & Matière",
    hex: "#4B2E1E",
    desc: "Une teinte minérale et terreuse qui dialogue harmonieusement avec les matières naturelles, les sols en terre cuite et les tons lin.",
    image: "/zafu-plein-marron.webp",
    alt: "Zafu artisanal marron terre taille L pour assise confortable",
    usage: "Séjour, bureau, près de la cheminée",
    badge: "Minéral",
  },
];

const domesticUses = [
  {
    title: "Autour de la table basse",
    subtitle: "Moments partagés",
    desc: "Pour prendre le thé, savourer un apéritif dînatoire, jouer avec les enfants ou discuter sans la rigidité des chaises. La fermeté du kapok naturel soutient le dos sans s'affaisser au fil des heures.",
    icon: "🍵",
  },
  {
    title: "Le coin lecture & repos",
    subtitle: "Détente au sol",
    desc: "Déposé contre une bibliothèque, sous une lampe ou près d'une fenêtre baignée de lumière, le zafu constitue une assise d'appoint accueillante pour feuilleter un livre ou écouter de la musique.",
    icon: "📖",
  },
  {
    title: "Une touche de couleur décorative",
    subtitle: "Présence textile",
    desc: "Posé seul ou empilé en duo sur un tapis, le zafu habille la pièce par ses plis réguliers façonnés à la main et la beauté de sa toile de coton teintée. Un objet chaleureux qu'on ne range pas au placard.",
    icon: "🎨",
  },
  {
    title: "Assise d'appoint mobile",
    subtitle: "Légère & maniable",
    desc: "Grâce à sa poignée de transport intégrée, le coussin se déplace d'une pièce à l'autre en un geste. Une place supplémentaire toujours prête lorsque des amis arrivent à l'improviste.",
    icon: "🛋️",
  },
  {
    title: "Pause respiration & calme",
    subtitle: "Sans formalisme",
    desc: "Pour s'asseoir quelques instants le matin au réveil, relâcher les épaules après une journée d'écran ou faire quelques étirements doux au sol, en toute simplicité chez soi.",
    icon: "🌿",
  },
];
---

<Layout
  fullTitle="Zafus colorés pour la maison & assise au sol | Myokan"
  description="Découvrez les zafus colorés artisanaux Myokan : coussins de sol en coton et kapok pour décorer votre intérieur, s'asseoir autour d'une table basse et se détendre au quotidien."
  image="/zafus-pile.webp"
  imageAlt="Pile de zafus artisanaux colorés confectionnés dans l'atelier Myokan à Montpellier">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="px-4 max-w-5xl mx-auto pt-8 sm:pt-10 pb-20">
    
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accueil</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/zafus/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Zafus</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Zafus colorés</li>
      </ol>
    </nav>

    <!-- En-tête de page (Hero chaleureux) -->
    <header class="mb-12 pb-8 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300">
          Maison & Décoration
        </span>
        <span class="text-xs text-gray-400 dark:text-gray-500 hidden sm:inline">·</span>
        <span class="text-xs text-gray-600 dark:text-gray-400 hidden sm:inline">Confection artisanale unitaire à Montpellier</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-heading text-gray-900 dark:text-white tracking-tight break-words">
        Zafus colorés&nbsp;: des coussins pour la maison et les moments partagés
      </h1>
      <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-4 leading-relaxed max-w-3xl">
        Les zafus colorés Myokan apportent une touche de couleur et de convivialité à la maison. 
        Posés au sol, ils permettent de créer facilement des assises confortables pour lire, se détendre, 
        partager un moment autour d'une table basse ou simplement aménager un espace chaleureux au quotidien.
      </p>

      <!-- Image vedette de la collection -->
      <div class="mt-8 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 shadow-sm">
        <img
          src="/zafus-pile.webp"
          alt="Sélection de zafus artisanaux de différentes couleurs confectionnés à l'atelier Myokan à Montpellier"
          width="1000"
          height="560"
          class="w-full h-64 sm:h-80 md:h-96 object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
        <div class="p-4 sm:p-5 bg-white dark:bg-gray-900/90 border-t border-gray-100 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm">
          <p class="text-gray-600 dark:text-gray-400">
            Toile 100 % coton résistante · Rembourrage en kapok végétal naturel dense · Fabriqué sur commande à Montpellier
          </p>
          <a href="#selection-couleurs" class="font-semibold text-amber-900 dark:text-amber-300 underline hover:no-underline shrink-0">
            Explorer les coloris &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- Section 1 : Deux univers complémentaires -->
    <section class="mb-14 p-6 sm:p-8 rounded-2xl bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200/70 dark:border-amber-900/40">
      <div class="max-w-3xl">
        <span class="text-xs uppercase tracking-widest font-semibold text-amber-900 dark:text-amber-400">
          La nuance Myokan
        </span>
        <h2 class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mt-1 mb-3">
          Le même savoir-faire d’atelier, tourné vers la vie de la maison
        </h2>
        <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          À l'atelier Myokan, nous fabriquons des zafus de pratique traditionnels — sobres, conçus pour le dojo et la posture zazen —, mais aussi des zafus colorés pensés pour habiter votre intérieur. 
          Ils partagent exactement la même exigence de confection&nbsp;: une toile de coton solide, des plis réguliers faits à la main et un garnissage en kapok naturel qui ne s'écrase pas. 
          La différence réside dans leur destination&nbsp;: <strong>la couleur, la liberté de placement et le plaisir d'une assise au sol vivante et décontractée</strong>.
        </p>
      </div>
    </section>

    <!-- Section 2 : Les usages au quotidien (Pour la maison et les moments partagés) -->
    <section class="mb-16">
      <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-400">
          Usages & Confort
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-gray-900 dark:text-white mt-1">
          Pour la maison et les moments partagés
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2 max-w-2xl">
          Contrairement aux poufs mous ou aux coussins plats qui s'affaissent dès qu'on s'y assied, 
          le zafu offre une assise ferme et stable qui redresse le bassin et rend l'assise au sol naturellement agréable.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {domesticUses.map((u) => (
          <div class="p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 shadow-2xs flex flex-col justify-between">
            <div>
              <span class="text-2xl mb-2 block" aria-hidden="true">{u.icon}</span>
              <span class="text-xs font-semibold text-amber-800 dark:text-amber-400 uppercase tracking-wider block">
                {u.subtitle}
              </span>
              <h3 class="text-base font-bold text-gray-900 dark:text-white mt-1">
                {u.title}
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
                {u.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3 : Sélection des zafus colorés -->
    <section id="selection-couleurs" class="mb-16 scroll-mt-20">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-400">
            Palette de l'atelier
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading text-gray-900 dark:text-white mt-1">
            Les coloris réalisés à l’atelier
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">
            Chaque modèle est confectionné sur commande à vos dimensions (S, M, L ou sur mesure).
          </p>
        </div>
        <div class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">
          Tarifs indicatifs : <strong class="text-gray-900 dark:text-white">40 € à 50 €</strong> plein · dès 25 € en housse
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {colorModels.map((m) => (
          <article class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/80 shadow-2xs hover:border-gray-400 dark:hover:border-gray-600 transition overflow-hidden flex flex-col justify-between">
            <div>
              <div class="aspect-[4/3] w-full overflow-hidden bg-gray-50 dark:bg-gray-950 relative">
                <img
                  src={m.image}
                  alt={m.alt}
                  width="400"
                  height="300"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/95 dark:bg-gray-900/95 text-gray-800 dark:text-gray-200 border border-gray-200/80 dark:border-gray-700/80 backdrop-blur-xs">
                  {m.badge}
                </span>
                <span 
                  class="absolute bottom-2.5 right-2.5 w-4 h-4 rounded-full border border-white/80 shadow-xs" 
                  style={`background-color: ${m.hex};`}
                  title={`Teinte ${m.name}`}
                  aria-hidden="true"
                />
              </div>

              <div class="p-4 pb-2">
                <span class="text-[11px] font-medium text-amber-800 dark:text-amber-400 block">
                  {m.colorFamily}
                </span>
                <h3 class="font-bold text-gray-900 dark:text-white text-base mt-0.5 group-hover:text-amber-900 dark:group-hover:text-amber-300 transition">
                  {m.name}
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
                  {m.desc}
                </p>
                <div class="mt-3 pt-2 border-t border-gray-100 dark:border-gray-800/80 text-[11px] text-gray-500 dark:text-gray-400">
                  <span class="font-medium text-gray-700 dark:text-gray-300">Idéal pour :</span> {m.usage}
                </div>
              </div>
            </div>

            <div class="p-4 pt-2">
              <a 
                href={`/commander/?produit=${encodeURIComponent(m.name)}`}
                class="w-full inline-flex items-center justify-center gap-1 px-3 py-2 rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-950 text-xs font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-2xs"
              >
                <span>Commander ce coloris</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Encart coloris sur mesure & tissus d'exception -->
      <div class="mt-8 p-5 sm:p-6 rounded-2xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1 max-w-xl">
          <p class="font-bold text-gray-900 dark:text-white text-base">
            Vous avez un tissu ou une nuance précise en tête&nbsp;?
          </p>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Véronique Myokan Harruis peut confectionner votre zafu sur mesure à partir d'un tissu fourni par vos soins ou rechercher un coloris particulier assorti à vos rideaux, coussins ou tapis.
          </p>
        </div>
        <a 
          href="/contact/" 
          class="shrink-0 px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white hover:border-gray-500 font-semibold text-xs sm:text-sm transition shadow-2xs"
        >
          Proposer un tissu ou une teinte &rarr;
        </a>
      </div>
    </section>

    <!-- Section 4 : Matières et fabrication -->
    <section class="mb-16 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-400">
          Matières & Savoir-faire
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-gray-900 dark:text-white mt-1">
          Une fabrication artisanale conçue pour durer
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2 max-w-2xl">
          Ces coussins colorés ne sont pas des objets purement décoratifs jetables&nbsp;: ils bénéficient 
          des mêmes matières nobles et des mêmes finitions que nos modèles traditionnels.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 text-sm text-gray-700 dark:text-gray-300">
        <div class="p-5 rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200/80 dark:border-gray-800">
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-2">Toile 100 % coton épaisse</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Un tissu robuste et doux au toucher, choisi pour supporter les frottements répétés contre le sol. 
            Les plis d'aisance accordéon sont patiemment formés un à un pour offrir une silhouette nette et régulière.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200/80 dark:border-gray-800">
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-2">Kapok naturel dense (~1 kg)</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Rembourré de kapok végétal pur et soyeux, le coussin offre une fermeté élastique sans égale. 
            Contrairement aux billes synthétiques qui s'écrasent, le kapok reste ferme et imputrescible année après année.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200/80 dark:border-gray-800">
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-2">Détails pratiques & soignés</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Une poignée en tissu assorti ou en lin naturel facilite le déplacement. Sous la poignée, une fente intérieure 
            munie d'un rabat protecteur permet d'ajuster le tassement ou de laver la housse si nécessaire.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 5 : Distinction naturelle avec les zafus de pratique -->
    <section class="mb-14 p-6 sm:p-7 rounded-2xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-1.5 max-w-xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
            Pratique régulière & zazen
          </span>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">
            Vous recherchez un coussin pour une pratique formelle de méditation&nbsp;?
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Pour la pratique du zazen en dojo ou une méditation assise quotidienne axée sur la sobriété visuelle, 
            consultez notre collection traditionnelle en noir classique et teintes neutres de dojo.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-2.5 shrink-0">
          <a 
            href="/zafus/" 
            class="px-4 py-2.5 rounded-xl bg-gray-900 text-white dark:bg-white dark:text-gray-950 font-semibold text-xs sm:text-sm hover:bg-gray-800 dark:hover:bg-gray-100 transition text-center shadow-2xs"
          >
            Zafus de pratique &rarr;
          </a>
          <a 
            href="/choisir-son-zafu/" 
            class="px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white font-semibold text-xs sm:text-sm hover:border-gray-500 transition text-center shadow-2xs"
          >
            Guide des tailles &rarr;
          </a>
        </div>
      </div>
