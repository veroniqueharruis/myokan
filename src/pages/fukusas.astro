---
import Base from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const images = [
  { src: "fukusa-FB_IMG_1756283080119.webp", alt: "Fukusa zen artisanal cousu main — coloris uni, Myokan Montpellier" },
  { src: "fukusa-bleu-jaune.webp", alt: "Fukusa zen bleu et jaune artisanal pour bol oryoki — Myokan Montpellier" },
  { src: "fukusa-FB_IMG_1756283086911.webp", alt: "Fukusa zen artisanal pour oryoki — tissu résistant cousu à la main" },
  { src: "fukusa-FB_IMG_1756283090242.webp", alt: "Fukusa de protection pour bol oryoki, couture artisanale — Myokan" },
  { src: "fukusa-orange-gris.webp", alt: "Fukusa zen orange et gris artisanal cousu à la main — Myokan" },
  { src: "fukusa-FB_IMG_1756283102483.webp", alt: "Fukusa zen fait main, disponible en plusieurs coloris sur commande — Myokan" },
];
---

<Base title="Fukusa zen artisanal pour bol oryoki" description="Fukusas artisanaux cousus main, utilisés par les moines zen pour protéger leur bol oryoki. Réalisés en tissu résistant, disponibles en plusieurs coloris.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Fukusa zen artisanal",
    "description": "Pièce de tissu utilisée par les moines et nonnes zen pour protéger leur bol oryoki. Cousu à la main, disponible en plusieurs coloris.",
    "brand": { "@type": "Brand", "name": "Myokan" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "LocalBusiness", "name": "Myokan" }
    },
    "image": "https://myokan.fr/fukusa-bleu-jaune.webp"
  })} />
  <main class="mt-16 px-4 max-w-6xl mx-auto">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-800">Fukusas artisanaux</h1>
    <PriceTag price="Prix sur demande" />

    <p class="text-lg mt-6 text-gray-600">
      Le fukusa est un carré de tissu replié en deux, utilisé par les moines et nonnes zen pour protéger et
      transporter leur <a href="/oryokis" class="underline hover:text-gray-900">bol oryoki</a>. Il fait partie
      de l'équipement standard lors des sesshins et retraites de méditation, où chaque pratiquant prend soin
      de son matériel avec la même attention qu'il porte à sa pratique.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">Rôle dans la cérémonie zen</h2>
    <p class="text-lg text-gray-600">
      Lors du oryoki — le repas cérémoniel pratiqué en sesshin — le fukusa est déposé sur les genoux du pratiquant
      pour recevoir les bols. Il protège les bols des chocs et de la saleté, tout en délimitant l'espace
      de la cérémonie. Son pliage et son déploiement font partie intégrante du rituel.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Dans la Kosen Sangha, dont relève le <a href="https://zen-montpellier.fr/" class="underline hover:text-gray-900" target="_blank" rel="noopener">dojo zen de Montpellier</a>,
      le fukusa est rectangulaire, de dimension suffisante pour accueillir l'ensemble des bols de l'oryoki.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">Matières et fabrication</h2>
    <p class="text-lg text-gray-600">
      Chaque fukusa est cousu à la main par Véronique Myokan Harruis à Montpellier. Le tissu est choisi pour
      sa solidité et sa tenue dans le temps : coton épais ou mélange coton-lin selon les disponibilités.
      Les bords sont soignés pour éviter l'effilochage au lavage.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Les fukusas sont disponibles en plusieurs coloris — uni ou avec une couture contrastée — selon les
      tissus disponibles au moment de la commande. N'hésitez pas à préciser une préférence de couleur dans
      votre mail.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">À qui s'adresse le fukusa ?</h2>
    <p class="text-lg text-gray-600">
      Le fukusa s'adresse à tout pratiquant zen possédant un <a href="/oryokis" class="underline hover:text-gray-900">oryoki</a>
      et souhaitant disposer d'une pièce solide, faite selon la tradition. Il peut également être offert à
      l'occasion d'une ordination ou d'un anniversaire de pratique.
    </p>

    <OrderCta product="un fukusa" />

    <nav aria-label="Voir aussi" class="mt-8">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/oryokis" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Oryokis</a>
        <a href="/kesas" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Sacs à kesa</a>
        <a href="/contact" class="px-4 py-2 bg-gray-800 text-white rounded-md text-sm hover:bg-gray-700 transition">Passer commande</a>
      </div>
    </nav>

    <!-- Galerie -->
    <div class="mt-12">
      <h3 class="text-2xl font-bold text-gray-800 mb-4">Galerie</h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {images.map((img, index) => (
          <img
            src={img.src}
            alt={img.alt}
            class="rounded-lg shadow-md w-full object-cover cursor-pointer hover:opacity-80 transition"
            data-index={index}
          />
        ))}
      </div>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-80 hidden items-center justify-center z-50">
    <button id="prev" class="absolute left-4 text-white text-3xl top-1/2 -translate-y-1/2">&#10094;</button>
    <img id="lightbox-img" src="" alt="Fukusa agrandi" class="max-h-[90%] max-w-[90%] rounded-lg shadow-xl" />
    <button id="next" class="absolute right-4 text-white text-3xl top-1/2 -translate-y-1/2">&#10095;</button>
  </div>

  <script is:inline client:load>
    const images = document.querySelectorAll("[data-index]");
    const lightbox = document.getElementById("lightbox");
    const img = document.getElementById("lightbox-img");
    const prevBtn = document.getElementById("prev");
    const nextBtn = document.getElementById("next");

    let currentIndex = 0;

    function showLightbox(index) {
      currentIndex = index;
      img.src = images[currentIndex].getAttribute("src");
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
    }

    function hideLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      img.src = images[currentIndex].getAttribute("src");
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      img.src = images[currentIndex].getAttribute("src");
    }

    images.forEach((image, index) => {
      image.addEventListener("click", () => showLightbox(index));
    });

    prevBtn.addEventListener("click", (e) => { e.stopPropagation(); showPrev(); });
    nextBtn.addEventListener("click", (e) => { e.stopPropagation(); showNext(); });
    lightbox.addEventListener("click", hideLightbox);
  </script>
</Base>
