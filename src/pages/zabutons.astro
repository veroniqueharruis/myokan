---
import Base from "../layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";
---

<Base
  fullTitle="Zabuton de méditation artisanal — Myokan, Montpellier"
  description="Zabutons artisanaux à Montpellier : coussin rectangulaire de sol pour la méditation. Protège genoux et chevilles, complément naturel du zafu.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Zabuton artisanal",
    "description": "Grand coussin rectangulaire de sol pour la pratique de la méditation. Protège genoux et chevilles, complément indispensable du zafu.",
    "brand": { "@type": "Brand", "name": "Myokan" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "LocalBusiness", "name": "Myokan" }
    }
  })} />
  <main class="mt-16 px-4 max-w-3xl mx-auto">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-800">Zabuton artisanal</h1>
    <PriceTag price="Prix sur demande" />

    <p class="text-lg mt-6 text-gray-600">
      Le zabuton est le grand coussin plat rectangulaire sur lequel repose le <a href="/zafus" class="underline hover:text-gray-900">zafu</a> pendant
      la pratique de la méditation. Posé directement sur le sol, il protège les genoux, les
      chevilles et le bas des jambes, et assure un ancrage stable pour toute la séance.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-10 mb-4">Pourquoi le zabuton est indispensable</h2>
    <p class="text-lg text-gray-600">
      Assis en lotus ou en demi-lotus sur un zafu, les chevilles et les genoux reposent
      directement sur le tatami ou le parquet. Sans zabuton, la pression exercée sur les
      articulations devient rapidement inconfortable, en particulier lors des longues sessions.
      Le zabuton absorbe cette pression et permet de maintenir une posture juste et détendue
      pendant plusieurs périodes de méditation consécutives.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-10 mb-4">Fabrication</h2>
    <p class="text-lg text-gray-600">
      Chaque zabuton est confectionné en tissu solide et résistant, sélectionné pour sa
      durabilité. Le rembourrage — coton ou kapok selon la préférence — est réparti
      uniformément pour garantir un soutien homogène sur toute la surface. Les dimensions
      sont adaptées à la morphologie et au style de pratique de chaque personne.
    </p>
    <ul class="mt-4 space-y-2 text-gray-600">
      <li class="flex gap-2"><span class="text-gray-400">—</span> Tissu extérieur résistant, disponible en plusieurs coloris</li>
      <li class="flex gap-2"><span class="text-gray-400">—</span> Rembourrage coton ou kapok</li>
      <li class="flex gap-2"><span class="text-gray-400">—</span> Dimensions et coloris personnalisables sur demande</li>
      <li class="flex gap-2"><span class="text-gray-400">—</span> Réalisé à Montpellier selon la tradition transmise par maître Deshimaru</li>
    </ul>

    <h2 class="text-2xl font-bold text-gray-800 mt-10 mb-4">Zabuton et zafu : un ensemble cohérent</h2>
    <p class="text-lg text-gray-600">
      Zabuton et zafu fonctionnent ensemble. Le zafu soulève le bassin et libère les hanches ;
      le zabuton protège les points d'appui au sol. Commander les deux en même temps permet
      d'assortir les coloris et d'obtenir un ensemble harmonieux pour votre espace de pratique.
    </p>

    <OrderCta product="un zabuton" />

    <!-- Galerie — à compléter quand les photos seront disponibles -->

    <nav aria-label="Voir aussi" class="mt-12">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/zafus" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Zafus</a>
        <a href="/sacs-zafus" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Sacs à zafu</a>
        <a href="/fukusas" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Fukusas</a>
      </div>
    </nav>
  </main>
</Base>
