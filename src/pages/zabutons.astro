---
import Base from "../layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";
---

<Base
  title="Zabuton artisanal — coussin de sol pour zazen"
  description="Zabutons faits main à Montpellier : coussin rectangulaire de sol pour la pratique du zazen. Protège genoux et chevilles, complément naturel du zafu.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Zabuton artisanal",
    "description": "Grand coussin rectangulaire de sol pour la pratique du zazen, cousu à la main. Protège genoux et chevilles, complément indispensable du zafu.",
    "brand": { "@type": "Brand", "name": "Myokan" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "LocalBusiness", "name": "Myokan" }
    }
  })} />
  <main class="mt-16 px-4 max-w-6xl mx-auto">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-800">Zabuton artisanal</h1>
    <PriceTag price="Prix sur demande" />
    <p class="text-lg mt-6 text-gray-600">
      Le zabuton est le grand coussin rectangulaire sur lequel repose le zafu pendant la pratique
      du zazen. Il protège les genoux et les chevilles, et assure un ancrage stable sur le sol.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Cousu à la main selon la tradition zen, en tissu solide et résistant, avec un rembourrage
      adapté à une longue session de méditation.
    </p>
    <p class="text-lg mt-4 text-gray-600">Dimensions et coloris disponibles sur demande.</p>

    <OrderCta product="un zabuton" />

    <!-- Galerie — à compléter quand les photos seront disponibles -->

    <nav aria-label="Voir aussi" class="mt-12">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/zafus" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Zafus</a>
        <a href="/sacs-zafus" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Sacs à zafu</a>
      </div>
    </nav>
  </main>
</Base>
