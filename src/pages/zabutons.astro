---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Accessoires",
      "item": "https://myokan.fr/accessoires/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Zabutons",
      "item": "https://myokan.fr/zabutons/"
    }
  ]
};

const images = [
  { src: "/zabutons-empiles.webp", alt: "Zabutons de méditation artisanaux empilés — Atelier Myokan Montpellier" },
  { src: "/zabuton-noir-sol.webp", alt: "Zabuton de méditation artisanal noir posé à plat — Atelier Myokan" },
  { src: "/zabuton-noir-detail.webp", alt: "Détail des finitions et du capitonnage traditionnel d'un zabuton zen" },
  { src: "/zabuton-noir-jardin.webp", alt: "Zabuton de méditation en toile de coton solide dans la nature" },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Zabuton de méditation artisanal",
  "description": "Grand coussin rectangulaire de sol pour la pratique de la méditation assise zazen. Protège genoux et chevilles, complément indispensable du zafu.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "image": "https://myokan.fr/zabutons-empiles.webp",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://myokan.fr/zabutons/",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};
---

<Layout
  fullTitle="Zabuton de méditation artisanal — Myokan, Montpellier"
  description="Zabutons artisanaux à Montpellier : tapis de sol rectangulaire pour la méditation assise. Protège genoux et chevilles, complément naturel du zafu."
  image="/zabutons-empiles.webp"
  imageAlt="Zabutons de méditation artisanaux empilés — Atelier Myokan Montpellier">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="mt-10 px-4 max-w-3xl mx-auto pb-20">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-600 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accueil</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/accessoires/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accessoires</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Zabutons</li>
      </ol>
    </nav>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white break-words">Zabutons de méditation artisanaux</h1>
    <PriceTag price="Sur devis" />

    <p class="text-lg mt-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      Le zabuton est le grand coussin plat rectangulaire sur lequel repose le <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zafu</a> pendant
      la pratique de la méditation. Posé directement sur le sol, il protège les genoux, les
      chevilles et le bas des jambes, et assure un ancrage stable pour toute la séance.
    </p>

    <!-- Bloc éducatif : Utilisé sous le zafu -->
    <div class="my-6 p-4 sm:p-5 rounded-xl bg-amber-50/80 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-900/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-wider text-amber-900 dark:text-amber-300">Utilisé sous le zafu</span>
        <p class="text-sm font-bold text-gray-900 dark:text-white mt-0.5">Le duo d'assise traditionnel du zazen</p>
        <p class="text-xs text-gray-600 dark:text-gray-300 mt-1">Le zafu élève le bassin, le zabuton amortit les points d'appui des jambes au sol.</p>
      </div>
      <a href="/zafus/" class="shrink-0 px-4 py-2 bg-white dark:bg-gray-800 border border-amber-300 dark:border-amber-700 text-gray-900 dark:text-white rounded-lg text-xs font-semibold hover:bg-amber-50 dark:hover:bg-amber-900/40 transition shadow-2xs">
        Découvrir nos zafus artisanaux &rarr;
      </a>
    </div>


    <div class="my-8 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
      <img
        src="/zabutons-empiles.webp"
        alt="Zabutons de méditation artisanaux confectionnés à Montpellier — Atelier Myokan"
        width="800"
        height="500"
        class="w-full h-64 sm:h-80 object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <p class="p-3 text-xs text-center text-gray-500 dark:text-gray-400">
        Zabutons de méditation artisanaux confectionnés selon la méthode traditionnelle dans l'atelier Myokan à Montpellier
      </p>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-10 mb-4">Pourquoi le zabuton est indispensable</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Assis en lotus, en demi-lotus ou en tailleur sur un zafu, les chevilles et les genoux reposent
      directement sur le sol. Sans zabuton, la pression exercée sur les
      articulations devient rapidement inconfortable, en particulier lors des séances prolongées ou des sesshins.
      Le zabuton absorbe cette pression et permet de maintenir une posture juste, détendue et immobile.
      Pour approfondir les principes de l'assise, consultez notre <a href="/pratique-zazen/#posture" class="underline hover:text-gray-950 dark:hover:text-white font-medium">guide de posture zazen</a>.
    </p>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-10 mb-4">Matières et fabrication</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Chaque zabuton est confectionné en tissu solide et résistant, sélectionné pour sa
      durabilité. Le rembourrage — coton épais ou <a href="/pratique-zazen/#choisir-zafu" class="underline hover:text-gray-950 dark:hover:text-white font-medium">kapok végétal</a> selon votre préférence — est réparti
      uniformément pour garantir un soutien homogène sur toute la surface. Les dimensions
      sont adaptées à votre morphologie et à votre style de pratique.
    </p>
    <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> Tissu extérieur en coton résistant, disponible en plusieurs coloris</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> Rembourrage naturel (coton ou kapok) offrant un amorti ferme</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> Dimensions et finitions personnalisables sur demande</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> Confectionné à Montpellier selon la méthode traditionnelle</li>
    </ul>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-10 mb-4">Zabuton et zafu&nbsp;: un ensemble cohérent</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Zabuton et zafu fonctionnent ensemble. Le <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zafu</a> soulève le bassin et libère les hanches&nbsp;;
      le zabuton protège les points d'appui au sol. Commander les deux en même temps permet
      d'assortir les coloris et d'obtenir un ensemble harmonieux pour votre espace de pratique à domicile. Vous pouvez <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">configurer votre zafu sur mesure</a> selon votre morphologie.
    </p>

    <!-- Galerie photos -->
    <section class="mt-14 pt-6 border-t border-gray-200 dark:border-gray-800" aria-labelledby="zabuton-gallery-heading">
      <h2 id="zabuton-gallery-heading" class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        Exemples de réalisations (cliquez pour agrandir)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {images.map((img, index) => (
          <div class="relative group overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800">
            <img
              src={img.src}
              alt={img.alt}
              width="400"
              height="300"
              class="rounded-xl w-full h-44 sm:h-52 object-cover cursor-pointer hover:opacity-90 hover:scale-105 transition duration-300 gallery-item"
              data-index={index}
              data-src={img.src}
              data-alt={img.alt}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </section>

    <OrderCta product="un zabuton" />

    <!-- Liens connexes / Compléments -->
    <nav aria-label="Compléments indispensables" class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-800">
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
        Compléments d'assise & Découverte
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a 
          href="/zafus/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Zafus de méditation</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Coussins traditionnels en kapok (tailles S, M, L)</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir nos zafus artisanaux →</span>
        </a>

        <a 
          href="/sacs-zafus/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Sacs à zafu</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Protection et transport en toile de coton</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir →</span>
        </a>

        <a 
          href="/pratique-zazen/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Guide posture zen</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Conseils d'assise et bascule du bassin</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Consulter →</span>
        </a>

        <a 
          href="/contact/" 
          class="p-3.5 rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-950 hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm">Contacter l'atelier</span>
            <span class="block text-xs opacity-80 mt-1">Dimensions et confection sur mesure</span>
          </div>
          <span class="text-xs font-medium mt-2">Écrire à Véronique →</span>
        </a>
      </div>
    </nav>
  </main>

  <!-- Lightbox accessible -->
  <div 
    id="lightbox" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Agrandissement du zabuton" 
    class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4"
  >
    <div class="relative max-w-3xl max-h-[90vh] flex flex-col items-center">
      <button 
        type="button" 
        id="lightbox-close" 
        aria-label="Fermer la vue agrandie" 
        class="absolute -top-12 right-0 text-white hover:text-gray-300 text-2xl font-bold p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        ✕
      </button>
      <button 
        type="button" 
        id="prev" 
        aria-label="Photo précédente" 
        class="absolute left-2 sm:-left-12 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 text-3xl p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        &#10094;
      </button>
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-lg shadow-2xl object-contain" />
      <p id="lightbox-caption" class="text-white/90 text-sm mt-3 text-center px-4"></p>
      <button 
        type="button" 
        id="next" 
        aria-label="Photo suivante" 
        class="absolute right-2 sm:-right-12 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 text-3xl p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        &#10095;
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      const thumbs = document.querySelectorAll(".gallery-item");
      const lightbox = document.getElementById("lightbox");
      const img = document.getElementById("lightbox-img");
      const caption = document.getElementById("lightbox-caption");
      const prevBtn = document.getElementById("prev");
      const nextBtn = document.getElementById("next");
      const closeBtn = document.getElementById("lightbox-close");

      let currentIndex = 0;

      function showLightbox(index) {
        if (!lightbox || !img) return;
        currentIndex = index;
        const currentThumb = thumbs[currentIndex];
        img.src = currentThumb.getAttribute("data-src") || "";
        img.alt = currentThumb.getAttribute("data-alt") || "Zabuton agrandi";
        if (caption) caption.textContent = img.alt;
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      }

      function hideLightbox() {
        if (!lightbox) return;
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }

      function showPrev() {
        currentIndex = (currentIndex - 1 + thumbs.length) % thumbs.length;
        showLightbox(currentIndex);
      }

      function showNext() {
        currentIndex = (currentIndex + 1) % thumbs.length;
        showLightbox(currentIndex);
      }

      thumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => showLightbox(index));
      });

      prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); showPrev(); });
      nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); showNext(); });
      closeBtn?.addEventListener("click", hideLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) hideLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (!lightbox || lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") hideLightbox();
        if (e.key === "ArrowLeft") showPrev();
        if (e.key === "ArrowRight") showNext();
      });
    })();
  </script>
</Layout>
