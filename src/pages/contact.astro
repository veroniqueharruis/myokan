---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import CommandeForm from "@components/commande-form.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact & Devis",
      "item": "https://myokan.fr/contact/"
    }
  ]
};

const prefilledGeneralSubject = encodeURIComponent("Demande de renseignement / commande — Myokan");
const prefilledGeneralBody = encodeURIComponent(
  "Bonjour Véronique,\n\nJe vous contacte au sujet de :\n[ ] Commande de zafu de méditation\n[ ] Commande de zabuton\n[ ] Commande d'un ensemble oryoki complet\n[ ] Commande d'un fukusa ou sac (zafu, kesa)\n[ ] Conseil sur la posture ou les dimensions\n\nMes préférences (taille, coloris, questions) :\n...\n\nNom & Prénom :\nAdresse de livraison ou point Mondial Relay souhaité :\nTéléphone (facultatif) :\n\nMerci d'avance,\nCordialement"
);
---

<Layout
  fullTitle="Contact & Devis artisan — Atelier Myokan, Montpellier"
  description="Contactez Véronique Myokan Harruis à Montpellier pour toute demande de devis, conseil sur la posture zazen ou commande de zafu et accessoires de méditation.">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <Container>
    <main id="main-content" class="max-w-3xl mx-auto mt-8 mb-20">
      
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accueil</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-gray-800 dark:text-gray-200" aria-current="page">Contact & Devis</li>
        </ol>
      </nav>

      <div class="mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 text-xs font-semibold mb-3">
          <span>Atelier artisanal à Montpellier · Depuis 1982</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
          Contacter l'atelier Myokan
        </h1>
        <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-3 leading-relaxed">
          Toutes les confections sont réalisées à la demande. Véronique Myokan Harruis répond personnellement à chaque message sous quelques jours ouvrés pour vous conseiller et établir votre devis.
        </p>

        <!-- Lien vers la page explicative de commande -->
        <div class="mt-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm">
          <span class="text-gray-700 dark:text-gray-300">
            Vous souhaitez connaître nos tarifs détaillés et les étapes de fabrication ?
          </span>
          <a href="/commander/" class="font-semibold text-gray-900 dark:text-white underline hover:no-underline shrink-0">
            Comment commander un zafu →
          </a>
        </div>
      </div>

      <!-- Formulaire structuré de commande et contact -->
      <div class="mb-12">
        <CommandeForm />
      </div>

      <!-- Bouton mailto direct alternatif -->
      <div class="mb-12">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">
          Ou écrivez-nous directement par e-mail
        </h2>
        <a
          href={`mailto:myokan@hotmail.fr?subject=${prefilledGeneralSubject}&body=${prefilledGeneralBody}`}
          class="flex items-center gap-4 p-5 bg-gray-50 dark:bg-gray-900/70 border border-gray-200 dark:border-gray-800 rounded-2xl hover:border-gray-400 dark:hover:border-gray-600 transition group shadow-xs focus-visible:ring-2"
          aria-label="Envoyer un e-mail à myokan@hotmail.fr avec le modèle pré-rempli"
        >
          <div class="shrink-0 w-11 h-11 bg-gray-900 dark:bg-white text-white dark:text-gray-950 rounded-full flex items-center justify-center text-lg font-bold">
            @
          </div>
          <div class="flex-1">
            <p class="text-[11px] font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-0.5">Adresse e-mail de l'atelier</p>
            <p class="text-lg font-bold text-gray-900 dark:text-white group-hover:underline">myokan@hotmail.fr</p>
          </div>
          <span class="hidden sm:inline text-xs font-semibold text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white">
            Ouvrir ma messagerie →
          </span>
        </a>
      </div>

      <!-- Informations pratiques -->
      <div class="mb-12">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Informations pratiques</h2>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-gray-700 dark:text-gray-300">
          <div class="p-4 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
            <h3 class="font-bold text-gray-900 dark:text-white mb-1">Délai de réponse</h3>
            <p class="text-gray-600 dark:text-gray-400">Quelques jours ouvrés selon la charge d'atelier.</p>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
            <h3 class="font-bold text-gray-900 dark:text-white mb-1">Livraison & Suivi</h3>
            <p class="text-gray-600 dark:text-gray-400">Mondial Relay en point relais ou domicile. Envoi soigné en France et Europe.</p>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
            <h3 class="font-bold text-gray-900 dark:text-white mb-1">Paiement</h3>
            <p class="text-gray-600 dark:text-gray-400">Virement bancaire ou PayPal validé après acceptation du devis.</p>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
            <h3 class="font-bold text-gray-900 dark:text-white mb-1">Retrait local</h3>
            <p class="text-gray-600 dark:text-gray-400">Possibilité de remise en main propre à Montpellier sur rendez-vous.</p>
          </div>
        </div>
      </div>

      <!-- Pratique du zazen au dojo -->
      <div class="p-6 sm:p-7 bg-gray-50 dark:bg-gray-900/60 rounded-2xl border border-gray-200 dark:border-gray-800">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
          Vous souhaitez pratiquer le Zazen à Montpellier&nbsp;?
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
          Pour appréhender la posture assise et les bases de la méditation zen avant votre venue, consultez notre <a href="/pratique-zazen/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">guide de pratique du zazen</a>. Pour assister à une séance d'initiation au dojo, contactez l'équipe du dojo :
        </p>
        <div class="mt-3 p-3.5 bg-white dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 text-xs sm:text-sm space-y-1">
          <p class="font-semibold text-gray-900 dark:text-white">Dojo Zen de Montpellier (Kosen Sangha)</p>
          <p class="text-gray-600 dark:text-gray-400">34, rue Bourrely — 34000 Montpellier</p>
          <p class="text-gray-600 dark:text-gray-400">Téléphone&nbsp;: <a href="tel:+33624531820" class="underline hover:text-gray-900 dark:hover:text-white">06 24 53 18 20</a></p>
          <p class="pt-1">
            Site officiel&nbsp;: <a href="https://zen-montpellier.fr/" target="_blank" rel="noopener" class="underline hover:text-gray-900 dark:hover:text-white font-medium">zen-montpellier.fr ↗</a>
          </p>
        </div>
      </div>

    </main>
  </Container>
</Layout>
