---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Oryokis",
      "item": "https://myokan.fr/oryokis/"
    }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Ensemble oryoki artisanal zen — bol en bois tourné & accessoires",
  "description": "Ensemble complet oryoki pour la cérémonie du repas en sesshin : bol façonné par un artisan tourneur sur bois en Côte-d'Or (érable sycomore, bouleau), tissu de protection fukusa, cuillère en bois dans son étui et serviette confectionnés à Montpellier selon la méthode traditionnelle.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "image": "https://myokan.fr/fukusa-orange-gris.webp",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://myokan.fr/oryokis/",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};
---

<Layout
  fullTitle="Oryoki zen artisanal — bol en bois tourné & accessoires — Myokan, Montpellier"
  description="Ensemble complet oryoki pour le repas zen en sesshin : bol en bois tourné en Côte-d'Or (érable sycomore, bouleau), fukusa, cuillère en bois dans son étui et serviette. Livraison Mondial Relay.">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="mt-10 px-4 max-w-3xl mx-auto pb-20">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-600 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition">Accueil</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition">Créations</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Oryokis</li>
      </ol>
    </nav>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white break-words">Oryokis artisanaux</h1>
    <PriceTag price="Sur devis" />

    <!-- Badges récapitulatifs -->
    <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-gray-700 dark:text-gray-300">
      <span class="px-3 py-1 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60">
        Bol tourné en Côte-d'Or (érable sycomore, bouleau)
      </span>
      <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700">
        Textiles confectionnés selon la méthode traditionnelle
      </span>
      <span class="px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
        Livraison Mondial Relay
      </span>
    </div>

    <p class="text-lg mt-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      L'oryoki — littéralement « juste ce qu'il faut » — désigne le service rituel
      utilisé lors des repas rituels en sesshin et retraites dans les dojos zen. La cérémonie du repas
      est elle-même une méditation en action : chaque geste d'ouverture, chaque bouchée, chaque nettoyage du bol
      est accompli avec la même présence attentive et silencieuse que le zazen.
    </p>

    <div class="my-8 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
      <img
        src="/fukusa-orange-gris.webp"
        alt="Ensemble complet pour bol oryoki artisanal : bol en bois et confections textiles — Atelier Myokan"
        width="800"
        height="500"
        class="w-full h-64 sm:h-80 object-cover"
        loading="lazy"
      />
      <p class="p-3 text-xs text-center text-gray-500 dark:text-gray-400">
        Ensemble complet oryoki : bol façonné par un artisan tourneur sur bois et accessoires textiles confectionnés dans l'atelier Myokan à Montpellier
      </p>
    </div>

    <!-- Composition de l'ensemble oryoki -->
    <section aria-labelledby="composition-heading" class="mt-10">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-gray-600 dark:text-gray-400 mb-1">Détail du set complet</p>
        <h2 id="composition-heading" class="text-2xl font-bold text-gray-900 dark:text-white">Que comporte l'oryoki ?</h2>
      </div>

      <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
        Chaque ensemble oryoki proposé par l'atelier Myokan est complet, harmonieux et immédiatement prêt pour la pratique en sesshin ou en retraite. Il réunit quatre éléments essentiels :
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <!-- 1. Bol en bois tourné -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">1</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Un bol en bois tourné</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Le bol est réalisé par un <strong>artisan tourneur sur bois en Côte-d'Or</strong>. Il est façonné le plus souvent en <strong>érable sycomore</strong> ou en <strong>bouleau</strong>, des essences de bois locales réputées pour leur grain fin, leur douceur au toucher et aux lèvres, et leur grande longévité.
          </p>
        </div>

        <!-- 2. Tissu le protégeant -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">2</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Son tissu de protection (fukusa)</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Confectionné par Véronique à Montpellier selon la méthode traditionnelle, ce tissu enveloppe et protège le bol lors du transport. Déployé sur les genoux pendant la cérémonie, il délimite l'espace du repas et sert de nappe rituelle.
          </p>
        </div>

        <!-- 3. Cuillère en bois dans son étui -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">3</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Une cuillère en bois dans son étui</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Une cuillère en bois douce adaptée à la dégustation de la traditionnelle genmai (soupe de riz du matin) et des repas en sesshin, rangée dans son étui en tissu assorti confectionné à l'atelier pour une hygiène optimale.
          </p>
        </div>

        <!-- 4. Une serviette -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">4</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Une serviette de cérémonie</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Une serviette en tissu naturel, douce et très résistante aux lavages fréquents, indispensable au rituel pour sécher et prendre soin respectueusement des ustensiles en fin de repas.
          </p>
        </div>
      </div>
    </section>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">L'oryoki dans la pratique de la Kosen Sangha</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Véronique confectionne ces ensembles selon la manière dont ils sont utilisés au sein de la
      Kosen Sangha, dans la lignée de maître Stéphane Kosen Thibaut — une forme épurée et robuste, adaptée
      à la pratique contemporaine telle qu'elle se transmet en Europe depuis maître Deshimaru.
    </p>
    <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
      Cette alliance entre le travail d'un artisan tourneur sur bois français et la confection textile selon la méthode traditionnelle garantit un équipement d'oryoki authentique, fonctionnel et solide pour les sesshins organisées dans les dojos occidentaux.
    </p>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-10 mb-4">Fabrication, finitions & livraison</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Chaque pièce textile est coupée et cousue à la machine avec minutie dans le strict respect de la méthode traditionnelle, dans des toiles de coton ou des mélanges naturels choisis pour leur tenue et leur longévité. Les coutures 
      sont réalisées selon le savoir-faire acquis depuis 1982 au contact de la transmission zen.
    </p>
    <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Bol en bois tourné :</strong> réalisé par un artisan en Côte-d'Or (érable sycomore, bouleau)</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Confection textile artisanale :</strong> fukusa, étui et serviette cousus à la machine selon la méthode traditionnelle à Montpellier</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Dimensions rituelles :</strong> adaptées aux usages de la Kosen Sangha</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Livraison Mondial Relay :</strong> expédition soignée en point relais ou à domicile</li>
    </ul>

    <OrderCta product="un ensemble oryoki complet" />

    <nav aria-label="Voir aussi" class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-800">
      <p class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/fukusas/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Fukusas</a>
        <a href="/kesas/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Sacs à kesa</a>
        <a href="/zafus/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Zafus de méditation</a>
        <a href="/pratique-zazen/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Guide pratique zazen</a>
      </div>
    </nav>
  </main>
</Layout>
