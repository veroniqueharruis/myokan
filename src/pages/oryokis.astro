---
import Base from "../layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
---

<Base
  title="Oryoki artisanal — bol zen pour la cérémonie du repas"
  description="Oryokis réalisés selon les usages de la Kosen Sangha : bols zen utilisés lors des repas en sesshin et retraites de méditation. Faits main à Montpellier.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Oryoki artisanal",
    "description": "Accessoire zen pour la cérémonie du repas en sesshin. Réalisé à la main selon les usages de la Kosen Sangha.",
    "brand": { "@type": "Brand", "name": "Myokan" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "LocalBusiness", "name": "Myokan" }
    }
  })} />
  <main class="mt-16 px-4 max-w-6xl mx-auto">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-800">Oryoki artisanal</h1>
    <p class="text-lg mt-4 text-gray-600">
      L'oryoki est le bol utilisé par les pratiquants zen lors des repas en sesshin.
      Véronique réalise ces accessoires selon la manière dont ils sont utilisés au sein
      de la Kosen Sangha — non pas selon la tradition stricte de certains temples, mais
      adaptée à la pratique contemporaine.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Chaque pièce est cousue à la main, avec soin, en tissu de qualité.
    </p>

    <OrderCta product="un oryoki" />

    <!-- Galerie — à compléter quand les photos seront disponibles -->

    <nav aria-label="Voir aussi" class="mt-12">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/fukusas" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Fukusas</a>
        <a href="/kesas" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Sacs à kesa</a>
      </div>
    </nav>
  </main>
</Base>
