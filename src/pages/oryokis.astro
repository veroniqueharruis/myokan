---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Accessoires",
      "item": "https://myokan.fr/accessoires/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Oryokis",
      "item": "https://myokan.fr/oryokis/"
    }
  ]
};

const images = [
  { src: "/oryoki-service-deplie.webp", alt: "Ensemble complet oryoki déplié pour le rituel : bol en bois sur fukusa, étui à cuillère et serviette de cérémonie" },
  { src: "/bols-oryoki-bois.webp", alt: "Empilement de 4 bols d'oryoki façonnés par un artisan tourneur sur bois en érable sycomore et bouleau" },
  { src: "/oryokis-trio.webp", alt: "Trois ensembles d'oryokis enveloppés dans leurs fukusas traditionnels — Atelier Myokan" },
  { src: "/oryokis-etagere.webp", alt: "Étagère de présentation des oryokis et fukusas artisanaux à l'atelier" },
  { src: "/fukusa-motif-floral.webp", alt: "Ensemble oryoki protégé par un fukusa japonais à motifs floraux noir, écru et beige" },
  { src: "/fukusa-motif-indigo.webp", alt: "Bol d'oryoki enveloppé dans un tissu fukusa bleu indigo traditionnel" },
  { src: "/fukusa-motif-marron.webp", alt: "Oryoki avec fukusa artisanal aux motifs géométriques marron et ocre" },
  { src: "/fukusa-orange-gris.webp", alt: "Oryoki protégé par un fukusa bicolore orange et gris artisanal" },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Ensemble oryoki artisanal zen — bol en bois tourné & accessoires",
  "description": "Ensemble complet oryoki pour la cérémonie du repas en sesshin : bol façonné par un artisan tourneur sur bois en Côte-d'Or (érable sycomore, bouleau), tissu de protection fukusa, cuillère en bois dans son étui et serviette confectionnés à Montpellier selon la méthode traditionnelle.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "image": "https://myokan.fr/oryokis-trio.webp",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://myokan.fr/oryokis/",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};
---

<Layout
  fullTitle="Oryoki zen artisanal — bol en bois tourné & accessoires — Myokan, Montpellier"
  description="Ensemble complet oryoki pour le repas zen en sesshin : bol en bois tourné en Côte-d'Or (érable sycomore, bouleau), fukusa, cuillère en bois dans son étui et serviette. Livraison Mondial Relay."
  image="/oryokis-trio.webp"
  imageAlt="Trois ensembles oryoki complets : bols en bois et fukusas traditionnels — Atelier Myokan Montpellier">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="mt-10 px-4 max-w-3xl mx-auto pb-20">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-600 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accueil</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/accessoires/" class="hover:text-gray-950 dark:hover:text-white transition underline hover:no-underline">Accessoires</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Oryokis</li>
      </ol>
    </nav>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white break-words">Oryokis artisanaux</h1>
    <PriceTag price="Sur devis" />

    <!-- Badges récapitulatifs -->
    <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-gray-700 dark:text-gray-300">
      <span class="px-3 py-1 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60">
        Bol tourné en Côte-d'Or (érable sycomore, bouleau)
      </span>
      <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700">
        Textiles confectionnés selon la méthode traditionnelle
      </span>
      <span class="px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
        Livraison Mondial Relay
      </span>
    </div>

    <p class="text-lg mt-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      L'oryoki — littéralement «&nbsp;juste ce qu'il faut&nbsp;» — désigne le service rituel
      utilisé lors des repas rituels en sesshin et retraites dans les dojos zen. La cérémonie du repas
      est elle-même une méditation en action&nbsp;: chaque geste d'ouverture, chaque bouchée, chaque nettoyage du bol
      est accompli avec la même présence attentive et silencieuse que le zazen.
    </p>

    <div class="my-8 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
      <img
        src="/oryokis-trio.webp"
        alt="Trois ensembles oryoki complets : bols en bois et fukusas traditionnels confectionnés par l'Atelier Myokan"
        width="800"
        height="500"
        class="w-full h-64 sm:h-80 object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <p class="p-3 text-xs text-center text-gray-500 dark:text-gray-400">
        Ensembles complets oryoki&nbsp;: bols façonnés par un artisan tourneur sur bois et confections textiles artisanales de l'atelier Myokan à Montpellier
      </p>
    </div>

    <!-- Composition de l'ensemble oryoki -->
    <section aria-labelledby="composition-heading" class="mt-10">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-gray-600 dark:text-gray-400 mb-1">Détail du set complet</p>
        <h2 id="composition-heading" class="text-2xl font-bold text-gray-900 dark:text-white">Que comporte l’oryoki&nbsp;?</h2>
      </div>

      <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
        Chaque ensemble oryoki proposé par l'atelier Myokan est complet, harmonieux et immédiatement prêt pour la pratique en sesshin ou en retraite. Il réunit quatre éléments essentiels&nbsp;:
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <!-- 1. Bol en bois tourné -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">1</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Un bol en bois tourné</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Le bol est réalisé par un <strong>artisan tourneur sur bois en Côte-d'Or</strong>. Il est façonné le plus souvent en <strong>érable sycomore</strong> ou en <strong>bouleau</strong>, des essences de bois locales réputées pour leur grain fin, leur douceur au toucher et aux lèvres, et leur grande longévité.
          </p>
        </div>

        <!-- 2. Tissu le protégeant -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">2</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Son tissu de protection (fukusa)</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Confectionné par <a href="/a-propos/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">Véronique</a> à Montpellier selon la méthode traditionnelle, ce carré d'étoffe enveloppe et protège le bol lors du transport. Déployé sur les genoux pendant la cérémonie, il sert de nappe rituelle. Découvrez également nos <a href="/fukusas/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">fukusas aux motifs japonais</a> vendus séparément.
          </p>
        </div>

        <!-- 3. Cuillère en bois dans son étui -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">3</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Une cuillère en bois dans son étui</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Une cuillère en bois douce adaptée à la dégustation de la traditionnelle genmai (soupe de riz du matin) et des repas en sesshin, rangée dans son étui en tissu assorti confectionné à l'atelier pour une hygiène optimale.
          </p>
        </div>

        <!-- 4. Une serviette -->
        <div class="p-5 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-bold text-xs flex items-center justify-center shrink-0">4</span>
            <h3 class="font-bold text-gray-900 dark:text-white text-base">Une serviette de cérémonie</h3>
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
            Une serviette en tissu naturel, douce et très résistante aux lavages fréquents, indispensable au rituel pour sécher et prendre soin respectueusement des ustensiles en fin de repas.
          </p>
        </div>
      </div>

      <!-- Présentation visuelle : le bol tourné & le service rituel déplié -->
      <div class="grid sm:grid-cols-2 gap-6 mt-8">
        <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 flex flex-col justify-between">
          <div class="aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src="/bols-oryoki-bois.webp"
              alt="Empilement de bols d'oryoki façonnés par un artisan tourneur sur bois en érable sycomore et bouleau"
              width="600"
              height="450"
              class="w-full h-full object-cover object-center hover:scale-105 transition duration-300"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 dark:text-white text-base mb-1">Les bols en bois tourné</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400">
              Façonnés en Côte-d'Or en érable sycomore ou bouleau, sélectionnés pour leur grain fin et leur toucher doux.
            </p>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 flex flex-col justify-between">
          <div class="aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src="/oryoki-service-deplie.webp"
              alt="Ensemble complet oryoki déplié pour le rituel : bol rituel sur nappe fukusa, cuillère en bois dans son étui et serviette"
              width="600"
              height="450"
              class="w-full h-full object-cover object-center hover:scale-105 transition duration-300"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 dark:text-white text-base mb-1">Le service complet déployé</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400">
              Disposition traditionnelle lors du repas en sesshin&nbsp;: bol, tissu protecteur, étui à cuillère et linge de cérémonie.
            </p>
          </div>
        </div>
      </div>
    </section>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">L’oryoki dans la pratique de la Kosen Sangha</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Véronique confectionne ces ensembles selon la manière dont ils sont utilisés au sein de la
      Kosen Sangha, dans la lignée de maître Stéphane Kosen Thibaut — une forme épurée et robuste, adaptée
      à la pratique contemporaine telle qu'elle se transmet en Europe depuis maître Deshimaru.
    </p>
    <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
      Cette alliance entre le travail d'un artisan tourneur sur bois français et la confection textile selon la méthode traditionnelle garantit un équipement d'oryoki authentique, fonctionnel et solide pour les sesshins organisées notamment au <a href="/pratique-zazen/#dojo-montpellier" class="underline hover:text-gray-950 dark:hover:text-white font-medium">Dojo Zen de Montpellier</a>. Pour vos déplacements en retraite, l'atelier confectionne également des <a href="/kesas/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">sacs à kesa et pochettes de ketsumyaku</a>.
    </p>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-10 mb-4">Fabrication, finitions & livraison</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Chaque pièce textile est coupée et cousue à la machine avec minutie dans le strict respect de la méthode traditionnelle, dans des toiles de coton ou des mélanges naturels choisis pour leur tenue et leur longévité. Les coutures 
      sont réalisées selon le savoir-faire acquis depuis 1982 au contact de la transmission zen.
    </p>
    <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Bol en bois tourné&nbsp;:</strong> réalisé par un artisan en Côte-d'Or (érable sycomore, bouleau)</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Confection textile artisanale&nbsp;:</strong> fukusa, étui et serviette cousus à la machine selon la méthode traditionnelle à Montpellier</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Dimensions rituelles&nbsp;:</strong> adaptées aux usages de la Kosen Sangha</li>
      <li class="flex gap-2"><span class="text-gray-400 dark:text-gray-500">—</span> <strong>Livraison Mondial Relay&nbsp;:</strong> expédition soignée en point relais ou à domicile</li>
    </ul>

    <!-- Galerie photos -->
    <section class="mt-14 pt-6 border-t border-gray-200 dark:border-gray-800" aria-labelledby="oryoki-gallery-heading">
      <h2 id="oryoki-gallery-heading" class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        Exemples de réalisations (cliquez pour agrandir)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {images.map((img, index) => (
          <div class="relative group overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800">
            <img
              src={img.src}
              alt={img.alt}
              width="400"
              height="300"
              class="rounded-xl w-full h-44 sm:h-52 object-cover cursor-pointer hover:opacity-90 hover:scale-105 transition duration-300 gallery-item"
              data-index={index}
              data-src={img.src}
              data-alt={img.alt}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </section>

    <OrderCta product="un ensemble oryoki complet" />

    <!-- Liens connexes / Compléments -->
    <nav aria-label="Compléments indispensables" class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-800">
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
        Créations de cérémonie & Assise
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a 
          href="/fukusas/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Fukusas pour oryoki</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Carrés d'étoffe traditionnels aux motifs variés</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir →</span>
        </a>

        <a 
          href="/kesas/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Sacs à kesa</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Housses pour kesa et pochettes ketsumyaku</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir →</span>
        </a>

        <a 
          href="/zafus/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Zafus de méditation</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Coussins traditionnels en coton et kapok</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir nos zafus artisanaux →</span>
        </a>

        <a 
          href="/contact/" 
          class="p-3.5 rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-950 hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm">Contacter l'atelier</span>
            <span class="block text-xs opacity-80 mt-1">Devis pour ensemble complet ou bol tourné</span>
          </div>
          <span class="text-xs font-medium mt-2">Écrire à Véronique →</span>
        </a>
      </div>
    </nav>
  </main>

  <!-- Lightbox accessible -->
  <div 
    id="lightbox" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Agrandissement de l'oryoki" 
    class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4"
  >
    <div class="relative max-w-3xl max-h-[90vh] flex flex-col items-center">
      <button 
        type="button" 
        id="lightbox-close" 
        aria-label="Fermer la vue agrandie" 
        class="absolute -top-12 right-0 text-white hover:text-gray-300 text-2xl font-bold p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        ✕
      </button>
      <button 
        type="button" 
        id="prev" 
        aria-label="Photo précédente" 
        class="absolute left-2 sm:-left-12 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 text-3xl p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        &#10094;
      </button>
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-lg shadow-2xl object-contain" />
      <p id="lightbox-caption" class="text-white/90 text-sm mt-3 text-center px-4"></p>
      <button 
        type="button" 
        id="next" 
        aria-label="Photo suivante" 
        class="absolute right-2 sm:-right-12 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 text-3xl p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        &#10095;
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      const thumbs = document.querySelectorAll(".gallery-item");
      const lightbox = document.getElementById("lightbox");
      const img = document.getElementById("lightbox-img");
      const caption = document.getElementById("lightbox-caption");
      const prevBtn = document.getElementById("prev");
      const nextBtn = document.getElementById("next");
      const closeBtn = document.getElementById("lightbox-close");

      let currentIndex = 0;

      function showLightbox(index) {
        if (!lightbox || !img) return;
        currentIndex = index;
        const currentThumb = thumbs[currentIndex];
        img.src = currentThumb.getAttribute("data-src") || "";
        img.alt = currentThumb.getAttribute("data-alt") || "Oryoki agrandi";
        if (caption) caption.textContent = img.alt;
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      }

      function hideLightbox() {
        if (!lightbox) return;
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }

      function showPrev() {
        currentIndex = (currentIndex - 1 + thumbs.length) % thumbs.length;
        showLightbox(currentIndex);
      }

      function showNext() {
        currentIndex = (currentIndex + 1) % thumbs.length;
        showLightbox(currentIndex);
      }

      thumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => showLightbox(index));
      });

      prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); showPrev(); });
      nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); showNext(); });
      closeBtn?.addEventListener("click", hideLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) hideLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (!lightbox || lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") hideLightbox();
        if (e.key === "ArrowLeft") showPrev();
        if (e.key === "ArrowRight") showNext();
      });
    })();
  </script>
</Layout>
