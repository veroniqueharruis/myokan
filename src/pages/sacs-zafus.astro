---
import Base from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const images = [
  "sac-zafu-rouge.webp",
];
---

<Base fullTitle="Sac à zafu en coton fait main — Myokan, Montpellier" description="Sac de transport pour zafu en coton 100 % naturel, fait main. Protégez et transportez votre coussin de méditation zen facilement.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Sac à zafu en coton artisanal",
    "description": "Sac de transport pour zafu en coton 100 % naturel, cousu à la main. Fermeture cordon, lavable en machine. Disponible en plusieurs coloris.",
    "brand": { "@type": "Brand", "name": "Myokan" },
    "material": "coton",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "LocalBusiness", "name": "Myokan" }
    },
    "image": "https://myokan.fr/sac-zafu-rouge.webp"
  })} />
  <main class="mt-16 px-4 max-w-6xl mx-auto">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-800">Sacs à zafu en coton artisanal</h1>
    <PriceTag price="Prix sur demande" />

    <p class="text-lg mt-6 text-gray-600">
      Le sac à zafu est un accessoire indispensable pour tout pratiquant qui transporte régulièrement
      son <a href="/zafus" class="underline hover:text-gray-900">coussin de zazen</a> — entre son domicile
      et le dojo, lors d'un stage ou d'une sesshin, ou en voyage. Il protège le tissu du zafu des salissures
      et de l'usure tout en facilitant le portage.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">Matière et conception</h2>
    <p class="text-lg text-gray-600">
      Le sac est entièrement cousu en coton 100 % naturel, épais et respirant. Le coton permet au zafu
      de ne pas étouffer entre les utilisations, ce que les matières synthétiques ne permettent pas.
      La fermeture se fait par un cordon coulissant, assez large pour glisser le zafu sans forcer.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Chaque sac est taillé à la main par Véronique Myokan Harruis à Montpellier, avec les mêmes
      exigences de soin que pour les zafus eux-mêmes. Les coutures sont solides, faites pour durer.
      Le sac est lavable en machine à basse température (30 °C).
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">Dimensions et coloris</h2>
    <p class="text-lg text-gray-600">
      Le sac est dimensionné pour accueillir un zafu standard (diamètre 35 cm environ). Si vous avez
      commandé un zafu de taille différente — S (30 cm) ou L (40 cm) — précisez-le dans votre commande
      afin que le sac soit adapté.
    </p>
    <p class="text-lg mt-4 text-gray-600">
      Disponible en plusieurs coloris selon les stocks de tissu disponibles : naturel, noir, bordeaux,
      bleu marine, et d'autres selon les arrivages. Vous pouvez indiquer une préférence dans votre message.
    </p>

    <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-4">Commander ensemble : zafu + sac</h2>
    <p class="text-lg text-gray-600">
      Si vous commandez un <a href="/zafus" class="underline hover:text-gray-900">zafu</a> et un sac en même
      temps, indiquez-le dans votre mail : le sac sera dimensionné exactement à votre zafu et réalisé dans
      un tissu coordonné ou contrasté selon votre souhait.
    </p>

    <OrderCta product="un sac à zafu" />

    <nav aria-label="Voir aussi" class="mt-8">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/zafus" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Zafus</a>
        <a href="/zabutons" class="px-4 py-2 border border-gray-200 rounded-md text-sm text-gray-700 hover:border-gray-400 transition">Zabutons</a>
        <a href="/contact" class="px-4 py-2 bg-gray-800 text-white rounded-md text-sm hover:bg-gray-700 transition">Passer commande</a>
      </div>
    </nav>

    <!-- Galerie -->
    <div class="mt-12">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {images.map((src, index) => (
          <img
            src={src}
            alt="Sac à zafu en coton artisanal fait main — Myokan"
            class="rounded-lg shadow-md w-full object-cover cursor-pointer hover:opacity-80 transition"
            data-index={index}
          />
        ))}
      </div>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-80 hidden items-center justify-center z-50">
    <button id="prev" class="absolute left-4 text-white text-3xl top-1/2 -translate-y-1/2">&#10094;</button>
    <img id="lightbox-img" src="" alt="Sac à zafu agrandi" class="max-h-[90%] max-w-[90%] rounded-lg shadow-xl" />
    <button id="next" class="absolute right-4 text-white text-3xl top-1/2 -translate-y-1/2">&#10095;</button>
  </div>

  <script is:inline client:load>
    const images = document.querySelectorAll("[data-index]");
    const lightbox = document.getElementById("lightbox");
    const img = document.getElementById("lightbox-img");
    const prevBtn = document.getElementById("prev");
    const nextBtn = document.getElementById("next");

    let currentIndex = 0;

    function showLightbox(index) {
      currentIndex = index;
      img.src = images[currentIndex].getAttribute("src");
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
    }

    function hideLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      img.src = images[currentIndex].getAttribute("src");
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      img.src = images[currentIndex].getAttribute("src");
    }

    images.forEach((image, index) => {
      image.addEventListener("click", () => showLightbox(index));
    });

    prevBtn.addEventListener("click", (e) => { e.stopPropagation(); showPrev(); });
    nextBtn.addEventListener("click", (e) => { e.stopPropagation(); showNext(); });
    lightbox.addEventListener("click", hideLightbox);
  </script>
</Base>
