---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";
import PriceTag from "@components/price-tag.astro";

const images = [
  { src: "/sac-zafu-rouge.webp", alt: "Sac à zafu en coton rouge artisanal — Atelier Myokan Montpellier" },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Sacs à zafu",
      "item": "https://myokan.fr/sacs-zafus/"
    }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Sac à zafu en coton artisanal",
  "description": "Sac de transport pour coussin de méditation zen en coton 100 % naturel confectionné à l'atelier. Fermeture avec cordon coulissant, lavable en machine.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "material": "coton 100%",
  "image": "https://myokan.fr/sac-zafu-rouge.webp",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://myokan.fr/sacs-zafus/",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};
---

<Layout 
  fullTitle="Sac à zafu en coton artisanal — Myokan, Montpellier" 
  description="Sac de transport pour zafu en coton 100 % naturel, confectionné à Montpellier. Protégez et transportez votre coussin de méditation zen lors de vos déplacements.">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="mt-10 px-4 max-w-4xl mx-auto pb-20">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-600 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition">Accueil</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition">Créations</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Sacs à zafu</li>
      </ol>
    </nav>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white break-words">Sacs à zafu en coton artisanal</h1>
    <PriceTag price="Sur devis" />

    <p class="text-lg mt-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      Le sac à zafu est l'accessoire indispensable pour tout pratiquant qui transporte régulièrement
      son <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">coussin de zazen</a> — entre son domicile
      et le dojo, lors d'un stage ou d'une sesshin, ou en voyage. Il protège le tissu du zafu des salissures
      et de l'usure tout en facilitant le portage.
    </p>

    <!-- Photo principale -->
    <div class="my-8 max-w-md mx-auto text-center">
      <div class="p-4 bg-gray-50 dark:bg-gray-900/60 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
        <img
          id="sac-main-img"
          src="/sac-zafu-rouge.webp"
          alt="Sac à zafu en coton rouge artisanal confectionné à Montpellier — Myokan"
          width="400"
          height="600"
          class="rounded-xl w-full max-h-96 object-contain mx-auto cursor-pointer hover:opacity-95 transition"
          title="Cliquez pour agrandir"
        />
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">Cliquez sur l'image pour agrandir</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">Matière et conception</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Le sac est entièrement cousu en coton 100 % naturel, épais et respirant. Le coton permet au zafu
      de respirer entre les séances, ce que les housses synthétiques étanches ne permettent pas.
      La fermeture se fait par un cordon coulissant robuste, permettant d'insérer et de retirer le coussin sans forcer.
    </p>
    <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
      Chaque sac est confectionné par Véronique Myokan Harruis dans son atelier à Montpellier, avec les mêmes
      exigences de soin que pour les zafus. Les coutures renforcées sont conçues pour résister aux voyages répétés.
      Le sac est lavable en machine à basse température (30 °C).
    </p>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">Dimensions et coloris</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Le sac standard est dimensionné pour accueillir un zafu de référence (diamètre 30 à 32 cm). 
      Si vous possédez un zafu de taille différente — S (28 cm) ou L (32 cm rehaussé) — précisez-le lors de votre commande
      afin que le sac soit ajusté exactement à vos dimensions.
    </p>
    <p class="text-lg mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
      Disponible en plusieurs coloris selon les arrivages de tissu&nbsp;: naturel écru, noir, bordeaux,
      bleu marine, vert ou coloris assorti à votre zafu. Vous pouvez indiquer vos préférences dans votre message.
    </p>

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-12 mb-4">Commander l'ensemble&nbsp;: zafu + sac</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Si vous commandez un <a href="/zafus/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zafu</a> et un sac en même
      temps, le sac sera taillé sur mesure pour votre coussin et confectionné dans une harmonie de tissu assortie ou contrastée.
    </p>

    <OrderCta product="un sac à zafu" />

    <nav aria-label="Voir aussi" class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-800">
      <p class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Voir aussi</p>
      <div class="flex flex-wrap gap-3">
        <a href="/zafus/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Zafus de méditation</a>
        <a href="/zabutons/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Zabutons</a>
        <a href="/pratique-zazen/" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-800 dark:text-gray-200 hover:border-gray-500 transition">Guide pratique zazen</a>
        <a href="/contact/" class="px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-950 rounded-lg text-sm hover:bg-gray-800 dark:hover:bg-gray-100 transition font-medium">Passer commande</a>
      </div>
    </nav>
  </main>

  <!-- Lightbox accessible -->
  <div 
    id="lightbox" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Agrandissement de la photo" 
    class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4"
  >
    <div class="relative max-w-2xl max-h-[90vh] flex flex-col items-center">
      <button 
        type="button" 
        id="lightbox-close" 
        aria-label="Fermer la vue agrandie" 
        class="absolute -top-12 right-0 text-white hover:text-gray-300 text-2xl font-bold p-2 focus-visible:ring-2 focus-visible:ring-white rounded-lg transition"
      >
        ✕
      </button>
      <img id="lightbox-img" src="" alt="Sac à zafu agrandi" class="max-h-[80vh] max-w-full rounded-lg shadow-2xl object-contain" />
    </div>
  </div>

  <script is:inline>
    (function () {
      const imgTrigger = document.getElementById("sac-main-img");
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxClose = document.getElementById("lightbox-close");

      function openLightbox() {
        if (!lightbox || !lightboxImg || !imgTrigger) return;
        lightboxImg.src = imgTrigger.getAttribute("src");
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        lightboxClose?.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }

      imgTrigger?.addEventListener("click", openLightbox);
      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    })();
  </script>
</Layout>
