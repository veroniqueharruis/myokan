---
import Container from "@components/container.astro";
import Hero from "@components/hero.astro";
import AtelierBio from "@components/atelier-bio.astro";
import PourquoiArtisanal from "@components/pourquoi-artisanal.astro";
import ZafusSection from "@components/zafus-section.astro";
import AccessoiresSection from "@components/accessoires-section.astro";
import Cta from "@components/cta.astro";
import Layout from "@layouts/Layout.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://myokan.fr/#website",
      "url": "https://myokan.fr/",
      "name": "Myokan",
      "description": "Zafus traditionnels conçus pour soutenir la pratique assise, le zazen et la méditation, confectionnés à Montpellier selon la méthode transmise en 1982.",
      "inLanguage": "fr-FR"
    },
    {
      "@type": "Product",
      "@id": "https://myokan.fr/#zafu",
      "name": "Zafu artisanal pour la méditation et l’assise au sol",
      "description": "Zafu traditionnel conçu pour le zazen et la méditation assise. Confectionné sur commande à Montpellier en toile de coton et kapok végétal naturel dense.",
      "brand": {
        "@type": "Brand",
        "name": "Myokan"
      },
      "image": "https://myokan.fr/zafu-bleu-marine-motif.webp",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "EUR",
        "lowPrice": 25,
        "highPrice": 50,
        "offerCount": 8,
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "LocalBusiness",
          "name": "Myokan",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Montpellier",
            "addressCountry": "FR"
          }
        }
      }
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://myokan.fr/#business",
      "name": "Myokan",
      "description": "Atelier artisanal de confection de zafus et accessoires de méditation zen à Montpellier.",
      "url": "https://myokan.fr/",
      "email": "myokan@hotmail.fr",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressRegion": "Occitanie",
        "addressCountry": "FR"
      },
      "priceRange": "€–€€",
      "image": "https://myokan.fr/opengraph.jpg"
    },
    {
      "@type": "Person",
      "@id": "https://myokan.fr/#veronique",
      "name": "Véronique Myokan Harruis",
      "jobTitle": "Nonne zen et couturière artisanale",
      "worksFor": { "@id": "https://myokan.fr/#business" },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      },
      "image": "https://myokan.fr/veronique.webp"
    }
  ]
};
---

<Layout
  fullTitle="Zafu traditionnel japonais fait main | Myokan, Montpellier"
  description="Zafus traditionnels faits main par une nonne zen à Montpellier, selon la méthode transmise en 1982. Toile de coton et kapok végétal naturel dense."
  image="/veronique-atelier.webp"
  imageAlt="Véronique Myokan Harruis, nonne zen, façonnant un zafu dans son atelier à Montpellier">
  <link rel="preload" as="image" href="/zafu-bleu-marine-motif.webp" type="image/webp" fetchpriority="high" slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Container>
    <main id="main-content">
      <Hero />
      <AtelierBio />
      <PourquoiArtisanal />
      <ZafusSection />
      <AccessoiresSection />
      <Cta />
    </main>
  </Container>
</Layout>
