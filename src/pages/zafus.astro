        <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm sm:text-base mb-6">
          La hauteur d'assise détermine la facilité avec laquelle vos genoux touchent le sol tout en gardant 
          le bas du dos naturellement cambré sans effort musculaire.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5">
        {sizes.filter(s => s.name !== "Sur mesure").map((s) => (
          <div class={`p-5 rounded-xl border transition flex flex-col justify-between ${
            s.isStandard 
              ? "bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 shadow-sm relative" 
              : "bg-gray-50 dark:bg-gray-900/60 border-gray-200 dark:border-gray-800"
          }`}>
            <div>
              {s.isStandard && (
                <span class="absolute -top-2.5 right-4 bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded">
                  Standard · Recommandé
                </span>
              )}
              <h3 class="font-bold text-gray-900 dark:text-white text-lg">
                Taille {s.name} ({s.detail})
