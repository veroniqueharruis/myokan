---
import Layout from "@layouts/Layout.astro";
import OrderCta from "@components/order-cta.astro";

// Source unique de vérité pour les tarifs
const pricing = {
  "S": { vide: 25, plein: 40 },
  "M": { vide: 27, plein: 45 },
  "L": { vide: 30, plein: 50 },
  "Sur mesure": { vide: null, plein: null },
};

const sizes = [
  { 
    name: "S", 
    width: 28, 
    height: 13, 
    desc: "Souplesse ou voyage", 
    detail: "28 × 13 cm",
    guideDesc: "Recommandée pour les personnes souples, assises en plein lotus, ou pour emporter en voyage et sesshin grâce à son encombrement réduit.",
    isStandard: false,
  },
  { 
    name: "M", 
    width: 30, 
    height: 15, 
    desc: "Standard recommandé", 
    detail: "30 × 15 cm",
    guideDesc: "La taille de référence transmise par maître Deshimaru. Convient à la grande majorité des gabarits adultes pour une assise quotidienne stable.",
    isStandard: true,
  },
  { 
    name: "L", 
    width: 32, 
    height: 17, 
    desc: "Assise haute / grand gabarit", 
    detail: "32 × 17 cm",
    guideDesc: "Recommandée pour les personnes de grande taille (> 1m80) ou ressentant une raideur dans les hanches nécessitant une surélévation.",
    isStandard: false,
  },
  { 
    name: "Sur mesure", 
    width: null, 
    height: null, 
    desc: "Dimensions au choix", 
    detail: "Sur mesure",
    guideDesc: "Confection personnalisée selon vos indications morphologiques ou votre pratique. Précisez vos souhaits lors de votre message.",
    isStandard: false,
  },
];

const types = [
  { 
    label: "Plein (avec kapok)", 
    val: "Plein", 
    sublabel: "Prêt à l'assise",
    note: "Rembourrage végétal naturel en kapok, dense et traditionnel." 
  },
  { 
    label: "Vide (à remplir)", 
    val: "Vide", 
    sublabel: "Housse seule",
    note: "Housse en pur coton avec fente intérieure si vous possédez du kapok." 
  },
];

const baseColors = [
  { name: "Noir", hex: "#000000", img: "/zafu-plein-noir.webp", checkColor: "#FFFFFF" },
  { name: "Rouge", hex: "#B91C1C", img: "/zafu-plein-rouge.webp", checkColor: "#FFFFFF" },
  { name: "Vert", hex: "#15803D", img: "/zafu-plein-vert.webp", checkColor: "#FFFFFF" },
  { name: "Bleu", hex: "#1D4ED8", img: "/zafu-plein-bleu.webp", checkColor: "#FFFFFF" },
  { name: "Marron", hex: "#4B2E1E", img: "/zafu-plein-marron.webp", checkColor: "#FFFFFF" },
];

const galleryImages = [
  { 
    src: "/zafus-pile.webp", 
    alt: "Pile de zafus artisanaux multicolores — Atelier Myokan Montpellier",
    title: "Pile de zafus artisanaux",
    caption: "Confections multicolores empilées à l'atelier" 
  },
  { 
    src: "/zafu-noir-lin.webp", 
    alt: "Zafu de méditation zen noir avec poignée en lin naturel — Atelier Myokan Montpellier",
    title: "Zafu noir & lin naturel",
    caption: "Confection traditionnelle en coton noir avec poignée en pur lin" 
  },
  { 
    src: "/zafus-vides-gris.webp", 
    alt: "Zafus de méditation zen gris prêts à être remplis de kapok",
    title: "Housses grises traditionnelles",
    caption: "Prêtes à recevoir le kapok naturel" 
  },
  { 
    src: "/zafu-bleu-fonce.webp", 
    alt: "Zafu de méditation bleu foncé artisanal confectionné à Montpellier",
    title: "Zafu bleu foncé classique",
    caption: "Tissu 100 % coton épais et coutures renforcées" 
  },
  { 
    src: "/zafu-plein-orange.webp", 
    alt: "Zafu artisanal orange en tissu 100% coton",
    title: "Zafu orange plein",
    caption: "Plis réguliers et maintien ferme de l'assise" 
  },
  { 
    src: "/zafu-vide-framboise.webp", 
    alt: "Housse de zafu vide coloris framboise — Myokan",
    title: "Housse framboise à plat",
    caption: "Plis minutieusement formés selon la tradition" 
  },
  { 
    src: "/zafu-plein-violet-pois.webp", 
    alt: "Zafu de méditation violet à pois de confection artisanale",
    title: "Zafu violet à pois",
    caption: "Création originale sur mesure pour une pratiquante" 
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://myokan.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Zafus de méditation",
      "item": "https://myokan.fr/zafus/"
    }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Zafu de méditation zen artisanal",
  "description": "Coussin de zazen traditionnel confectionné selon la méthode traditionnelle en coton et kapok naturel à Montpellier. Disponible en tailles S, M, L ou sur mesure, vide ou plein.",
  "brand": { "@type": "Brand", "name": "Myokan" },
  "image": "https://myokan.fr/zafu-plein-noir.webp",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "lowPrice": 25,
    "highPrice": 50,
    "offerCount": 8,
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "seller": { 
      "@type": "LocalBusiness", 
      "name": "Myokan",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montpellier",
        "addressCountry": "FR"
      }
    }
  }
};
---

<Layout 
  fullTitle="Zafus de méditation zen artisanaux — Myokan, Montpellier" 
  description="Commandez votre zafu de méditation zen traditionnel sur mesure : taille S, M, L ou sur devis, rembourrage kapok naturel, confectionné selon la méthode traditionnelle à Montpellier.">
  
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <main id="main-content" class="max-w-4xl mx-auto px-4 pt-6 sm:pt-8 pb-24 sm:pb-16">
    
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li>
          <a href="/" class="hover:text-gray-950 dark:hover:text-white transition">Accueil</a>
        </li>
        <li aria-hidden="true" class="text-gray-400 dark:text-gray-600">/</li>
        <li class="font-medium text-gray-900 dark:text-white" aria-current="page">Zafus de méditation</li>
      </ol>
    </nav>

    <!-- En-tête de la page -->
    <header class="mb-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400 mb-1.5">
        Confection artisanale · Depuis 1982
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-heading text-gray-900 dark:text-white tracking-tight break-words">
        Zafus de méditation zen artisanaux
      </h1>
      <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-3 leading-relaxed max-w-2xl">
        Le zafu est le coussin d'assise traditionnel du zazen. Cousu à la machine dans le strict respect 
        de la méthode traditionnelle, en tissu 100 % coton et rembourré de kapok végétal, il assure 
        la bascule naturelle du bassin et l'alignement stable de la colonne vertébrale. Posé sur un <a href="/zabutons/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">zabuton</a>, il protège les genoux et les chevilles lors de l'assise (consultez notre <a href="/pratique-zazen/#posture" class="underline hover:text-gray-950 dark:hover:text-white font-medium">guide de posture zazen</a>).
      </p>
    </header>

    <!-- Configurateur interactif -->
    <section class="p-5 sm:p-7 bg-gray-50 dark:bg-gray-900/60 rounded-2xl border border-gray-200 dark:border-gray-800" aria-labelledby="configurator-heading">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-4 mb-6 border-b border-gray-200 dark:border-gray-800">
        <div>
          <h2 id="configurator-heading" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">
            Personnalisez votre zafu
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
            Suivez les 3 étapes de confection pour obtenir votre tarif indicatif et préparer votre commande.
          </p>
        </div>
        <span class="text-xs text-gray-500 dark:text-gray-400 shrink-0 font-medium">
          Atelier artisanal à Montpellier
        </span>
      </div>

      <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-start">
        
        <!-- Colonne Gauche : Aperçu visuel sticky & zoom -->
        <div class="lg:col-span-5 lg:sticky lg:top-6 mb-6 lg:mb-0">
          <div class="bg-white dark:bg-gray-800 p-4 rounded-xl border border-gray-200 dark:border-gray-700/80 shadow-sm text-center">
            <div class="relative overflow-hidden rounded-lg bg-gray-50 dark:bg-gray-900/50 flex items-center justify-center p-3 min-h-[220px] sm:min-h-[260px]">
              <img 
                id="main-zafu-image" 
                src="/zafu-plein-noir.webp" 
                alt="Aperçu du zafu de méditation zen artisanal"
                width="320"
                height="240"
                class="mx-auto w-56 sm:w-64 h-auto rounded-lg transition-all duration-300 cursor-zoom-in relative z-10"
                title="Cliquer pour agrandir la photo"
              />
              <div 
                id="color-overlay"
                class="absolute inset-2 rounded-lg mix-blend-multiply opacity-60 pointer-events-none hidden z-20 transition-colors"
              ></div>
            </div>

            <button
              type="button"
              id="open-lightbox-btn"
              class="mt-2.5 inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition focus-visible:ring-2 rounded px-2 py-1"
              aria-label="Agrandir la photo du zafu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
              <span>Cliquez sur l'image pour l'agrandir</span>
            </button>
            
            <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700/60 flex items-center justify-around text-[11px] text-gray-500 dark:text-gray-400">
              <span>Tissu 100 % coton</span>
              <span>·</span>
              <span>Kapok végétal</span>
              <span>·</span>
              <span>Plis artisanaux</span>
            </div>
          </div>
        </div>

        <!-- Colonne Droite : Les 3 décisions séquentielles + Résumé -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Étape 01 : Taille -->
          <fieldset>
            <legend class="flex items-center justify-between w-full mb-2.5">
              <span class="text-sm font-bold uppercase tracking-wider text-gray-900 dark:text-white flex items-center gap-1.5">
                <span class="w-5 h-5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-[11px] font-mono flex items-center justify-center font-bold">1</span>
                <span>Choisir la taille</span>
              </span>
              <a href="#sizes-guide-heading" class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white underline">
                Guide des tailles ↓
              </a>
            </legend>

            <div class="grid grid-cols-2 gap-2.5" role="radiogroup" aria-label="Choix de la taille du zafu">
              {sizes.map((s) => (
                <div>
                  <input
                    type="radio"
                    name="size"
                    value={s.name}
                    id={`size-${s.name}`}
                    class="size-radio sr-only peer"
                  />
                  <label
                    for={`size-${s.name}`}
                    class="relative block p-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 cursor-pointer hover:border-gray-400 dark:hover:border-gray-500 transition peer-checked:border-gray-950 dark:peer-checked:border-white peer-checked:ring-2 peer-checked:ring-gray-950 dark:peer-checked:ring-white peer-checked:bg-gray-50/50 dark:peer-checked:bg-gray-800 peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2 h-full flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1">
                        <span class="font-bold text-sm text-gray-900 dark:text-white">
                          {s.name === "Sur mesure" ? "Sur mesure" : `Taille ${s.name}`}
                        </span>
                        {s.isStandard && (
                          <span class="bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded">
                            Standard
                          </span>
                        )}
                      </div>
                      <span class="block text-xs font-semibold text-gray-600 dark:text-gray-300 mt-0.5">
                        {s.detail}
                      </span>
                      <span class="block text-[11px] text-gray-500 dark:text-gray-400 mt-1 leading-tight">
                        {s.desc}
                      </span>
                    </div>

                    <div class="mt-2 pt-1.5 border-t border-gray-100 dark:border-gray-700/60 flex items-center justify-between text-[11px]">
                      <span class="text-gray-500 dark:text-gray-400">
                        {s.name === "Sur mesure" ? "Devis personnalisé" : `${pricing[s.name].vide} € vide / ${pricing[s.name].plein} € plein`}
                      </span>
                      <svg class="check-icon w-4 h-4 text-gray-950 dark:text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </div>
                  </label>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
              Taille standard recommandée pour la majorité&nbsp;: <strong>Taille M (30 × 15 cm)</strong>.
            </p>
          </fieldset>

          <!-- Étape 02 : Remplissage -->
          <fieldset>
            <legend class="block text-sm font-bold uppercase tracking-wider text-gray-900 dark:text-white mb-2.5 flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-[11px] font-mono flex items-center justify-center font-bold">2</span>
              <span>Choisir le remplissage</span>
            </legend>

            <div class="grid sm:grid-cols-2 gap-2.5" role="radiogroup" aria-label="Choix du remplissage">
              {types.map((t) => (
                <div>
                  <input
                    type="radio"
                    name="type"
                    value={t.val}
                    id={`type-${t.val}`}
                    class="type-radio sr-only peer"
                  />
                  <label
                    for={`type-${t.val}`}
                    class="relative block p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 cursor-pointer hover:border-gray-400 dark:hover:border-gray-500 transition peer-checked:border-gray-950 dark:peer-checked:border-white peer-checked:ring-2 peer-checked:ring-gray-950 dark:peer-checked:ring-white peer-checked:bg-gray-50/50 dark:peer-checked:bg-gray-800 peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2 h-full flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-start justify-between gap-1">
                        <span class="block font-bold text-sm text-gray-900 dark:text-white">
                          {t.label}
                        </span>
                        <svg class="check-icon w-4 h-4 text-gray-950 dark:text-white hidden shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                      </div>
                      <span class="block text-xs font-semibold text-gray-600 dark:text-gray-300 mt-0.5">
                        {t.sublabel}
                      </span>
                      <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1 leading-normal">
                        {t.note}
                      </p>
                    </div>
                  </label>
                </div>
              ))}
            </div>
          </fieldset>

          <!-- Étape 03 : Couleur -->
          <fieldset>
            <legend class="flex items-baseline justify-between w-full mb-2.5">
              <span class="text-sm font-bold uppercase tracking-wider text-gray-900 dark:text-white flex items-center gap-1.5">
                <span class="w-5 h-5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-[11px] font-mono flex items-center justify-center font-bold">3</span>
                <span>Choisir la couleur</span>
              </span>
              <span class="text-xs text-gray-600 dark:text-gray-400">
                Couleur&nbsp;: <strong id="current-color-name" class="text-gray-900 dark:text-white font-semibold">Noir</strong>
              </span>
            </legend>

            <!-- Coloris de base -->
            <div class="flex flex-wrap items-center gap-3" role="radiogroup" aria-label="Palette des coloris de base">
              {baseColors.map((c, index) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={index === 0 ? "true" : "false"}
                  class={`color-swatch relative w-11 h-11 rounded-full border-2 transition hover:scale-105 focus-visible:ring-2 focus-visible:ring-offset-2 flex items-center justify-center shadow-sm ${
                    index === 0 
                      ? "border-gray-950 dark:border-white ring-2 ring-offset-2 ring-gray-950 dark:ring-white scale-105" 
                      : "border-gray-300 dark:border-gray-600"
                  }`}
                  style={`background-color: ${c.hex};`}
                  data-name={c.name}
                  data-hex={c.hex}
                  data-img={c.img}
                  title={`Zafu coloris ${c.name}`}
                  aria-label={`Coloris ${c.name}`}
                >
                  <svg 
                    class={`check-icon w-5 h-5 pointer-events-none drop-shadow ${index === 0 ? "" : "hidden"}`} 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke={c.checkColor} 
                    stroke-width="3"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </button>
              ))}
            </div>

            <!-- Couleur sur mesure -->
            <div class="mt-3.5 p-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white/70 dark:bg-gray-800/70 flex items-center gap-3">
              <label for="color-picker" class="flex items-center gap-3 cursor-pointer text-xs font-medium text-gray-700 dark:text-gray-300 flex-1">
                <input
                  type="color"
                  id="color-picker"
                  value="#8b5cf6"
                  class="w-8 h-8 p-0 border border-gray-300 dark:border-gray-700 rounded-lg cursor-pointer bg-transparent shrink-0"
                  aria-label="Sélecteur de teinte personnalisée"
                />
                <div class="flex-1">
                  <span class="block font-semibold text-gray-900 dark:text-white">Autre teinte sur mesure</span>
                  <span id="custom-color-indicator" class="block text-[11px] text-gray-500 dark:text-gray-400">
                    Sélectionnez une nuance personnalisée ou proposez votre tissu
                  </span>
                </div>
              </label>
            </div>
          </fieldset>

          <!-- Récapitulatif dynamique & Commande directe -->
          <div 
            id="config-summary-card" 
            class="mt-6 p-5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/80 shadow-sm transition"
            aria-live="polite"
          >
            <div class="flex items-center justify-between pb-3 border-b border-gray-100 dark:border-gray-700/60">
              <h3 class="text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-400">
                Votre configuration
              </h3>
              <span id="config-step-indicator" class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                1 / 3 complété
              </span>
            </div>

            <dl class="py-3 space-y-2 text-sm divide-y divide-gray-100 dark:divide-gray-800">
              <div class="flex justify-between items-baseline pt-1">
                <dt class="text-gray-500 dark:text-gray-400 text-xs">Taille</dt>
                <dd id="summary-size" class="font-normal text-gray-400 dark:text-gray-500 text-right">À choisir</dd>
              </div>
              <div class="flex justify-between items-baseline pt-2">
                <dt class="text-gray-500 dark:text-gray-400 text-xs">Remplissage</dt>
                <dd id="summary-type" class="font-normal text-gray-400 dark:text-gray-500 text-right">À choisir</dd>
              </div>
              <div class="flex justify-between items-baseline pt-2">
                <dt class="text-gray-500 dark:text-gray-400 text-xs">Couleur</dt>
                <dd id="summary-color" class="font-semibold text-gray-900 dark:text-white text-right">Noir</dd>
              </div>
            </dl>

            <div class="pt-3 border-t border-gray-100 dark:border-gray-700/60 flex items-baseline justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400 block">Prix indicatif</span>
                <span class="text-[11px] text-gray-400 dark:text-gray-500">Hors frais de port</span>
              </div>
              <div class="text-right">
                <span id="summary-price" class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight">
                  -- €
                </span>
              </div>
            </div>

            <!-- Invite contextuelle de guidage -->
            <div id="summary-prompt" class="mt-4 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200/60 dark:border-amber-900/60 text-xs text-amber-800 dark:text-amber-200 flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span id="summary-prompt-text">Sélectionnez la taille et le remplissage pour calculer votre tarif.</span>
            </div>

            <!-- Actions de commande contextuelle (s'affichent quand complet) -->
            <div id="summary-actions" class="mt-4 space-y-3 hidden">
              <a 
                id="summary-order-btn" 
                href="#"
                class="w-full py-3.5 px-6 bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-semibold text-sm rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-sm flex items-center justify-center gap-2"
              >
                <span>Passer commande</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              
              <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 px-1">
                <span>Code&nbsp;: <code id="summary-code" class="font-mono font-bold text-gray-800 dark:text-gray-200">...</code></span>
                <a id="summary-email-link" href="mailto:myokan@hotmail.fr" class="underline hover:text-gray-900 dark:hover:text-white">Écrire un e-mail</a>
              </div>

              <p class="text-[11px] text-gray-500 dark:text-gray-400 text-center leading-relaxed">
                Le clic prépare votre e-mail prêt à envoyer avec tous les détails. Paiement par virement bancaire ou PayPal après confirmation de faisabilité.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Guide des tailles (Aide au choix & réassurance) -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800" aria-labelledby="sizes-guide-heading">
      <div class="max-w-2xl">
        <h2 id="sizes-guide-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
