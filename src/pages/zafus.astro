        ))}
      </div>

      <!-- Option Sur mesure -->
      <div class="mt-5 p-4 bg-gray-50 dark:bg-gray-900/60 rounded-xl border border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
        <div>
          <h3 class="font-bold text-gray-900 dark:text-white">Confection sur mesure disponible</h3>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">
            Dimensions adaptées à votre morphologie (moins d'1m50, plus d'1m90) ou assise spéciale.
          </p>
        </div>
        <button
          type="button"
          data-select-size="Sur mesure"
          class="shrink-0 px-3.5 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-xs font-semibold text-gray-800 dark:text-gray-200 hover:border-gray-500 transition text-center"
        >
          Configurer sur mesure ↑
        </button>
      </div>

      <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">
        <p>
          Pour en savoir plus sur l'alignement corporel, consultez notre 
          <a href="/pratique-zazen/#choisir-zafu" class="underline hover:text-gray-900 dark:hover:text-white font-medium">guide complet de posture et d'assise zazen</a>.
        </p>
      </div>
    </section>

    <!-- Galerie de confections de l'atelier -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800" aria-labelledby="gallery-heading">
      <div class="max-w-2xl mb-6">
        <h2 id="gallery-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
          Galerie de confections de l'atelier
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mt-1">
          Aperçu de zafus artisanaux réalisés à Montpellier&nbsp;: plis traditionnels, tissu 100 % coton et finitions soignées.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {galleryImages.map((img) => (
          <figure class="group overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/80 shadow-sm transition flex flex-col justify-between">
            <div class="aspect-[4/3] w-full overflow-hidden bg-gray-50 dark:bg-gray-900/40 relative">
              <img
                src={img.src}
                alt={img.alt}
                width="400"
                height="300"
                class="w-full h-full object-cover object-center cursor-zoom-in group-hover:scale-105 transition-transform duration-300 gallery-thumb"
                data-full={img.src}
                data-alt={img.alt}
                loading="lazy"
              />
              <span class="absolute bottom-2 right-2 bg-black/60 text-white p-1 rounded backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </span>
            </div>
            <figcaption class="p-2.5 sm:p-3 text-xs border-t border-gray-100 dark:border-gray-700/60 leading-tight">
              <strong class="block text-gray-900 dark:text-white font-semibold text-xs mb-0.5 truncate">
                {img.title}
              </strong>
              <span class="text-[11px] text-gray-500 dark:text-gray-400 block line-clamp-1">
                {img.caption}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Encart de commande / Réassurance finale -->
    <OrderCta product="un zafu de méditation" />

    <!-- Liens connexes / Compléments -->
    <nav aria-label="Compléments indispensables" class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-800">
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
        Compléments indispensables
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a 
          href="/zabutons/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Zabutons</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Tapis d'assise traditionnel (70 × 80 cm)</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir →</span>
        </a>

        <a 
          href="/sacs-zafus/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Sacs à zafu</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Transport et protection en toile de coton</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Découvrir →</span>
        </a>

        <a 
          href="/pratique-zazen/" 
          class="p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm text-gray-900 dark:text-white group-hover:underline">Guide posture zen</span>
            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">Conseils d'assise et bascule du bassin</span>
          </div>
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 mt-2">Consulter →</span>
        </a>

        <a 
          href="/contact/" 
          class="p-3.5 rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-950 hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-sm group flex flex-col justify-between"
        >
          <div>
            <span class="block font-bold text-sm">Contacter l'atelier</span>
            <span class="block text-xs opacity-80 mt-1">Questions sur mesure et conseils</span>
          </div>
          <span class="text-xs font-medium mt-2">Écrire à Véronique →</span>
        </a>
      </div>
    </nav>
  </main>

  <!-- CTA Mobile Sticky (affiché quand la configuration est complète) -->
  <div 
    id="mobile-sticky-cta" 
    class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md border-t border-gray-200 dark:border-gray-800 p-3 shadow-lg flex items-center justify-between gap-3 transform translate-y-full transition-transform duration-300"
    aria-label="Action rapide de commande"
  >
    <div class="truncate">
      <span id="mobile-sticky-price" class="text-lg font-bold text-gray-900 dark:text-white block leading-tight">-- €</span>
      <span id="mobile-sticky-desc" class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Configuration en cours</span>
    </div>
    <a 
      id="mobile-sticky-btn" 
      href="#"
      class="px-4 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-semibold text-xs rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-sm flex items-center gap-1.5 shrink-0"
    >
      <span>Passer commande</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <!-- Lightbox accessible -->
  <div 
    id="lightbox" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Agrandissement de la photo" 
    class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4"
  >
    <div class="relative max-w-3xl max-h-[90vh] flex flex-col items-center">
      <button
        type="button"
        id="lightbox-close"
        aria-label="Fermer la vue agrandie"
        class="absolute -top-12 right-0 text-white hover:text-gray-300 p-2 text-2xl font-bold transition focus-visible:ring-2 focus-visible:ring-white rounded-lg"
      >
        ✕
      </button>
      <img 
        id="lightbox-img" 
        src="" 
        alt="" 
        class="max-w-full max-h-[80vh] rounded-lg shadow-2xl object-contain"
      />
      <p id="lightbox-caption" class="text-white/90 text-sm mt-3 text-center"></p>
    </div>
  </div>

  <script is:inline define:vars={{ pricing }}>
    (function () {
      const zafuImage = document.getElementById("main-zafu-image");
      const colorOverlay = document.getElementById("color-overlay");
      const sizeRadios = document.querySelectorAll(".size-radio");
      const typeRadios = document.querySelectorAll(".type-radio");
      const colorSwatches = document.querySelectorAll(".color-swatch");
      const colorPicker = document.getElementById("color-picker");
      const currentColorName = document.getElementById("current-color-name");
      const customColorIndicator = document.getElementById("custom-color-indicator");

      // Éléments du récapitulatif
      const summarySize = document.getElementById("summary-size");
      const summaryType = document.getElementById("summary-type");
      const summaryColor = document.getElementById("summary-color");
      const summaryPrice = document.getElementById("summary-price");
      const summaryPrompt = document.getElementById("summary-prompt");
      const summaryPromptText = document.getElementById("summary-prompt-text");
      const summaryActions = document.getElementById("summary-actions");
      const summaryOrderBtn = document.getElementById("summary-order-btn");
      const summaryCode = document.getElementById("summary-code");
      const configStepIndicator = document.getElementById("config-step-indicator");

      // Éléments sticky mobile
      const mobileStickyCta = document.getElementById("mobile-sticky-cta");
      const mobileStickyPrice = document.getElementById("mobile-sticky-price");
      const mobileStickyDesc = document.getElementById("mobile-sticky-desc");
      const mobileStickyBtn = document.getElementById("mobile-sticky-btn");

      // Lightbox
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");
      const openLightboxBtn = document.getElementById("open-lightbox-btn");

      let selectedSize = "";
      let selectedType = "";
      let selectedColor = "Noir"; // Couleur de base sélectionnée par défaut
      let selectedHex = "#000000";

      const prices = pricing;

      function updateConfig() {
        // Calcul du nombre d'étapes complétées
        let completedCount = 0;
        if (selectedSize) completedCount++;
        if (selectedType) completedCount++;
        if (selectedColor) completedCount++;

        // Mise à jour des lignes du récapitulatif
        if (summarySize) {
          summarySize.textContent = selectedSize 
            ? (selectedSize === "Sur mesure" ? "Sur mesure" : `Taille ${selectedSize}`)
            : "À choisir";
          summarySize.className = selectedSize 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        if (summaryType) {
          summaryType.textContent = selectedType 
            ? (selectedType === "Plein" ? "Plein (kapok)" : "Vide (housse)")
            : "À choisir";
          summaryType.className = selectedType 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        if (summaryColor) {
          summaryColor.textContent = selectedColor || "À choisir";
          summaryColor.className = selectedColor 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        // Calcul du prix
        let priceText = "-- €";
        if (selectedSize && selectedType) {
          if (selectedSize === "Sur mesure") {
            priceText = "Sur devis";
          } else {
            const val = prices[selectedSize]?.[selectedType.toLowerCase()];
            priceText = val ? `${val} €` : "Sur devis";
          }
        }

        if (summaryPrice) {
          summaryPrice.textContent = priceText;
        }

        // Badge d'état
        if (configStepIndicator) {
          if (completedCount === 3) {
            configStepIndicator.textContent = "Configuration prête";
            configStepIndicator.className = "text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300";
          } else {
            configStepIndicator.textContent = `${completedCount} / 3 choisis`;
            configStepIndicator.className = "text-xs px-2.5 py-0.5 rounded-full font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300";
          }
        }

        // Affichage du CTA ou du guidage progressif
        if (completedCount === 3) {
          if (summaryPrompt) summaryPrompt.classList.add("hidden");
          if (summaryActions) summaryActions.classList.remove("hidden");

          const code = `ZAFU-${selectedSize}-${selectedType}-${selectedColor.replace(/[^a-zA-Z0-9]/g, "_")}`;
          if (summaryCode) summaryCode.textContent = code;

          const mailSubject = encodeURIComponent(`Commande zafu artisanal : ${code}`);
          const mailBody = encodeURIComponent(
            `Bonjour Véronique,\n\nJe souhaite vous commander un zafu artisanal confectionné à Montpellier :\n\n- Taille : ${selectedSize}\n- Remplissage : ${selectedType}\n- Couleur : ${selectedColor}\n- Code : ${code}\n- Prix indicatif : ${priceText} (hors frais de port)\n\nPourriez-vous me confirmer la disponibilité, le délai de réalisation et les modalités de paiement (virement bancaire ou PayPal) ?\n\nNom & Prénom :\nAdresse de livraison ou point Mondial Relay souhaité :\nTéléphone (facultatif) :\n\nMerci d'avance,\nCordialement`
          );
          const mailtoUrl = `mailto:myokan@hotmail.fr?subject=${mailSubject}&body=${mailBody}`;

          if (summaryOrderBtn) {
            summaryOrderBtn.href = mailtoUrl;
          }

          if (mobileStickyCta) {
            if (mobileStickyPrice) mobileStickyPrice.textContent = priceText;
            if (mobileStickyDesc) mobileStickyDesc.textContent = `${selectedSize === "Sur mesure" ? "Sur mesure" : "Taille " + selectedSize} · ${selectedType} · ${selectedColor}`;
            if (mobileStickyBtn) mobileStickyBtn.href = mailtoUrl;
            mobileStickyCta.classList.remove("translate-y-full");
          }
        } else {
          if (summaryPrompt) summaryPrompt.classList.remove("hidden");
          if (summaryActions) summaryActions.classList.add("hidden");
          if (mobileStickyCta) mobileStickyCta.classList.add("translate-y-full");

          let promptMsg = "";
          if (!selectedSize && !selectedType) {
            promptMsg = "Sélectionnez la taille et le remplissage pour calculer votre tarif.";
          } else if (!selectedSize) {
            promptMsg = "Choisissez une taille pour afficher le tarif.";
          } else if (!selectedType) {
            promptMsg = "Choisissez le type de remplissage (plein ou vide) pour afficher le tarif.";
          } else if (!selectedColor) {
            promptMsg = "Choisissez encore une couleur pour finaliser votre commande.";
          }
          if (summaryPromptText) summaryPromptText.textContent = promptMsg;
        }
      }

      // Écoute des radios de taille
      sizeRadios.forEach(radio => {
        radio.addEventListener("change", () => {
          selectedSize = radio.value;

          // Mise à jour visuelle des labels
          sizeRadios.forEach(r => {
            const lbl = document.querySelector(`label[for="${r.id}"]`);
            const icon = lbl?.querySelector(".check-icon");
            if (r.checked) {
              icon?.classList.remove("hidden");
            } else {
              icon?.classList.add("hidden");
            }
          });

          updateConfig();
        });
      });

      // Écoute des radios de remplissage
      typeRadios.forEach(radio => {
        radio.addEventListener("change", () => {
          selectedType = radio.value;

          typeRadios.forEach(r => {
            const lbl = document.querySelector(`label[for="${r.id}"]`);
            const icon = lbl?.querySelector(".check-icon");
            if (r.checked) {
              icon?.classList.remove("hidden");
            } else {
              icon?.classList.add("hidden");
            }
          });

          updateConfig();
        });
      });

      // Écoute des pastilles de couleur
      colorSwatches.forEach(btn => {
        btn.addEventListener("click", () => {
          colorSwatches.forEach(b => {
            b.classList.remove("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
            b.classList.add("border-gray-300", "dark:border-gray-600");
            b.setAttribute("aria-checked", "false");
            const icon = b.querySelector(".check-icon");
            if (icon) icon.classList.add("hidden");
          });

          btn.classList.remove("border-gray-300", "dark:border-gray-600");
          btn.classList.add("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
          btn.setAttribute("aria-checked", "true");
          const icon = btn.querySelector(".check-icon");
          if (icon) icon.classList.remove("hidden");

          selectedColor = btn.dataset.name;
          selectedHex = btn.dataset.hex;

          if (currentColorName) currentColorName.textContent = selectedColor;
          if (customColorIndicator) customColorIndicator.textContent = "Sélectionnez une nuance personnalisée ou proposez votre tissu";
          if (zafuImage && btn.dataset.img) {
            zafuImage.src = btn.dataset.img;
            zafuImage.alt = `Aperçu du zafu de méditation zen artisanal coloris ${selectedColor}`;
          }
          if (colorOverlay) colorOverlay.classList.add("hidden");
          updateConfig();
        });
      });

      // Couleur personnalisée
      if (colorPicker) {
        colorPicker.addEventListener("input", () => {
          colorSwatches.forEach(b => {
            b.classList.remove("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
            b.classList.add("border-gray-300", "dark:border-gray-600");
            b.setAttribute("aria-checked", "false");
            const icon = b.querySelector(".check-icon");
            if (icon) icon.classList.add("hidden");
          });

          selectedHex = colorPicker.value.toUpperCase();
          selectedColor = `Teinte sur mesure (${selectedHex})`;
          if (currentColorName) currentColorName.textContent = selectedColor;
          if (customColorIndicator) customColorIndicator.textContent = `Nuance sélectionnée\u00a0: ${selectedHex}`;
          if (zafuImage) {
            zafuImage.src = "/zafu-plein-violet-pois.webp";
            zafuImage.alt = `Aperçu du zafu artisanal teinte sur mesure ${selectedHex}`;
          }
          if (colorOverlay) {
            colorOverlay.style.backgroundColor = selectedHex;
            colorOverlay.classList.remove("hidden");
          }
          updateConfig();
        });
      }

      // Sélection rapide depuis le guide des tailles
      document.querySelectorAll("[data-select-size]").forEach(btn => {
        btn.addEventListener("click", () => {
          const sizeVal = btn.getAttribute("data-select-size");
          const targetRadio = document.getElementById(`size-${sizeVal}`);
          if (targetRadio) {
            targetRadio.checked = true;
            targetRadio.dispatchEvent(new Event("change"));
            document.getElementById("configurator-heading")?.scrollIntoView({ behavior: "smooth" });
          }
        });
      });

      // Lightbox
      function openLightbox(src, alt) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt || "Agrandissement photo";
        if (lightboxCaption) lightboxCaption.textContent = alt || "";
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        lightboxClose?.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }

      if (zafuImage) {
        zafuImage.addEventListener("click", () => {
          openLightbox(zafuImage.src, zafuImage.alt);
        });
      }

      if (openLightboxBtn && zafuImage) {
        openLightboxBtn.addEventListener("click", () => {
          openLightbox(zafuImage.src, zafuImage.alt);
        });
      }

      document.querySelectorAll(".gallery-thumb").forEach(thumb => {
        thumb.addEventListener("click", () => {
          const full = thumb.getAttribute("data-full") || thumb.getAttribute("src");
          const alt = thumb.getAttribute("data-alt") || "";
          openLightbox(full, alt);
        });
      });

      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
          closeLightbox();
        }
      });

      // Initialisation
      updateConfig();
    })();
  </script>
</Layout>
