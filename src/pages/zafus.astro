  <script is:inline define:vars={{ pricing }}>
    (function () {
      const zafuImage = document.getElementById("main-zafu-image");
      const colorOverlay = document.getElementById("color-overlay");
      const sizeRadios = document.querySelectorAll(".size-radio");
      const typeRadios = document.querySelectorAll(".type-radio");
      const colorSwatches = document.querySelectorAll(".color-swatch");
      const colorPicker = document.getElementById("color-picker");
      const currentColorName = document.getElementById("current-color-name");
      const customColorIndicator = document.getElementById("custom-color-indicator");

      // Éléments du récapitulatif
      const summarySize = document.getElementById("summary-size");
      const summaryType = document.getElementById("summary-type");
      const summaryColor = document.getElementById("summary-color");
      const summaryPrice = document.getElementById("summary-price");
      const summaryPrompt = document.getElementById("summary-prompt");
      const summaryPromptText = document.getElementById("summary-prompt-text");
      const summaryActions = document.getElementById("summary-actions");
      const summaryOrderBtn = document.getElementById("summary-order-btn");
      const summaryCode = document.getElementById("summary-code");
      const configStepIndicator = document.getElementById("config-step-indicator");

      // Éléments sticky mobile
      const mobileStickyCta = document.getElementById("mobile-sticky-cta");
      const mobileStickyPrice = document.getElementById("mobile-sticky-price");
      const mobileStickyDesc = document.getElementById("mobile-sticky-desc");
      const mobileStickyBtn = document.getElementById("mobile-sticky-btn");

      // Lightbox
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");
      const openLightboxBtn = document.getElementById("open-lightbox-btn");

      let selectedSize = "";
      let selectedType = "";
      let selectedColor = "Noir"; // Couleur de base sélectionnée par défaut
      let selectedHex = "#000000";

      const prices = pricing;

      function updateConfig() {
        // Calcul du nombre d'étapes complétées
        let completedCount = 0;
        if (selectedSize) completedCount++;
        if (selectedType) completedCount++;
        if (selectedColor) completedCount++;

        // Mise à jour des lignes du récapitulatif
        if (summarySize) {
          summarySize.textContent = selectedSize 
            ? (selectedSize === "Sur mesure" ? "Sur mesure" : `Taille ${selectedSize}`)
            : "À choisir";
          summarySize.className = selectedSize 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        if (summaryType) {
          summaryType.textContent = selectedType 
            ? (selectedType === "Plein" ? "Plein (kapok)" : "Vide (housse)")
            : "À choisir";
          summaryType.className = selectedType 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        if (summaryColor) {
          summaryColor.textContent = selectedColor || "À choisir";
          summaryColor.className = selectedColor 
            ? "font-semibold text-gray-900 dark:text-white text-right"
            : "font-normal text-gray-400 dark:text-gray-500 text-right";
        }

        // Calcul du prix
        let priceText = "-- €";
        if (selectedSize && selectedType) {
          if (selectedSize === "Sur mesure") {
            priceText = "Sur devis";
          } else {
            const val = prices[selectedSize]?.[selectedType.toLowerCase()];
            priceText = val ? `${val} €` : "Sur devis";
          }
        }

        if (summaryPrice) {
          summaryPrice.textContent = priceText;
        }

        // Badge d'état
        if (configStepIndicator) {
          if (completedCount === 3) {
            configStepIndicator.textContent = "Configuration prête";
            configStepIndicator.className = "text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300";
          } else {
            configStepIndicator.textContent = `${completedCount} / 3 choisis`;
            configStepIndicator.className = "text-xs px-2.5 py-0.5 rounded-full font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300";
          }
        }

        // Affichage du CTA ou du guidage progressif
        if (completedCount === 3) {
          if (summaryPrompt) summaryPrompt.classList.add("hidden");
          if (summaryActions) summaryActions.classList.remove("hidden");

          const code = `ZAFU-${selectedSize}-${selectedType}-${selectedColor.replace(/[^a-zA-Z0-9]/g, "_")}`;
          if (summaryCode) summaryCode.textContent = code;

          const mailSubject = encodeURIComponent(`Commande zafu artisanal : ${code}`);
          const mailBody = encodeURIComponent(
            `Bonjour Véronique,\n\nJe souhaite vous commander un zafu artisanal confectionné à Montpellier :\n\n- Taille : ${selectedSize}\n- Remplissage : ${selectedType}\n- Couleur : ${selectedColor}\n- Code : ${code}\n- Prix indicatif : ${priceText} (hors frais de port)\n\nPourriez-vous me confirmer la disponibilité, le délai de réalisation et les modalités de paiement (virement bancaire ou PayPal) ?\n\nNom & Prénom :\nAdresse de livraison ou point Mondial Relay souhaité :\nTéléphone (facultatif) :\n\nMerci d'avance,\nCordialement`
          );
          const mailtoUrl = `mailto:myokan@hotmail.fr?subject=${mailSubject}&body=${mailBody}`;
          const formUrl = `/commander/?taille=${encodeURIComponent(selectedSize)}&type=${encodeURIComponent(selectedType)}&couleur=${encodeURIComponent(selectedColor)}&config=${encodeURIComponent(code)}`;

          if (summaryOrderBtn) {
            summaryOrderBtn.href = mailtoUrl;
          }

          const summaryFormLink = document.getElementById("summary-form-link") as HTMLAnchorElement;
          if (summaryFormLink) {
            summaryFormLink.href = formUrl;
          }

          if (mobileStickyCta) {
            if (mobileStickyPrice) mobileStickyPrice.textContent = priceText;
            if (mobileStickyDesc) mobileStickyDesc.textContent = `${selectedSize === "Sur mesure" ? "Sur mesure" : "Taille " + selectedSize} · ${selectedType} · ${selectedColor}`;
            if (mobileStickyBtn) mobileStickyBtn.href = formUrl;
            mobileStickyCta.classList.remove("translate-y-full");
          }
        } else {
          if (summaryPrompt) summaryPrompt.classList.remove("hidden");
          if (summaryActions) summaryActions.classList.add("hidden");
          if (mobileStickyCta) mobileStickyCta.classList.add("translate-y-full");

          let promptMsg = "";
          if (!selectedSize && !selectedType) {
            promptMsg = "Sélectionnez la taille et le remplissage pour calculer votre tarif.";
          } else if (!selectedSize) {
            promptMsg = "Choisissez une taille pour afficher le tarif.";
          } else if (!selectedType) {
            promptMsg = "Choisissez le type de remplissage (plein ou vide) pour afficher le tarif.";
          } else if (!selectedColor) {
            promptMsg = "Choisissez encore une couleur pour finaliser votre commande.";
          }
          if (summaryPromptText) summaryPromptText.textContent = promptMsg;
        }
      }

      // Écoute des radios de taille
      sizeRadios.forEach(radio => {
        radio.addEventListener("change", () => {
          selectedSize = radio.value;

          // Mise à jour visuelle des labels
          sizeRadios.forEach(r => {
            const lbl = document.querySelector(`label[for="${r.id}"]`);
            const icon = lbl?.querySelector(".check-icon");
            if (r.checked) {
              icon?.classList.remove("hidden");
            } else {
              icon?.classList.add("hidden");
            }
          });

          updateConfig();
        });
      });

      // Écoute des radios de remplissage
      typeRadios.forEach(radio => {
        radio.addEventListener("change", () => {
          selectedType = radio.value;

          typeRadios.forEach(r => {
            const lbl = document.querySelector(`label[for="${r.id}"]`);
            const icon = lbl?.querySelector(".check-icon");
            if (r.checked) {
              icon?.classList.remove("hidden");
            } else {
              icon?.classList.add("hidden");
            }
          });

          updateConfig();
        });
      });

      // Gestion des miniatures d'angles de vue du zafu
      const thumbBtns = document.querySelectorAll(".zafu-thumb-btn");
      const mainCaption = document.getElementById("main-zafu-caption");

      thumbBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          thumbBtns.forEach(b => {
            b.classList.remove("active", "border-2", "border-gray-900", "dark:border-white");
            b.classList.add("border", "border-gray-200", "dark:border-gray-700");
          });
          btn.classList.add("active", "border-2", "border-gray-900", "dark:border-white");
          btn.classList.remove("border", "border-gray-200", "dark:border-gray-700");

          const src = btn.getAttribute("data-src");
          const alt = btn.getAttribute("data-alt");
          const caption = btn.getAttribute("data-caption");

          if (zafuImage && src) {
            zafuImage.src = src;
            zafuImage.alt = alt || "Aperçu du zafu";
          }
          if (mainCaption && caption) {
            mainCaption.textContent = caption;
          }

          if (colorOverlay) {
            const isFirst = btn === thumbBtns[0];
            if (!isFirst) {
              colorOverlay.classList.add("hidden");
            } else if (selectedHex && selectedColor.startsWith("Teinte sur mesure")) {
              colorOverlay.classList.remove("hidden");
            }
          }
        });
      });

      // Écoute des pastilles de couleur
      colorSwatches.forEach(btn => {
        btn.addEventListener("click", () => {
          colorSwatches.forEach(b => {
            b.classList.remove("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
            b.classList.add("border-gray-300", "dark:border-gray-600");
            b.setAttribute("aria-checked", "false");
            const icon = b.querySelector(".check-icon");
            if (icon) icon.classList.add("hidden");
          });

          btn.classList.remove("border-gray-300", "dark:border-gray-600");
          btn.classList.add("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
          btn.setAttribute("aria-checked", "true");
          const icon = btn.querySelector(".check-icon");
          if (icon) icon.classList.remove("hidden");

          selectedColor = btn.dataset.name;
          selectedHex = btn.dataset.hex;

          if (currentColorName) currentColorName.textContent = selectedColor;
          if (customColorIndicator) customColorIndicator.textContent = "Sélectionnez une nuance personnalisée ou proposez votre tissu";
          if (zafuImage && btn.dataset.img) {
            zafuImage.src = btn.dataset.img;
            zafuImage.alt = `Aperçu du zafu de méditation zen artisanal coloris ${selectedColor}`;
          }

          // Réactiver la première miniature avec la couleur sélectionnée
          if (thumbBtns.length > 0) {
            const firstThumb = thumbBtns[0];
            thumbBtns.forEach(b => {
              b.classList.remove("active", "border-2", "border-gray-900", "dark:border-white");
              b.classList.add("border", "border-gray-200", "dark:border-gray-700");
            });
            firstThumb.classList.add("active", "border-2", "border-gray-900", "dark:border-white");
            firstThumb.classList.remove("border", "border-gray-200", "dark:border-gray-700");

            const firstThumbImg = firstThumb.querySelector("img");
            if (firstThumbImg && btn.dataset.img) {
              firstThumbImg.src = btn.dataset.img;
            }
            firstThumb.setAttribute("data-src", btn.dataset.img);
            firstThumb.setAttribute("data-caption", `Vue d'ensemble : Zafu traditionnel coloris ${selectedColor}, garni de kapok naturel`);
          }
          if (mainCaption) {
            mainCaption.textContent = `Vue d'ensemble : Zafu traditionnel coloris ${selectedColor}, garni de kapok naturel`;
          }

          if (colorOverlay) colorOverlay.classList.add("hidden");
          updateConfig();
        });
      });

      // Couleur personnalisée
      if (colorPicker) {
        colorPicker.addEventListener("input", () => {
          colorSwatches.forEach(b => {
            b.classList.remove("border-gray-950", "dark:border-white", "ring-2", "ring-offset-2", "ring-gray-950", "dark:ring-white", "scale-105");
            b.classList.add("border-gray-300", "dark:border-gray-600");
            b.setAttribute("aria-checked", "false");
            const icon = b.querySelector(".check-icon");
            if (icon) icon.classList.add("hidden");
          });

          selectedHex = colorPicker.value.toUpperCase();
          selectedColor = `Teinte sur mesure (${selectedHex})`;
          if (currentColorName) currentColorName.textContent = selectedColor;
          if (customColorIndicator) customColorIndicator.textContent = `Nuance sélectionnée\u00a0: ${selectedHex}`;
          if (zafuImage) {
            zafuImage.src = "/zafu-plein-violet-pois.webp";
            zafuImage.alt = `Aperçu du zafu artisanal teinte sur mesure ${selectedHex}`;
          }
          if (colorOverlay) {
            colorOverlay.style.backgroundColor = selectedHex;
            colorOverlay.classList.remove("hidden");
          }
          updateConfig();
        });
      }

      // Sélection rapide depuis le guide des tailles
      document.querySelectorAll("[data-select-size]").forEach(btn => {
        btn.addEventListener("click", () => {
          const sizeVal = btn.getAttribute("data-select-size");
          const targetRadio = document.getElementById(`size-${sizeVal}`);
          if (targetRadio) {
            targetRadio.checked = true;
            targetRadio.dispatchEvent(new Event("change"));
            document.getElementById("configurator-heading")?.scrollIntoView({ behavior: "smooth" });
          }
        });
      });

      // Lightbox accessible
      function openLightbox(src, alt, caption) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt || "Agrandissement photo zafu";
        if (lightboxCaption) lightboxCaption.textContent = caption || alt || "";
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        lightboxClose?.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }

      if (zafuImage) {
        zafuImage.addEventListener("click", () => {
          openLightbox(zafuImage.src, zafuImage.alt, mainCaption?.textContent);
        });
      }

      if (openLightboxBtn && zafuImage) {
        openLightboxBtn.addEventListener("click", () => {
          openLightbox(zafuImage.src, zafuImage.alt, mainCaption?.textContent);
        });
      }

      document.querySelectorAll(".gallery-thumb").forEach(thumb => {
        thumb.addEventListener("click", () => {
          const full = thumb.getAttribute("data-full") || thumb.getAttribute("src");
          const alt = thumb.getAttribute("data-alt") || "";
          const caption = thumb.getAttribute("data-caption") || alt;
          openLightbox(full, alt, caption);
        });
      });

      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
          closeLightbox();
        }
      });

      // Initialisation
      updateConfig();
    })();
  </script>
</Layout>
