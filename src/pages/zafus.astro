              <p class="text-xs font-semibold text-gray-600 dark:text-gray-400 mt-1">
                {pricing[s.name].vide} € vide · {pricing[s.name].plein} € plein
              </p>
              <p class="text-xs sm:text-sm text-gray-700 dark:text-gray-300 mt-3 leading-relaxed">
                {s.guideDesc}
              </p>
            </div>

            <button
              type="button"
              data-select-size={s.name}
              class={`mt-4 pt-3 border-t text-xs font-semibold flex items-center justify-between transition ${
                s.isStandard
                  ? "border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white hover:underline"
                  : "border-gray-200 dark:border-gray-800 text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white"
              }`}
            >
              <span>Choisir la taille {s.name}</span>
              <span>↑</span>
            </button>
