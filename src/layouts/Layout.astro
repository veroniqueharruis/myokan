---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import Analytics from "@vercel/analytics/astro";
import "@fontsource/noto-serif/400.css";
import "@fontsource/noto-serif/500.css";
import "@fontsource/noto-serif/600.css";
import "@fontsource/noto-sans/400.css";
import "@fontsource/noto-sans/500.css";
import "@fontsource/noto-sans/600.css";



export interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  ogType?: "website" | "article";
}

const cleanPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(cleanPath, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site
).toString();

const { 
  title, 
  fullTitle, 
  description = "Coussins de zazen artisanaux confectionnés selon la méthode traditionnelle depuis 1982 à Montpellier : zafus, zabutons, fukusas, oryokis.",
  ogType = "website"
} = Astro.props;

let makeTitle = fullTitle;
if (!makeTitle) {
  if (!title) {
    makeTitle = "Zafus zen artisanaux de tradition — Myokan, Montpellier";
  } else if (title.includes("Myokan")) {
    makeTitle = title;
  } else {
    makeTitle = `${title} — Myokan, Montpellier`;
  }
}
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (saved === "dark" || (!saved && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <slot name="head" />
    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: ogType,
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        optional: {
          description: description,
          locale: "fr_FR",
          siteName: "Myokan",
        },
        image: {
          alt: "Zafus et accessoires de méditation zen artisanaux Myokan à Montpellier",
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: makeTitle,
        description: description,
        image: resolvedImageWithDomain,
        imageAlt: "Zafus et accessoires de méditation zen artisanaux Myokan",
      }}
    />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100 min-h-screen flex flex-col antialiased overflow-x-hidden">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-gray-900 focus:text-white focus:rounded-md focus:shadow-xl focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 font-medium text-sm transition"
    >
      Aller au contenu principal
    </a>
    <Navbar />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <Analytics />
    <style is:global>
      :root {
        --font-serif: "Noto Serif", Georgia, Cambria, "Times New Roman", serif;
        --font-sans: "Noto Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

        /* Fluid type scale using clamp() for desktop & mobile harmony */
        /* xs (labels / metadata): 12px (mobile) -> 13px (desktop) */
        --text-xs: clamp(0.75rem, 0.73rem + 0.1vw, 0.8125rem);
        /* sm (small / secondary): 13.5px (mobile) -> 14.5px (desktop) */
        --text-sm: clamp(0.84rem, 0.81rem + 0.15vw, 0.906rem);
        /* base (body text): 16px (mobile) -> 17px (desktop) */
        --text-base: clamp(1rem, 0.98rem + 0.12vw, 1.0625rem);
        /* lg (intro / lead): 18px (mobile) -> 19.5px (desktop) */
        --text-lg: clamp(1.125rem, 1.08rem + 0.22vw, 1.22rem);
        /* xl (H4): 20px (mobile) -> 22px (desktop) */
        --text-xl: clamp(1.25rem, 1.18rem + 0.35vw, 1.375rem);
        /* 2xl (H3): 22px (mobile) -> 26px (desktop) */
        --text-2xl: clamp(1.375rem, 1.25rem + 0.6vw, 1.625rem);
        /* 3xl (H2): 26px (mobile) -> 36px (desktop) */
        --text-3xl: clamp(1.625rem, 1.4rem + 1.1vw, 2.25rem);
        /* 4xl (H1): 32px (mobile) -> 44px (desktop) */
        --text-4xl: clamp(2rem, 1.65rem + 1.75vw, 2.75rem);
        /* 5xl (Hero H1): 36px (mobile) -> 50px (desktop) */
        --text-5xl: clamp(2.25rem, 1.8rem + 2.25vw, 3.125rem);
        /* 6xl (Large display): 40px (mobile) -> 54px (desktop) */
        --text-6xl: clamp(2.5rem, 1.95rem + 2.75vw, 3.375rem);

        /* Semantic line heights */
        --leading-display: 1.15;
        --leading-heading: 1.2;
        --leading-heading-sm: 1.25;
        --leading-tight: 1.35;
        --leading-snug: 1.45;
        --leading-normal: 1.65;
        --leading-relaxed: 1.75;

        /* Font weights */
        --weight-normal: 400;
        --weight-medium: 500;
        --weight-semibold: 600;
      }

      img {
        content-visibility: auto;
      }

      body {
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        font-weight: 400;
        color: #1f2937;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      /* Editorial typography for headings: Noto Serif, weight 400-500, calm & timeless */
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-serif);
        font-weight: 400;
        letter-spacing: -0.012em;
        line-height: var(--leading-heading);
        text-wrap: balance;
      }

      h1 {
        line-height: var(--leading-display);
        letter-spacing: -0.02em;
        font-weight: 400;
      }

      h2 {
        line-height: var(--leading-heading);
        letter-spacing: -0.015em;
        font-weight: 400;
      }

      h3 {
        line-height: var(--leading-heading-sm);
        letter-spacing: -0.01em;
        font-weight: 400;
      }

      h4 {
        line-height: var(--leading-tight);
        font-weight: 500;
      }

      /* Functional UI: Buttons, inputs, forms */
      button, input, select, textarea {
        font-family: var(--font-sans);
      }

      /* Link readability & refinement */
      a.underline, p a:not([class*="bg-"]):not([class*="btn"]) {
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }

      /* Comfortable text measure for long French paragraphs */
      main p, article p {
        max-width: 72ch;
      }

      /* Accessible focus outline */
      :focus-visible {
        outline: 2px solid #1f2937;
        outline-offset: 2px;
      }
      html.dark :focus-visible {
        outline: 2px solid #e5e7eb;
        outline-offset: 2px;
      }

      /* Dark mode contrast helpers */
      html.dark body                { background-color: #0f172a; color: #f8fafc; }
      html.dark .text-gray-800      { color: #f8fafc; }
      html.dark .text-gray-700      { color: #e2e8f0; }
      html.dark .text-gray-600      { color: #cbd5e1; }
      html.dark .text-gray-500      { color: #94a3b8; }
      html.dark .text-gray-400      { color: #94a3b8; }
      html.dark .bg-gray-50         { background-color: #1e293b; }
      html.dark .bg-gray-100        { background-color: #1e293b; }
      html.dark .bg-white           { background-color: #0f172a; }
      html.dark .border-gray-100    { border-color: #334155; }
      html.dark .border-gray-200    { border-color: #334155; }
      html.dark .border-gray-300    { border-color: #475569; }
      html.dark .border-t           { border-color: #334155; }
      html.dark select, html.dark input[type="text"] {
        background-color: #1e293b;
        border-color: #475569;
        color: #f8fafc;
      }
      html.dark .bg-purple-50       { background-color: #2e1065; }
      html.dark .text-slate-400     { color: #94a3b8; }
    </style>
  </body>
</html>
