---
interface ZafuCardModel {
  size: "S" | "M" | "L" | "Sur mesure";
  name: string;
  badge?: string;
  featured?: boolean;
  isCustom?: boolean;
  img: string;
  alt: string;
  dimensions: string;
  useCase: string;
  price: string;
  ctaText: string;
  ctaUrl: string;
}

const models: ZafuCardModel[] = [
  {
    size: "S",
    name: "Zafu Souplesse — S",
    img: "/zafu-bleu-fonce.webp",
    alt: "Zafu artisanal de méditation taille S (28 × 13 cm) en kapok naturel — Myokan",
    dimensions: "28 cm · 13 cm",
    useCase: "Assise basse pour pratiquants très souples ou assise en lotus.",
    price: "À partir de 40 €",
    ctaText: "Découvrir",
    ctaUrl: "/zafus/?taille=S",
  },
  {
    size: "M",
    name: "Zafu Standard — M",
    badge: "Standard",
    featured: true,
    img: "/zafu-plein-noir.webp",
    alt: "Zafu artisanal de méditation taille M (30 × 15 cm) en kapok naturel — Myokan",
    dimensions: "30 cm · 15 cm",
    useCase: "Le modèle traditionnel, adapté à la majorité des pratiquants.",
    price: "À partir de 45 €",
    ctaText: "Découvrir",
    ctaUrl: "/zafus/?taille=M",
  },
  {
    size: "L",
    name: "Zafu Assise Haute — L",
    img: "/zafu-plein-marron.webp",
    alt: "Zafu artisanal de méditation taille L (32 × 17 cm) pour grand gabarit — Myokan",
    dimensions: "32 cm · 17 cm",
    useCase: "Pour les grands gabarits ou en cas de raideur du bassin.",
    price: "À partir de 50 €",
    ctaText: "Découvrir",
    ctaUrl: "/zafus/?taille=L",
  },
  {
    size: "Sur mesure",
    name: "Zafu Sur mesure",
    isCustom: true,
    img: "/zafus-pile.webp",
    alt: "Zafu confectionné sur mesure selon votre morphologie — Atelier Myokan",
    dimensions: "Dimensions au choix",
    useCase: "Confection personnalisée selon votre morphologie ou votre posture.",
    price: "Sur devis",
    ctaText: "Demander conseil",
    ctaUrl: "/commander/?produit=zafu-sur-mesure",
  },
];
---

<section 
  id="zafus-section" 
  class="mt-14 sm:mt-20 mx-auto max-w-6xl scroll-mt-20" 
  aria-labelledby="zafu-models-title"
>
  <!-- En-tête de section -->
  <header class="max-w-2xl mb-8">
    <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-1.5">
      Confections artisanales Myokan
    </p>

    <h2 id="zafu-models-title" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
      Nos zafus
    </h2>

    <p class="mt-2 text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed">
      Quatre formats pensés pour trouver l'assise naturelle adaptée à votre corps.
    </p>
  </header>

  <!-- Grille épurée des 4 modèles -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 xl:gap-5 items-stretch">
    {models.map((m) => (
      <article 
        class:list={[
          "group relative flex flex-col justify-between rounded-2xl border transition-all duration-200 overflow-hidden shadow-xs",
          m.featured 
            ? "bg-white dark:bg-gray-900 border-gray-900 dark:border-gray-300 ring-1 ring-gray-900/10 dark:ring-white/20 sm:-translate-y-1 shadow-sm" 
            : m.isCustom
              ? "bg-amber-50/40 dark:bg-gray-900/80 border-dashed border-amber-300 dark:border-amber-800/80 hover:border-amber-500 dark:hover:border-amber-600"
              : "bg-white dark:bg-gray-900 border-gray-200/90 dark:border-gray-800 hover:border-gray-400 dark:hover:border-gray-600"
        ]}
      >
        <div>
          <!-- Image -->
          <div class="p-4 pb-0">
            <div class="w-full aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
              <img
                src={m.img}
                alt={m.alt}
                width="600"
                height="450"
                class="w-full h-full object-cover object-center group-hover:scale-103 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
              {m.badge && (
                <span class="absolute top-2.5 right-2.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-gray-900/90 text-white dark:bg-white/90 dark:text-gray-950 backdrop-blur-xs">
                  {m.badge}
                </span>
              )}
            </div>
          </div>

          <!-- Détails -->
          <div class="p-4 pt-3.5 space-y-2">
            <div>
              <h3 class="font-bold text-base sm:text-lg text-gray-900 dark:text-white font-heading tracking-tight">
                {m.name}
              </h3>
              <p class="text-xs font-mono font-medium text-gray-500 dark:text-gray-400 mt-0.5">
                {m.dimensions}
              </p>
            </div>

            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed min-h-[2.5rem]">
              {m.useCase}
            </p>
          </div>
        </div>

        <!-- Prix & CTA -->
        <div class="p-4 pt-2 border-t border-gray-100 dark:border-gray-800/80 flex items-center justify-between gap-2">
          <span class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white">
            {m.price}
          </span>

          <a
            href={m.ctaUrl}
            class:list={[
              "inline-flex items-center gap-1 py-1.5 px-3 rounded-lg text-xs font-semibold transition text-center",
              m.featured
                ? "bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 shadow-2xs"
                : "border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 text-gray-800 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white bg-white dark:bg-gray-850"
            ]}
          >
            <span>{m.ctaText}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- CTA compact d'orientation unique -->
  <div class="mt-8 text-center">
    <a 
      href="/choisir-son-zafu/" 
      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white transition"
    >
      <span>Vous hésitez entre plusieurs tailles ?</span>
      <span class="text-amber-800 dark:text-amber-400 font-bold underline hover:no-underline">Quel zafu choisir ? →</span>
    </a>
  </div>
</section>
