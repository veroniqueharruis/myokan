      </a>
      <a 
        href="/contact/" 
        class="px-6 py-3.5 border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 text-gray-800 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white rounded-xl transition font-semibold text-sm bg-white dark:bg-gray-850 text-center"
      >
        Demander conseil
      </a>
    </div>

    <!-- Réassurance sobre -->
    <p class="mt-6 text-xs text-gray-500 dark:text-gray-400 font-medium">
      Prix confirmé avant fabrication · Paiement après accord · Expédition depuis Montpellier
    </p>

    <div class="mt-5 pt-4 border-t border-gray-200/60 dark:border-gray-800">
      <a 
        href="/commander/" 
        class="text-xs font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white underline hover:no-underline transition"
