<section class="mt-14 sm:mt-20 mb-10 rounded-3xl bg-gray-50/80 dark:bg-gray-900/70 border border-gray-200/80 dark:border-gray-800 px-6 sm:px-10 py-10 sm:py-14 max-w-4xl mx-auto text-center relative overflow-hidden shadow-xs" aria-labelledby="cta-heading">
  <div class="max-w-2xl mx-auto">
    <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-1.5">
      Sur commande · Contact direct
