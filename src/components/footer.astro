        <li><a href="/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Accueil</a></li>
        <li><a href="/a-propos/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">À propos de Véronique</a></li>
        <li><a href="/contact/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Commander un article</a></li>
