<footer class="mt-20 border-t border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/40 pt-12 pb-10" aria-label="Pied de page">
  <div class="max-w-6xl mx-auto px-4 grid sm:grid-cols-2 md:grid-cols-4 gap-8 text-sm text-gray-700 dark:text-gray-300">
    <div>
      <p class="font-semibold text-gray-900 dark:text-white font-heading text-lg mb-3">Zafus & Assise</p>
