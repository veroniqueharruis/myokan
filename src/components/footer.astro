        <li><a href="/zafus/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline font-semibold text-gray-900 dark:text-white">Zafus de méditation</a></li>
        <li><a href="/choisir-son-zafu/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Quel zafu choisir ?</a></li>
        <li><a href="/zabutons/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Zabutons (tapis de sol)</a></li>
        <li><a href="/sacs-zafus/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Sacs à zafu en coton</a></li>
