        <li><a href="/pratique-zazen/#choisir-zafu" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Le kapok naturel végétal</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-gray-900 dark:text-white font-heading text-lg mb-3">Pratique & Atelier</p>
      <ul class="space-y-2">
        <li><a href="/commander/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline font-semibold text-gray-900 dark:text-white">Commander (tarifs & démarches)</a></li>
        <li><a href="/contact/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">Contact & Atelier</a></li>
        <li><a href="/a-propos/" class="hover:text-gray-950 dark:hover:text-white transition hover:underline">L'atelier & Véronique</a></li>
