---
---

<section class="mt-14 sm:mt-20 mx-auto max-w-5xl" aria-labelledby="atelier-heading">
  <!-- En-tête de section -->
  <div class="max-w-3xl mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400" aria-hidden="true"></span>
      <span>Confectionné à la main · Transmission depuis 1982</span>
    </div>
    
    <h2 id="atelier-heading" class="text-3xl sm:text-4xl lg:text-[2.65rem] font-bold text-gray-900 dark:text-white font-heading tracking-tight leading-tight">
      Dans l'atelier Myokan
    </h2>
    
    <p class="mt-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Chaque zafu est confectionné à la main, sur commande, selon les gestes et le patronage traditionnel 
      transmis en 1982 à l'atelier du dojo de Paris par madame Deshimaru. Pas de stock industriel ni de confection automatisée&nbsp;: 
      chaque pièce est façonnée unitairement à Montpellier pour répondre aux exigences réelles de la posture assise.
    </p>
  </div>

  <!-- Séquence visuelle du savoir-faire en 4 étapes -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
    
    <!-- Étape 1 : Matières -->
    <figure class="flex flex-col rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 shadow-xs">
      <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
        <img 
          src="/kapokier-arbre.webp" 
          alt="Fruits du kapokier s'ouvrant pour libérer la fibre végétale naturelle de kapok" 
          width="500" 
          height="332" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 dark:bg-gray-900/90 text-gray-900 dark:text-white text-[11px] font-mono font-bold backdrop-blur-xs border border-gray-200/50 dark:border-gray-700/50">
          01 · Matières
        </span>
      </div>
      <figcaption class="p-4 flex-1 flex flex-col justify-between">
        <div>
          <strong class="block text-sm font-bold text-gray-900 dark:text-white mb-1">
            Kapok 100 % végétal
          </strong>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Fibre soyeuse issue du kapokier, légère, respirante et imputrescible. Toiles 100 % coton sergé robuste.
          </p>
        </div>
        <span class="block mt-3 pt-2 text-[11px] text-amber-800 dark:text-amber-400 font-medium border-t border-gray-100 dark:border-gray-800">
          Fibres naturelles sans synthétique
        </span>
      </figcaption>
    </figure>

    <!-- Étape 2 : Coupe & Plis -->
    <figure class="flex flex-col rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 shadow-xs">
      <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
        <img 
          src="/zafus-vides-gris.webp" 
          alt="Housses de zafus artisanales découpées et pliées selon la méthode traditionnelle" 
          width="800" 
          height="600" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 dark:bg-gray-900/90 text-gray-900 dark:text-white text-[11px] font-mono font-bold backdrop-blur-xs border border-gray-200/50 dark:border-gray-700/50">
          02 · Coupe
        </span>
      </div>
      <figcaption class="p-4 flex-1 flex flex-col justify-between">
        <div>
          <strong class="block text-sm font-bold text-gray-900 dark:text-white mb-1">
            Plis d'aisance latéraux
          </strong>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Plis accordéon méthodiquement formés à la machine. Ils permettent l'élargissement sous le poids sans tension.
          </p>
        </div>
        <span class="block mt-3 pt-2 text-[11px] text-amber-800 dark:text-amber-400 font-medium border-t border-gray-100 dark:border-gray-800">
          Patronage Deshimaru 1982
        </span>
      </figcaption>
    </figure>

    <!-- Étape 3 : Tassage -->
    <figure class="flex flex-col rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 shadow-xs">
      <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
        <img 
          src="/zafus-pile.webp" 
          alt="Pile de zafus artisanaux multicolores garnis et tassés fermement à l'atelier de Montpellier" 
          width="800" 
          height="1442" 
          class="w-full h-full object-cover object-[center_35%]"
          loading="lazy"
        />
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 dark:bg-gray-900/90 text-gray-900 dark:text-white text-[11px] font-mono font-bold backdrop-blur-xs border border-gray-200/50 dark:border-gray-700/50">
          03 · Garnissage
        </span>
      </div>
      <figcaption class="p-4 flex-1 flex flex-col justify-between">
        <div>
          <strong class="block text-sm font-bold text-gray-900 dark:text-white mb-1">
            Tassage dense du kapok
          </strong>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Environ 1 kg de kapok tassé fermement à la main par la fente protégée pour une fermeté durable sur plusieurs décennies.
          </p>
        </div>
        <span class="block mt-3 pt-2 text-[11px] text-amber-800 dark:text-amber-400 font-medium border-t border-gray-100 dark:border-gray-800">
          Assise pérenne sans affaissement
        </span>
      </figcaption>
    </figure>

    <!-- Étape 4 : Finitions & Pratique -->
    <figure class="flex flex-col rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 shadow-xs">
      <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
        <img 
          src="/zafu-noir-lin.webp" 
          alt="Zafu de méditation noir fini avec poignée en pur lin naturel et coutures renforcées" 
          width="1080" 
          height="1920" 
          class="w-full h-full object-cover object-[center_30%]"
          loading="lazy"
        />
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 dark:bg-gray-900/90 text-gray-900 dark:text-white text-[11px] font-mono font-bold backdrop-blur-xs border border-gray-200/50 dark:border-gray-700/50">
          04 · Finitions
        </span>
      </div>
      <figcaption class="p-4 flex-1 flex flex-col justify-between">
        <div>
          <strong class="block text-sm font-bold text-gray-900 dark:text-white mb-1">
            Finitions & Prêt à l'assise
          </strong>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Contrôle des dimensions, poignée en lin pur sur demande et fermeture avec rabat intérieur pour un confort total.
          </p>
        </div>
        <span class="block mt-3 pt-2 text-[11px] text-amber-800 dark:text-amber-400 font-medium border-t border-gray-100 dark:border-gray-800">
          Expédié soigné depuis Montpellier
        </span>
      </figcaption>
    </figure>

  </div>

  <!-- Bloc Histoire tangible : Une pratique transmise depuis 1982 -->
  <div class="p-6 sm:p-8 rounded-2xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200/80 dark:border-gray-800">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      
      <!-- Portrait & Identification de l'artisane -->
      <div class="md:col-span-4 flex flex-col items-center text-center p-4 bg-white dark:bg-gray-800/90 rounded-xl border border-gray-200/70 dark:border-gray-700/70 shadow-xs">
        <img
          src="/veronique.webp"
          alt="Véronique Myokan Harruis, couturière artisanale et nonne zen Soto à Montpellier"
          width="120"
          height="120"
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover shadow-sm border-2 border-amber-600/30 dark:border-amber-400/30"
          loading="lazy"
        />
        <div class="mt-3">
          <strong class="block text-base font-bold text-gray-900 dark:text-white">Véronique Myokan Harruis</strong>
          <p class="text-xs text-amber-800 dark:text-amber-400 font-semibold mt-0.5">Nonne zen Soto & Artisane</p>
          <span class="inline-block mt-2 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
            Montpellier · Pratique depuis 1980
          </span>
        </div>
      </div>

      <!-- Récit de transmission -->
      <div class="md:col-span-8 space-y-3">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
          <span>Une pratique transmise depuis 1982</span>
        </div>
        
        <h3 class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white">
          La continuité du geste et de l'exigence
        </h3>
        
        <p class="text-xs sm:text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
          <em>« J'ai commencé la pratique de zazen en 1980 auprès de maître Taisen Deshimaru et la confection des zafus en 1982 à l'atelier du dojo de Paris (Pernety). 
          Cette méthode m'a été transmise dans le respect de la forme exacte préservée par madame Deshimaru. Depuis plus de quarante ans, 
          je continue à façonner ces coussins sur commande depuis Montpellier, tout en pratiquant quotidiennement au <a href="/pratique-zazen/#dojo-montpellier" class="underline hover:text-gray-950 dark:hover:text-white font-medium">Dojo Zen de Montpellier</a>. »</em>
        </p>

        <!-- Preuves & engagements -->
        <ul class="pt-2 grid sm:grid-cols-2 gap-2 text-xs text-gray-600 dark:text-gray-400">
          <li class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-amber-700 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Confection unitaire sur commande</span>
          </li>
          <li class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-amber-700 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Zafus adaptés à votre morphologie</span>
          </li>
          <li class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-amber-700 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Conseil direct sans intermédiaire</span>
          </li>
          <li class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-amber-700 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Expédition soignée en point relais ou domicile</span>
          </li>
        </ul>

        <!-- Actions -->
        <div class="pt-3 flex flex-wrap items-center gap-3">
          <a 
            href="/a-propos/" 
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 text-xs font-semibold transition shadow-xs"
          >
            <span>Découvrir l'histoire de l'atelier</span>
            <span aria-hidden="true">→</span>
          </a>

          <a 
            href="/commander/" 
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-700 hover:bg-white dark:hover:bg-gray-800 text-gray-800 dark:text-gray-200 text-xs font-semibold transition"
          >
            <span>Comment commander un zafu ?</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

