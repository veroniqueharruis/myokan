---
import { orderingSteps } from "@data/zafus";

interface Props {
  class?: string;
  title?: string;
  subtitle?: string;
  showAllSteps?: boolean;
}

const {
  class: className = "",
  title = "Comment commander un zafu artisanal ?",
  subtitle = "Myokan est un atelier d'artisanat : chaque pièce est confectionnée avec soin après un échange direct avec l'artisane.",
  showAllSteps = false,
} = Astro.props;

// 3 étapes synthétiques pour affichage compact ou 5 étapes complètes
const displaySteps = showAllSteps ? orderingSteps : orderingSteps.slice(0, 3);
---

<section class:list={["rounded-3xl bg-gray-50 dark:bg-gray-900/70 border border-gray-200 dark:border-gray-800 p-6 sm:p-10", className]} aria-labelledby="comment-commander-heading">
  <div class="max-w-3xl mb-8">
    <span class="text-xs uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-400">
      Processus de confection & commande
    </span>
    <h2 id="comment-commander-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white mt-1 tracking-tight">
      {title}
    </h2>
    <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 mt-2.5 leading-relaxed">
      {subtitle}
    </p>
  </div>

  <!-- Étapes du processus -->
  <div class="grid sm:grid-cols-3 gap-6 relative">
    {displaySteps.map((step) => (
      <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-sm font-bold flex items-center justify-center shrink-0">
              {step.number}
            </span>
            <h3 class="font-bold text-base sm:text-lg text-gray-900 dark:text-white">
              {step.title}
            </h3>
          </div>
          
          <p class="text-xs font-semibold text-amber-800 dark:text-amber-400 mb-2">
            {step.subtitle}
          </p>

          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            {step.desc}
          </p>

          {step.details && (
            <ul class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700/60 space-y-1 text-xs text-gray-500 dark:text-gray-400">
              {step.details.map((item) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-amber-600 dark:text-amber-400">·</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Éléments de réassurance clairs et non manipulatoires -->
  <div class="mt-8 pt-6 border-t border-gray-200/80 dark:border-gray-800 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-600 dark:text-gray-400">
    <div class="flex flex-wrap items-center gap-y-2 gap-x-4">
      <span class="flex items-center gap-1.5 text-gray-800 dark:text-gray-200 font-medium">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        Prix confirmé avant fabrication
      </span>
      <span class="flex items-center gap-1.5 text-gray-800 dark:text-gray-200 font-medium">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        Conseil personnalisé direct
      </span>
      <span class="flex items-center gap-1.5 text-gray-800 dark:text-gray-200 font-medium">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        Fabrication artisanale à Montpellier
      </span>
    </div>

    <a href="/commander/" class="font-semibold text-gray-900 dark:text-white underline hover:no-underline shrink-0">
      Tout savoir sur la commande et les délais →
    </a>
  </div>
</section>
