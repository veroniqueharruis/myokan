---
interface Props {
  product?: string;
  note?: string;
}

const {
  product = "cet article",
  note = "Véronique Myokan Harruis vous confirme la faisabilité, les dimensions et le tarif exact avant toute fabrication.",
} = Astro.props;

const mailSubject = encodeURIComponent(`Demande de renseignement / commande : ${product}`);
const mailBody = encodeURIComponent(
  `Bonjour Véronique,\n\nJe souhaite échanger au sujet de : ${product} confectionné à l'atelier de Montpellier.\n\nMes souhaits (dimensions, coloris, questions) :\n...\n\nNom & Prénom :\nAdresse de livraison ou point Mondial Relay souhaité :\n\nMerci d'avance,\nCordialement`
);
---

<section class="mt-12 rounded-3xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 p-6 sm:p-8" aria-label="Commander cet article">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
    
    <div class="space-y-2 max-w-xl">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 text-[11px] font-semibold">
        <span>Artisanat zen sur commande</span>
      </div>
      <h3 class="font-bold text-gray-900 dark:text-white text-lg sm:text-xl">
        Commander ou demander un devis pour {product}
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
        {note}
      </p>

      <!-- Éléments de réassurance -->
      <div class="pt-2 flex flex-wrap items-center gap-y-1.5 gap-x-3 text-xs text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Prix confirmé avant confection
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Conseil personnalisé direct
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Paiement virement ou PayPal
        </span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 shrink-0">
      <a 
        href={`/commander/?produit=${encodeURIComponent(product)}`} 
        class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-xs sm:text-sm font-semibold rounded-xl hover:bg-gray-800 dark:hover:bg-gray-100 transition text-center shadow-sm"
      >
        <span>Commander ou demander un devis</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a 
        href={`mailto:myokan@hotmail.fr?subject=${mailSubject}&body=${mailBody}`} 
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition text-center"
      >
        <span>Écrire directement par e-mail</span>
      </a>
    </div>

  </div>
</section>
