---
const { product = "cet article" } = Astro.props;
---

<div class="mt-10 rounded-xl bg-gray-50 border border-gray-200 px-6 py-7 flex flex-col sm:flex-row sm:items-center gap-5">
  <div class="flex-1">
    <p class="font-semibold text-gray-800 text-lg">Vous souhaitez commander {product} ?</p>
    <p class="text-sm text-gray-500 mt-1">Réponse sous quelques jours · Fait main à Montpellier · Paiement par virement</p>
  </div>
  <div class="flex flex-col sm:flex-row gap-3 shrink-0">
    <a href="/contact" class="px-6 py-3.5 bg-gray-800 text-white text-sm font-medium rounded-lg hover:bg-gray-700 transition text-center">
      Passer commande
    </a>
    <a href="mailto:myokan@hotmail.fr" class="px-6 py-3.5 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:border-gray-500 transition text-center">
      Écrire un mail
    </a>
  </div>
</div>
