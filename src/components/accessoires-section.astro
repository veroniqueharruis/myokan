---
const accessoires = [
  {
    title: "Zabutons",
    desc: "Le complément du zafu pour une assise confortable.",
    img: "/zabutons-empiles.webp",
    alt: "Zabutons artisanaux de méditation empilés — Atelier Myokan",
    path: "/zabutons/",
  },
  {
    title: "Sacs à zafu",
    desc: "Pour transporter et protéger votre coussin.",
    img: "/sac-zafu-rouge.webp",
    alt: "Sac à zafu en toile rouge avec cordon — Atelier Myokan",
    path: "/sacs-zafus/",
  },
  {
    title: "Fukusas",
    desc: "Étoffes doublées pour envelopper les bols précieux.",
    img: "/fukusa-bleu-jaune.webp",
    alt: "Fukusa zen bleu et jaune traditionnel pour bol oryoki — Myokan",
    path: "/fukusas/",
  },
  {
    title: "Oryokis",
    desc: "Ensemble traditionnel pour le repas en sesshin.",
    img: "/oryokis-trio.webp",
    alt: "Bols oryoki en bois tourné et fukusas confectionnés à Montpellier — Myokan",
    path: "/oryokis/",
  },
  {
    title: "Sacs à kesa & ketsumyaku",
    desc: "Protection des robes de cérémonie zen.",
    img: "/sac-kesa-bandouliere.webp",
    alt: "Sac à kesa artisanal avec bandoulière et motifs traditionnels — Myokan",
    path: "/kesas/",
  },
];
---

<section id="accessoires" class="mt-14 sm:mt-20 mx-auto max-w-6xl scroll-mt-20" aria-labelledby="accessoires-heading">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4 pb-4 border-b border-gray-200/80 dark:border-gray-800">
    <div>
      <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-1.5">
        Compléments & confections zen
      </p>
      <h2 id="accessoires-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
        Accessoires pour la pratique
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1.5">
        Il existe aussi d’autres confections pour accompagner votre pratique.
      </p>
    </div>
    <a 
      href="/accessoires/" 
      class="text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white underline hover:no-underline shrink-0"
    >
      Voir tous les accessoires →
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    {accessoires.map((a) => (
      <a 
        href={a.path}
        class="group flex flex-col rounded-2xl border border-gray-200/80 dark:border-gray-800 overflow-hidden hover:border-gray-400 dark:hover:border-gray-600 transition bg-white dark:bg-gray-900/60 shadow-2xs hover:shadow-xs"
      >
        <div class="w-full aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-gray-800">
          <img
            src={a.img}
            alt={a.alt}
            width="400"
            height="300"
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
            loading="lazy"
          />
        </div>

        <div class="p-3.5 sm:p-4 flex flex-col flex-1 justify-between gap-2">
          <div>
            <h3 class="font-bold text-sm sm:text-base text-gray-900 dark:text-white group-hover:underline">
              {a.title}
            </h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-snug">
              {a.desc}
            </p>
          </div>

          <span class="text-xs font-semibold text-amber-800 dark:text-amber-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1 mt-1">
            <span>Découvrir</span>
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
