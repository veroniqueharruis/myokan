---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

const produits = [
  {
    title: "Zafus",
    desc: "Coussin de zazen artisanal, personnalisable en taille, coloris et remplissage.",
    img: "/zafu-plein-violet-pois.webp",
    path: "/zafus",
    prix: "À partir de 25 €",
  },
  {
    title: "Zabutons",
    desc: "Coussin de sol rectangulaire pour la pratique du zazen. Protège genoux et chevilles.",
    img: null,
    path: "/zabutons",
    prix: "Prix sur demande",
  },
  {
    title: "Sacs à zafu",
    desc: "Sac de transport en coton, fermeture cordon. Plusieurs coloris disponibles.",
    img: "/sac-zafu-rouge.webp",
    path: "/sacs-zafus",
    prix: "Prix sur demande",
  },
  {
    title: "Fukusas",
    desc: "Pièce de tissu pour protéger le bol oryoki, en plusieurs coloris.",
    img: "/fukusa-bleu-jaune.webp",
    path: "/fukusas",
    prix: "Prix sur demande",
  },
  {
    title: "Oryokis",
    desc: "Bol zen pour la cérémonie du repas en sesshin, selon les usages de la Kosen Sangha.",
    img: null,
    path: "/oryokis",
    prix: "Prix sur demande",
  },
  {
    title: "Sacs à kesa",
    desc: "Sac de transport pour kesa et pochette de ketsumyaku, cousus à la main.",
    img: null,
    path: "/kesas",
    prix: "Prix sur demande",
  },
];
---

<!-- Grille produits -->
<section class="mt-16 mx-auto max-w-5xl">
  <h2 class="text-3xl font-bold text-gray-800 mb-8">Les créations</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {produits.map((p) => (
      <a href={p.path} class="group flex flex-col border border-gray-200 rounded-xl overflow-hidden hover:border-gray-400 hover:shadow-md transition">
        {p.img ? (
          <img
            src={p.img}
            alt={p.title + " artisanal Myokan"}
            class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
          />
        ) : (
          <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
            Photos à venir
          </div>
        )}
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-bold text-gray-800 text-lg">{p.title}</h3>
          <p class="text-sm text-gray-600 mt-1 flex-1">{p.desc}</p>
          <p class="text-sm font-semibold text-gray-700 mt-3">{p.prix}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- Bio courte -->
<section class="mt-16 mx-auto max-w-5xl">
  <div class="flex flex-col sm:flex-row gap-6 items-start p-6 bg-gray-50 rounded-xl border border-gray-100">
    {publishedTeamMembers.map((m) => (
      <img
        src={m.data.avatar.src}
        alt={m.data.avatar.alt}
        width="80"
        height="80"
        class="w-20 h-20 rounded-full object-cover shrink-0"
      />
    ))}
    <div>
      <p class="font-semibold text-gray-800">Véronique Myokan Harruis — Nonne zen et couturière</p>
      <p class="text-gray-600 text-sm mt-2 leading-relaxed">
        Je réalise des coussins et accessoires zen à la main depuis 1982, selon la méthode
        traditionnelle transmise par maître Deshimaru. Chaque pièce est confectionnée sur
        commande depuis <a href="https://zen-montpellier.fr/" class="underline hover:text-gray-900" target="_blank" rel="noopener">le dojo zen de Montpellier</a>.
      </p>
    </div>
  </div>
</section>
