---
const { price } = Astro.props;
---

<div class="mt-4 inline-flex items-center gap-2 flex-wrap">
  <span class="text-2xl font-semibold text-gray-900 dark:text-white font-sans">{price}</span>
  <span class="text-sm text-gray-600 dark:text-gray-400">· hors frais de port · <a href="/contact/" class="underline hover:text-gray-950 dark:hover:text-white font-medium">demander un devis</a></span>
</div>

