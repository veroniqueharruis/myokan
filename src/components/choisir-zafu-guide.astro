---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section 
  class:list={["w-full max-w-3xl mx-auto", className]} 
  id="zafu-guide-app" 
  aria-labelledby="guide-heading"
>
  <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs relative overflow-hidden transition-all duration-300">
    
    <!-- Accent décoratif discret inspiré de la tradition -->
    <div class="absolute -right-16 -bottom-16 w-56 h-56 rounded-full bg-amber-500/5 dark:bg-amber-400/5 pointer-events-none" aria-hidden="true"></div>

    <!-- 0. ÉCRAN D'INTRODUCTION -->
    <div id="guide-screen-intro" class="guide-screen">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400">
          Assistant d’assise · Atelier Myokan
        </span>
        <h2 id="guide-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white mt-2 tracking-tight">
          Quel zafu vous convient ?
        </h2>
        <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-3.5 leading-relaxed font-normal">
          Quelques questions suffisent pour trouver le modèle le plus adapté à votre pratique et à votre morphologie.
        </p>

        <div class="mt-5 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50/80 dark:bg-amber-950/40 border border-amber-200/70 dark:border-amber-900/50 text-xs font-medium text-amber-900 dark:text-amber-300">
          <svg class="w-4 h-4 shrink-0 text-amber-700 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span>Cela prend environ 30 secondes.</span>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <button 
            type="button" 
            id="guide-start-btn" 
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 rounded-xl font-semibold text-base transition shadow-sm group text-center cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden"
          >
            <span>Commencer</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>

          <a 
            href="#guide-detaille" 
            class="inline-flex items-center justify-center px-4 py-3 text-xs sm:text-sm font-semibold text-gray-600 dark:text-gray-400 hover:text-gray-950 dark:hover:text-white underline hover:no-underline transition text-center"
          >
            Consulter d’abord le guide écrit complet ↓
          </a>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-gray-500 dark:text-gray-400">
          <span class="inline-flex items-center gap-1.5">
            <span class="text-amber-700 dark:text-amber-400">🌿</span> Kapok 100 % végétal naturel
          </span>
          <span class="text-gray-300 dark:text-gray-700 select-none">·</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="text-amber-700 dark:text-amber-400">🧵</span> Cousu main à Montpellier
          </span>
          <span class="text-gray-300 dark:text-gray-700 select-none">·</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="text-amber-700 dark:text-amber-400">💬</span> Conseil direct de l’artisane
          </span>
        </div>
      </div>
    </div>

    <!-- BARRE DE PROGRESSION DISCRÈTE (Questions 1, 2, 3) -->
    <div id="guide-progress-header" class="hidden mb-6 sm:mb-8 pb-4 border-b border-gray-100 dark:border-gray-800" role="status" aria-live="polite">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span id="guide-progress-num" class="font-mono text-xs font-bold px-2 py-0.5 rounded-md bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300">
            1 / 3
          </span>
          <span id="guide-progress-title" class="text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200">
            Pratique
          </span>
        </div>

        <!-- Indicateur discret à 3 tirets -->
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="guide-step-dash w-6 h-1 rounded-full bg-amber-700 dark:bg-amber-400 transition-all duration-200" data-dash="1"></span>
          <span class="guide-step-dash w-3 h-1 rounded-full bg-gray-200 dark:bg-gray-700 transition-all duration-200" data-dash="2"></span>
          <span class="guide-step-dash w-3 h-1 rounded-full bg-gray-200 dark:bg-gray-700 transition-all duration-200" data-dash="3"></span>
        </div>
      </div>
    </div>

    <!-- CONTENEUR DES QUESTIONS -->
    <div id="guide-questions-container">
      
      <!-- QUESTION 1 : Expérience (1 / 3) -->
      <div id="guide-screen-q1" class="guide-screen hidden" data-step="1" role="region" aria-labelledby="q1-heading">
        <h3 id="q1-heading" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
          Où en êtes-vous dans votre pratique ?
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1.5">
          Cette question permet d’adapter nos conseils à vos habitudes d’assise.
        </p>

        <div class="mt-6 space-y-3" role="radiogroup" aria-labelledby="q1-heading">
          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="experience" 
            data-value="debutant"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je débute
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Je découvre la méditation ou le zazen et je cherche une assise stable, rassurante et accessible.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="experience" 
            data-value="regulier"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je pratique régulièrement
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Assise hebdomadaire ou quotidienne (en dojo ou chez moi), j’ai des repères établis.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="experience" 
            data-value="longtemps"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je pratique depuis longtemps
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Pratique assidue de longue date, je recherche un zafu traditionnel durable et sur commande.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="experience" 
            data-value="ne_sais_pas"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je ne sais pas / je cherche simplement un zafu
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Je recherche un coussin ergonomique et traditionnel sans contrainte technique préalable.
              </span>
            </div>
          </button>
        </div>
      </div>

      <!-- QUESTION 2 : Posture (2 / 3) -->
      <div id="guide-screen-q2" class="guide-screen hidden" data-step="2" role="region" aria-labelledby="q2-heading">
        <h3 id="q2-heading" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
          Quelle posture pratiquez-vous principalement ?
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1.5 leading-relaxed">
          La posture influence la hauteur d’assise nécessaire, mais votre morphologie reste déterminante.
        </p>

        <div class="mt-6 space-y-3" role="radiogroup" aria-labelledby="q2-heading">
          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="posture" 
            data-value="demi_lotus"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Demi-lotus</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300">Posture courante</span>
              </div>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Un pied repose sur la cuisse opposée, l’autre sous la jambe. Équilibre stable et naturel.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="posture" 
            data-value="lotus"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Lotus complet
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Chaque pied sur la cuisse opposée. Grande stabilité, exige des hanches très ouvertes.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="posture" 
            data-value="seiza"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Seiza / à genoux
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Genoux vers l’avant, le coussin placé entre les cuisses pour décharger les chevilles.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="posture" 
            data-value="change"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je change de posture
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                J’alterne tailleur simple, demi-lotus ou seiza selon les moments ou la durée d’assise.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="posture" 
            data-value="ne_sais_pas"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Je ne sais pas encore
              </span>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Je recherche le modèle de référence le plus polyvalent pour débuter sereinement.
              </span>
            </div>
          </button>
        </div>
      </div>

      <!-- QUESTION 3 : Morphologie / situation (3 / 3) -->
      <div id="guide-screen-q3" class="guide-screen hidden" data-step="3" role="region" aria-labelledby="q3-heading">
        <h3 id="q3-heading" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
          Quelle situation vous correspond le mieux ?
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1.5 leading-relaxed">
          Le zafu permet au sacrum de basculer vers l’avant et aux deux genoux de toucher le sol sans cambrure lombaire forcée.
        </p>

        <div class="mt-6 space-y-3" role="radiogroup" aria-labelledby="q3-heading">
          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="situation" 
            data-value="entre_170_180"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Je mesure entre 1,70 m et 1,80 m</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300">Stature moyenne</span>
              </div>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Mobilité pelvienne normale, mes genoux s’approchent du sol une fois assis.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="situation" 
            data-value="plus_180"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Je mesure plus de 1,80 m</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-300">Grand gabarit</span>
              </div>
              <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 block mt-0.5 leading-relaxed">
                Fémurs plus longs, nécessitant une surélévation supérieure pour que les genoux atteignent le sol.
              </span>
            </div>
          </button>

          <button 
            type="button" 
            class="guide-choice-btn w-full text-left p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-850 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-400 dark:hover:border-amber-700 transition flex items-start gap-3.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-600 group"
            data-group="situation" 
            data-value="hanches_raides"
            role="radio"
            aria-checked="false"
          >
            <span class="guide-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 group-hover:border-amber-600 dark:group-hover:border-amber-400 shrink-0 mt-0.5 flex items-center justify-center transition">
              <span class="guide-radio-dot w-2.5 h-2.5 rounded-full bg-amber-800 dark:bg-amber-400 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white block">
                Mes hanches sont plutôt raides
              </span>
