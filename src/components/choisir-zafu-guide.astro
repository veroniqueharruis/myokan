---
import { sizes, pricing } from "@data/zafus";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["w-full max-w-3xl mx-auto", className]} id="zafu-guide-app">
  <!-- En-tête du questionnaire avec jauge d'avancement -->
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-sm">
    
    <!-- Barre de progression -->
    <div id="guide-progress-container" class="mb-6">
      <div class="flex items-center justify-between text-xs font-semibold text-gray-600 dark:text-gray-400 mb-2">
        <span id="guide-step-label">Étape 1 sur 5</span>
        <span id="guide-step-pct" class="font-mono">20%</span>
      </div>
      <div 
        class="w-full bg-gray-100 dark:bg-gray-800 rounded-full h-2 overflow-hidden" 
        role="progressbar" 
        id="guide-progress-bar"
        aria-valuenow="1" 
        aria-valuemin="1" 
        aria-valuemax="5"
        aria-valuetext="Étape 1 sur 5 : Votre expérience"
      >
        <div 
          id="guide-progress-fill" 
          class="bg-amber-600 dark:bg-amber-500 h-2 rounded-full transition-all duration-300 ease-out" 
          style="width: 20%;"
        ></div>
      </div>
    </div>

    <!-- Conteneur dynamique des étapes -->
    <div id="guide-steps-wrapper">
      
      <!-- ÉTAPE 1 : Expérience -->
      <section class="guide-step-view" data-step="1" aria-labelledby="q1-title">
        <div class="mb-5">
          <span class="text-xs uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-400">
            Repère 1 · Votre pratique
          </span>
          <h2 id="q1-title" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mt-1">
            Depuis combien de temps pratiquez-vous ?
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">
            Chaque coussin Myokan est pensé pour vous soutenir sans fatigue, que vous débutiez ou pratiquiez régulièrement en dojo.
          </p>
        </div>

        <fieldset class="space-y-3">
          <legend class="sr-only">Choisissez votre niveau de pratique</legend>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="experience" value="debutant" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je débute
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Je découvre la posture assise et je recherche un coussin polyvalent, stable et rassurant pour commencer.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="experience" value="quelque_temps" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je pratique depuis quelque temps
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Je ressens mieux les besoins de mon corps et je souhaite un véritable zafu traditionnel pérenne.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="experience" value="regulier" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je pratique régulièrement
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Assise quotidienne établie en dojo ou chez moi, j'ai des repères précis de hauteur et de fermeté.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="experience" value="ne_sais_pas" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je ne sais pas / je préfère être conseillé
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Je recherche une assise confortable pour méditer sans a priori technique.
              </span>
            </div>
          </label>
        </fieldset>
      </section>

      <!-- ÉTAPE 2 : Posture -->
      <section class="guide-step-view hidden" data-step="2" aria-labelledby="q2-title">
        <div class="mb-5">
          <span class="text-xs uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-400">
            Repère 2 · Posture d'assise
          </span>
          <h2 id="q2-title" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mt-1">
            Dans quelle posture pratiquez-vous principalement ?
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">
            La position des jambes détermine l'angle du bassin et la hauteur nécessaire pour relâcher le ventre.
          </p>
        </div>

        <fieldset class="space-y-3">
          <legend class="sr-only">Choisissez votre posture de méditation</legend>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="posture" value="demi_lotus" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Demi-lotus (Hanka-fusa)</span>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300 font-medium">Posture la plus courante</span>
              </div>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Un pied repose sur la cuisse opposée, l'autre sous la jambe. Équilibre naturel et stable pour la plupart des pratiquants.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="posture" value="lotus" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Lotus (Kekka-fusa)
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Chaque pied repose sur la cuisse opposée. Très grande stabilité mais requiert une excellente souplesse des hanches.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="posture" value="birmane_tailleur" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Posture birmane ou tailleur simple
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Les jambes sont croisées au sol sans croiser les pieds sur les cuisses. Mollets et pieds reposent à plat sur le zabuton.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="posture" value="seiza" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Seiza (À genoux)
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Genoux pliés vers l'avant, le zafu calé verticalement ou horizontalement entre les jambes pour décharger le poids des chevilles.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="posture" value="ne_sais_pas" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je ne sais pas
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Je souhaite le modèle de référence universel pour découvrir sereinement la posture.
              </span>
            </div>
          </label>
        </fieldset>
      </section>

      <!-- ÉTAPE 3 : Morphologie -->
      <section class="guide-step-view hidden" data-step="3" aria-labelledby="q3-title">
        <div class="mb-5">
          <span class="text-xs uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-400">
            Repère 3 · Morphologie & Souplesse
          </span>
          <h2 id="q3-title" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mt-1">
            Quelle est votre morphologie ?
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">
            Dans le zazen, le bassin bascule vers l'avant et les deux genoux pressent le sol. La stature et l'ouverture du bassin guident la hauteur.
          </p>
        </div>

        <fieldset class="space-y-3">
          <legend class="sr-only">Choisissez votre morphologie</legend>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="morphologie" value="standard" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Stature standard (jusqu'à 1m80) et souplesse normale</span>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300 font-medium">85% des adultes</span>
              </div>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Mes genoux se rapprochent facilement du sol une fois assis sur un coussin classique.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="morphologie" value="tres_souple" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Très souple des hanches (genoux au sol sans effort)
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Mes hanches s'ouvrent naturellement sans tension dans les aines. Un coussin trop haut cambrerait mon dos.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="morphologie" value="grand_gabarit" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Grand gabarit (plus de 1m80) ou hanches peu mobiles
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Mes genoux restent surélevés au-dessus du sol, mon dos a tendance à s'arrondir sans surélévation.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="morphologie" value="specifique" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Je préfère être conseillé / Confection sur mesure
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Stature particulière (&lt; 1m50 ou &gt; 1m90), genoux sensibles ou demande sur mesure : échangez avec Véronique.
              </span>
            </div>
          </label>
        </fieldset>
      </section>

      <!-- ÉTAPE 4 : Hauteur -->
      <section class="guide-step-view hidden" data-step="4" aria-labelledby="q4-title">
        <div class="mb-5">
          <span class="text-xs uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-400">
            Repère 4 · Hauteur recherchée
          </span>
          <h2 id="q4-title" class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mt-1">
            Quelle hauteur recherchez-vous ?
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">
            La hauteur du zafu influence notamment l'inclinaison du bassin et la position des jambes.
          </p>
        </div>

        <fieldset class="space-y-3">
          <legend class="sr-only">Choisissez la hauteur de zafu souhaitée</legend>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="hauteur" value="intermediaire" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm sm:text-base text-gray-900 dark:text-white">Hauteur intermédiaire (~15 cm — Taille M)</span>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300 font-medium">Standard recommandé</span>
              </div>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Le gabarit traditionnel transmis par maître Deshimaru. Convient à la très grande majorité des pratiquants.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="hauteur" value="basse" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Plutôt bas (~13 cm — Taille S)
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Idéal pour les personnes très souples en plein lotus, petits gabarits ou pour emporter en voyage et sesshin.
              </span>
            </div>
          </label>

          <label class="guide-option-card flex items-start p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/40 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 hover:border-amber-300 dark:hover:border-amber-800 cursor-pointer transition focus-within:ring-2 focus-within:ring-amber-500">
            <input type="radio" name="hauteur" value="haute" class="sr-only" />
            <span class="guide-indicator w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 mr-3.5 mt-0.5 shrink-0 flex items-center justify-center transition">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-600 dark:bg-amber-500 hidden"></span>
            </span>
            <div class="flex-1">
              <span class="block font-semibold text-sm sm:text-base text-gray-900 dark:text-white">
                Plutôt haut (~17 cm — Taille L)
              </span>
              <span class="block text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-0.5">
                Surélévation confortable pour grands gabarits (> 1m80), hanches serrées ou posture seiza à genoux.
              </span>
            </div>
          </label>

