<script>
  import { evaluateZafuRecommendation, type UserAnswers } from "@data/zafus";

  document.addEventListener("DOMContentLoaded", () => {
    const root = document.getElementById("zafu-guide-app");
    if (!root) return;

    let currentStep = 1;
    const totalSteps = 5;
    const answers: UserAnswers = {};

    const progressFill = document.getElementById("guide-progress-fill") as HTMLElement;
    const progressBar = document.getElementById("guide-progress-bar") as HTMLElement;
    const stepLabel = document.getElementById("guide-step-label") as HTMLElement;
    const stepPct = document.getElementById("guide-step-pct") as HTMLElement;
    const prevBtn = document.getElementById("guide-prev-btn") as HTMLButtonElement;
    const nextBtn = document.getElementById("guide-next-btn") as HTMLButtonElement;
    const nextText = document.getElementById("guide-next-text") as HTMLElement;
    const navBar = document.getElementById("guide-nav-bar") as HTMLElement;
    const restartBtn = document.getElementById("guide-restart-btn") as HTMLButtonElement;

    const stepViews = root.querySelectorAll<HTMLElement>(".guide-step-view");

    // Écoute des clics sur les cartes d'options
    const optionCards = root.querySelectorAll<HTMLLabelElement>(".guide-option-card");
    optionCards.forEach((card) => {
      const input = card.querySelector<HTMLInputElement>("input[type='radio']");
      if (!input) return;

      card.addEventListener("click", () => {
        const groupName = input.name;
        const allInGroup = root.querySelectorAll<HTMLInputElement>(`input[name='${groupName}']`);
        
        allInGroup.forEach((otherInput) => {
          const parentCard = otherInput.closest<HTMLLabelElement>(".guide-option-card");
          const dot = parentCard?.querySelector<HTMLElement>(".guide-indicator span");
          if (parentCard) {
            parentCard.classList.remove("border-amber-600", "dark:border-amber-400", "bg-amber-50/70", "dark:bg-amber-950/30", "ring-1", "ring-amber-500");
          }
          if (dot) dot.classList.add("hidden");
        });

        input.checked = true;
        card.classList.add("border-amber-600", "dark:border-amber-400", "bg-amber-50/70", "dark:bg-amber-950/30", "ring-1", "ring-amber-500");
        const activeDot = card.querySelector<HTMLElement>(".guide-indicator span");
        if (activeDot) activeDot.classList.remove("hidden");

        // Enregistrer la réponse
        // @ts-ignore
        answers[groupName as keyof UserAnswers] = input.value;

        // Activer le bouton continuer
        nextBtn.disabled = false;

        // Analytics (safe)
        if (typeof window !== "undefined" && (window as any).va) {
          (window as any).va("event", { name: "guide_option_selected", step: currentStep, option: input.value });
        }

        // Avancer doucement vers la question suivante
        setTimeout(() => {
          if (currentStep <= totalSteps) {
            goToStep(currentStep + 1);
          }
        }, 250);
      });
    });

    function updateStepUI() {
      // Masquer toutes les étapes
      stepViews.forEach((view) => {
        const stepNum = view.getAttribute("data-step");
        if (currentStep <= totalSteps && stepNum === String(currentStep)) {
          view.classList.remove("hidden");
        } else if (currentStep > totalSteps && stepNum === "result") {
          view.classList.remove("hidden");
        } else {
          view.classList.add("hidden");
        }
      });

      // Gestion de la barre de progression
      if (currentStep <= totalSteps) {
        navBar.classList.remove("hidden");
        const pct = Math.round((currentStep / totalSteps) * 100);
        progressFill.style.width = `${pct}%`;
        stepLabel.textContent = `Étape ${currentStep} sur ${totalSteps}`;
        stepPct.textContent = `${pct}%`;
        progressBar.setAttribute("aria-valuenow", String(currentStep));
        progressBar.setAttribute("aria-valuetext", `Étape ${currentStep} sur ${totalSteps}`);

        prevBtn.disabled = currentStep === 1;
        nextText.textContent = currentStep === totalSteps ? "Voir mon résultat" : "Continuer";

        // Vérifier si cette étape a déjà une réponse
        const currentField = getFieldForStep(currentStep);
        // @ts-ignore
        const hasAnswer = Boolean(answers[currentField]);
        nextBtn.disabled = !hasAnswer;
      } else {
        // Mode résultat
        navBar.classList.add("hidden");
        progressFill.style.width = "100%";
        stepLabel.textContent = "Orientation personnalisée";
        stepPct.textContent = "100%";
        renderRecommendation();

        // Analytics (safe)
        if (typeof window !== "undefined" && (window as any).va) {
          (window as any).va("event", { name: "guide_completed", answers: JSON.stringify(answers) });
        }
      }

      // Scroll doux vers le haut du composant
      root.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function getFieldForStep(step: number): keyof UserAnswers {
      switch (step) {
        case 1: return "experience";
        case 2: return "posture";
        case 3: return "morphologie";
        case 4: return "hauteur";
        case 5: return "rembourrage";
        default: return "experience";
      }
    }

    function goToStep(step: number) {
      if (step < 1) step = 1;
      currentStep = step;
      updateStepUI();
    }

    function renderRecommendation() {
      const rec = evaluateZafuRecommendation(answers);

      const resultImage = document.getElementById("result-image") as HTMLImageElement;
      const resultName = document.getElementById("result-name") as HTMLElement;
      const resultPrice = document.getElementById("result-price") as HTMLElement;
      const resultSizeBadge = document.getElementById("result-size-badge") as HTMLElement;
      const resultWhy = document.getElementById("result-why") as HTMLElement;
      const resultDimensions = document.getElementById("result-dimensions") as HTMLElement;
      const resultHeight = document.getElementById("result-height") as HTMLElement;
      const resultFilling = document.getElementById("result-filling") as HTMLElement;
      const resultAnswersSummary = document.getElementById("result-answers-summary") as HTMLElement;
      const ctaConfigurator = document.getElementById("result-cta-configurator") as HTMLAnchorElement;
      const ctaContact = document.getElementById("result-cta-contact") as HTMLAnchorElement;

      // Affichage visuel & textes
      resultImage.src = rec.sizeData.img;
      resultImage.alt = rec.sizeData.alt;
      resultName.textContent = `Zafu traditionnel — Taille ${rec.size}`;
      resultSizeBadge.textContent = rec.size === "Sur mesure" ? "Sur mesure" : `Taille ${rec.size} · ${rec.sizeData.detail}`;

      if (rec.size === "Sur mesure") {
        resultPrice.textContent = "Tarif sur devis selon confection";
      } else {
        const fullPrice = rec.price.plein ? `${rec.price.plein} € plein (avec kapok)` : "";
        const emptyPrice = rec.price.vide ? `${rec.price.vide} € vide` : "";
        resultPrice.textContent = `${fullPrice} · ${emptyPrice}`;
      }

      resultWhy.textContent = rec.whyExplanation;
      resultDimensions.textContent = rec.dimensionsSummary;
      resultHeight.textContent = rec.heightSummary;
      resultFilling.textContent = rec.fillingSummary;

      // Résumé lisible des réponses
      const expMap: Record<string, string> = {
        debutant: "Débutant",
        quelque_temps: "Quelque temps",
        regulier: "Régulier",
        ne_sais_pas: "Je préfère être conseillé",
      };
      const postMap: Record<string, string> = {
        demi_lotus: "Demi-lotus",
        lotus: "Plein lotus",
        birmane_tailleur: "Birmane / Tailleur",
        seiza: "Seiza (À genoux)",
        ne_sais_pas: "En découverte",
      };
      const morphMap: Record<string, string> = {
        standard: "Standard (jusqu'à 1m80)",
        tres_souple: "Très souple",
        grand_gabarit: "Grand gabarit (> 1m80)",
        specifique: "Sur mesure / Conseil",
      };

      const expText = answers.experience ? expMap[answers.experience] || answers.experience : "Non précisé";
      const postText = answers.posture ? postMap[answers.posture] || answers.posture : "Non précisé";
      const morphText = answers.morphologie ? morphMap[answers.morphologie] || answers.morphologie : "Non précisé";
      const fillText = answers.rembourrage === "vide" ? "Housse vide seule" : "Zafu plein (kapok naturel)";

      resultAnswersSummary.textContent = `Expérience : ${expText} · Posture : ${postText} · Morphologie : ${morphText} · Garnissage : ${fillText}`;

      // URL configurateur pré-paramétrée
      const configUrl = new URL("/zafus/", window.location.origin);
      if (rec.size) configUrl.searchParams.set("taille", rec.size);
      configUrl.searchParams.set("type", rec.fillingType);
      ctaConfigurator.href = configUrl.toString();

      // Email pré-rempli pour échanger avec Véronique
      const mailSubject = encodeURIComponent(`Demande de conseil : Zafu Taille ${rec.size}`);
      const mailBody = encodeURIComponent(
        `Bonjour Véronique,\n\nJ'ai suivi le guide de choix sur le site Myokan. Voici les repères de ma pratique :\n- Expérience : ${expText}\n- Posture : ${postText}\n- Morphologie : ${morphText}\n- Garnissage souhaité : ${fillText}\n\nLe guide m'oriente vers le Zafu Taille ${rec.size} (${rec.dimensionsSummary}).\n\nPouvez-vous me confirmer si ce modèle est bien adapté ou m'éclairer sur mon choix ?\n\nMerci beaucoup pour vos conseils,\n`
      );
      ctaContact.href = `mailto:myokan@hotmail.fr?subject=${mailSubject}&body=${mailBody}`;
    }

    // Gestion des boutons de navigation
    prevBtn.addEventListener("click", () => {
      if (currentStep > 1) {
        goToStep(currentStep - 1);
      }
    });

    nextBtn.addEventListener("click", () => {
      if (currentStep <= totalSteps) {
        goToStep(currentStep + 1);
      }
    });

    restartBtn?.addEventListener("click", () => {
      goToStep(1);
    });

    // Initialisation
    updateStepUI();
  });
</script>
