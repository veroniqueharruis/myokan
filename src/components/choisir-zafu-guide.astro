<script>
  import { recommendZafu, type GuideAnswers, type ExperienceLevel, type PostureType, type SituationType } from "../utils/zafu-recommendation";

  document.addEventListener("DOMContentLoaded", () => {
    const root = document.getElementById("zafu-guide-app") as HTMLElement;
    if (!root) return;

    // Éléments UI
    const screenIntro = document.getElementById("guide-screen-intro") as HTMLElement;
    const screenQ1 = document.getElementById("guide-screen-q1") as HTMLElement;
    const screenQ2 = document.getElementById("guide-screen-q2") as HTMLElement;
    const screenQ3 = document.getElementById("guide-screen-q3") as HTMLElement;
    const screenResult = document.getElementById("guide-screen-result") as HTMLElement;

    const progressHeader = document.getElementById("guide-progress-header") as HTMLElement;
    const progressNum = document.getElementById("guide-progress-num") as HTMLElement;
    const progressTitle = document.getElementById("guide-progress-title") as HTMLElement;
    const dashes = root.querySelectorAll<HTMLElement>(".guide-step-dash");

    const navBar = document.getElementById("guide-nav-bar") as HTMLElement;
    const prevBtn = document.getElementById("guide-prev-btn") as HTMLButtonElement;
    const nextBtn = document.getElementById("guide-next-btn") as HTMLButtonElement;
    const nextText = document.getElementById("guide-next-text") as HTMLElement;
    const startBtn = document.getElementById("guide-start-btn") as HTMLButtonElement;
    const restartBtn = document.getElementById("guide-restart-btn") as HTMLButtonElement;

    // État
    // 0 = Intro, 1 = Q1, 2 = Q2, 3 = Q3, 4 = Résultat
    let currentStep = 0;
    const answers: GuideAnswers = {};

    const stepTitles: Record<number, string> = {
      1: "Pratique",
      2: "Posture",
      3: "Morphologie",
    };

    // Analytics safe helper
    function sendAnalytics(eventName: string, data?: Record<string, any>) {
      if (typeof window !== "undefined" && (window as any).va) {
        try {
          (window as any).va("event", { name: eventName, ...data });
        } catch {
          // ignore
        }
      }
    }

    // Synchronisation URL (query parameters)
    function syncUrl() {
      if (typeof window === "undefined" || !window.history) return;
      const url = new URL(window.location.href);
      if (answers.experience) url.searchParams.set("pratique", answers.experience);
      else url.searchParams.delete("pratique");

      if (answers.posture) url.searchParams.set("posture", answers.posture);
      else url.searchParams.delete("posture");

      if (answers.situation) url.searchParams.set("situation", answers.situation);
      else url.searchParams.delete("situation");

      window.history.replaceState({}, "", url.toString());
    }

    // Lecture initiale de l'URL si des paramètres existent
    function initFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const urlPratique = params.get("pratique") as ExperienceLevel | null;
      const urlPosture = params.get("posture") as PostureType | null;
      const urlSituation = params.get("situation") as SituationType | null;

      let hasData = false;
      if (urlPratique) {
        answers.experience = urlPratique;
        selectCardInDOM("experience", urlPratique);
        hasData = true;
      }
      if (urlPosture) {
        answers.posture = urlPosture;
        selectCardInDOM("posture", urlPosture);
        hasData = true;
      }
      if (urlSituation) {
        answers.situation = urlSituation;
        selectCardInDOM("situation", urlSituation);
        hasData = true;
      }

      if (answers.experience && answers.posture && answers.situation) {
        // Directement afficher le résultat si tout est fourni
        goToStep(4);
      } else if (hasData) {
        // Si partiel, aller à la première question non remplie
        if (!answers.experience) goToStep(1);
        else if (!answers.posture) goToStep(2);
        else goToStep(3);
      }
    }

    function selectCardInDOM(group: string, value: string) {
      const cards = root.querySelectorAll<HTMLButtonElement>(`.guide-choice-btn[data-group="${group}"]`);
      cards.forEach(card => {
        const isMatch = card.getAttribute("data-value") === value;
        card.setAttribute("aria-checked", isMatch ? "true" : "false");
        const dot = card.querySelector<HTMLElement>(".guide-radio-dot");
        const indicator = card.querySelector<HTMLElement>(".guide-radio-indicator");

        if (isMatch) {
          card.classList.add("border-amber-700", "dark:border-amber-400", "bg-amber-50/70", "dark:bg-amber-950/30", "ring-1", "ring-amber-600");
          if (indicator) indicator.classList.add("border-amber-700", "dark:border-amber-400");
          if (dot) dot.classList.remove("hidden");
        } else {
          card.classList.remove("border-amber-700", "dark:border-amber-400", "bg-amber-50/70", "dark:bg-amber-950/30", "ring-1", "ring-amber-600");
          if (indicator) indicator.classList.remove("border-amber-700", "dark:border-amber-400");
          if (dot) dot.classList.add("hidden");
        }
      });
    }

    function updateStepUI() {
      // Masquer tous les écrans
      screenIntro.classList.add("hidden");
      screenQ1.classList.add("hidden");
      screenQ2.classList.add("hidden");
      screenQ3.classList.add("hidden");
      screenResult.classList.add("hidden");

      if (currentStep === 0) {
        // Écran Intro
        screenIntro.classList.remove("hidden");
        progressHeader.classList.add("hidden");
        navBar.classList.add("hidden");
      } else if (currentStep >= 1 && currentStep <= 3) {
        // Écran Question
        progressHeader.classList.remove("hidden");
        navBar.classList.remove("hidden");

        progressNum.textContent = `${currentStep} / 3`;
        progressTitle.textContent = stepTitles[currentStep] || "";

        // Mise à jour des tirets
        dashes.forEach((dash, idx) => {
          const dashStep = idx + 1;
          if (dashStep <= currentStep) {
            dash.className = "guide-step-dash w-6 h-1 rounded-full bg-amber-700 dark:bg-amber-400 transition-all duration-200";
          } else {
            dash.className = "guide-step-dash w-3 h-1 rounded-full bg-gray-200 dark:bg-gray-700 transition-all duration-200";
          }
        });

        if (currentStep === 1) screenQ1.classList.remove("hidden");
        if (currentStep === 2) screenQ2.classList.remove("hidden");
        if (currentStep === 3) screenQ3.classList.remove("hidden");

        nextText.textContent = currentStep === 3 ? "Voir ma recommandation" : "Continuer";

        // Vérifier si la question en cours a déjà une réponse
        let hasAnswer = false;
        if (currentStep === 1) hasAnswer = Boolean(answers.experience);
        if (currentStep === 2) hasAnswer = Boolean(answers.posture);
        if (currentStep === 3) hasAnswer = Boolean(answers.situation);

        nextBtn.disabled = !hasAnswer;
      } else if (currentStep === 4) {
        // Écran Résultat
        progressHeader.classList.add("hidden");
        navBar.classList.add("hidden");
        screenResult.classList.remove("hidden");

        renderResult();
        sendAnalytics("zafu_guide_completed", { answers });
        sendAnalytics("zafu_recommendation_viewed");
      }

      // Scroll doux vers le haut du composant si on a avancé
      if (currentStep > 0) {
        root.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    function focusStepHeader(step: number) {
      setTimeout(() => {
        if (step === 1) {
          const heading = document.getElementById("q1-heading");
          heading?.setAttribute("tabindex", "-1");
          heading?.focus();
        } else if (step === 2) {
          const heading = document.getElementById("q2-heading");
          heading?.setAttribute("tabindex", "-1");
          heading?.focus();
        } else if (step === 3) {
          const heading = document.getElementById("q3-heading");
          heading?.setAttribute("tabindex", "-1");
          heading?.focus();
        } else if (step === 4) {
          const heading = document.getElementById("result-main-heading");
          heading?.setAttribute("tabindex", "-1");
          heading?.focus();
        }
      }, 60);
    }

    function goToStep(step: number) {
      currentStep = step;
      updateStepUI();
      syncUrl();
      if (step > 0) {
        focusStepHeader(step);
      }
    }

    // Gestion de la sélection et navigation clavier sur les cartes
    const choiceButtons = root.querySelectorAll<HTMLButtonElement>(".guide-choice-btn");
    choiceButtons.forEach((btn) => {
      // Navigation au clavier avec les flèches haut/bas et droite/gauche
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowRight") {
          e.preventDefault();
          const next = btn.nextElementSibling as HTMLButtonElement;
          if (next && next.classList.contains("guide-choice-btn")) {
            next.focus();
          }
        } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
          e.preventDefault();
          const prev = btn.previousElementSibling as HTMLButtonElement;
          if (prev && prev.classList.contains("guide-choice-btn")) {
            prev.focus();
          }
        }
      });

      btn.addEventListener("click", () => {
        const group = btn.getAttribute("data-group");
        const val = btn.getAttribute("data-value");
        if (!group || !val) return;

        // Enregistrer la réponse
        if (group === "experience") answers.experience = val as ExperienceLevel;
        if (group === "posture") answers.posture = val as PostureType;
        if (group === "situation") answers.situation = val as SituationType;

        selectCardInDOM(group, val);
        nextBtn.disabled = false;

        sendAnalytics("zafu_guide_question_answered", { question: group, value: val });

        // Transition douce automatique vers l'étape suivante
        setTimeout(() => {
          if (currentStep >= 1 && currentStep <= 3) {
            goToStep(currentStep + 1);
          }
        }, 220);
      });
    });

    // Rendu du résultat
    function renderResult() {
      const rec = recommendZafu(answers);

      const heading = document.getElementById("result-main-heading") as HTMLElement;
      const badgeText = document.getElementById("result-badge-text") as HTMLElement;
      const modelImage = document.getElementById("result-model-image") as HTMLImageElement;
      const dimensionsPill = document.getElementById("result-dimensions-pill") as HTMLElement;
      const modelTitle = document.getElementById("result-model-title") as HTMLElement;
      const priceKapok = document.getElementById("result-price-kapok") as HTMLElement;
      const priceVide = document.getElementById("result-price-vide") as HTMLElement;
      const whyTitle = document.getElementById("result-why-title") as HTMLElement;
      const whyText = document.getElementById("result-why-text") as HTMLElement;
      const alternativesContainer = document.getElementById("result-alternatives-container") as HTMLElement;
      const alternativesList = document.getElementById("result-alternatives-list") as HTMLElement;
      const ctaConfigure = document.getElementById("result-cta-configure") as HTMLAnchorElement;
      const ctaContact = document.getElementById("result-cta-contact") as HTMLAnchorElement;
      const ctaOrder = document.getElementById("result-cta-order") as HTMLAnchorElement;
      const summaryLine = document.getElementById("result-summary-line") as HTMLElement;

      heading.textContent = rec.modelName;
      badgeText.textContent = rec.badge;
      modelImage.src = rec.image;
      modelImage.alt = rec.imageAlt;
      dimensionsPill.textContent = rec.dimensions;
      modelTitle.textContent = rec.modelName;

      priceKapok.textContent = rec.priceKapok;
      if (rec.priceVide) {
        priceVide.textContent = rec.priceVide;
        priceVide.classList.remove("hidden");
      } else {
        priceVide.classList.add("hidden");
      }

      whyTitle.innerHTML = `<span>💡</span> ${rec.whyTitle}`;
      whyText.textContent = rec.whyExplanation;

      // Alternatives
      if (rec.alternatives && rec.alternatives.length > 0) {
        alternativesContainer.classList.remove("hidden");
        alternativesList.innerHTML = rec.alternatives
          .map(
            (alt) => `
          <a 
            href="${alt.url}" 
            class="p-3.5 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-850 hover:border-amber-400 dark:hover:border-amber-700 transition block group text-left"
          >
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs sm:text-sm text-gray-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-400 transition">
                ${alt.name}
              </span>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
                ${alt.dimensions}
              </span>
            </div>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 leading-snug">
              ${alt.reason}
            </p>
          </a>
        `
          )
          .join("");
      } else {
        alternativesContainer.classList.add("hidden");
      }

      // CTAs URLs
      ctaConfigure.href = rec.configureUrl;
      ctaContact.href = rec.contactUrl;
      ctaOrder.href = rec.orderUrl;
      summaryLine.textContent = `Vos repères : ${rec.summaryText}`;

      // Tracking des clics CTAs
      ctaConfigure.onclick = () => sendAnalytics("zafu_recommendation_clicked", { target: "configure", size: rec.size });
      ctaContact.onclick = () => sendAnalytics("zafu_advice_clicked", { size: rec.size });
      ctaOrder.onclick = () => sendAnalytics("zafu_recommendation_clicked", { target: "order", size: rec.size });
    }

    // Événements boutons
    startBtn?.addEventListener("click", () => {
      sendAnalytics("zafu_guide_started");
      goToStep(1);
    });

    prevBtn?.addEventListener("click", () => {
      if (currentStep > 1) {
        goToStep(currentStep - 1);
      } else if (currentStep === 1) {
        goToStep(0);
      }
    });

    nextBtn?.addEventListener("click", () => {
      if (currentStep >= 1 && currentStep <= 3) {
        goToStep(currentStep + 1);
      }
    });

    restartBtn?.addEventListener("click", () => {
      goToStep(1);
    });

    // Initialisation
    initFromUrl();
    if (currentStep === 0) {
      updateStepUI();
    }
  });
</script>
