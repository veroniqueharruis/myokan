---
const piliers = [
  {
    title: "Cousu à la main",
    desc: "Chaque zafu est confectionné à la commande dans l'atelier de Montpellier.",
    icon: "🧵",
  },
  {
    title: "Kapok naturel",
    desc: "Un rembourrage végétal ferme et durable, adapté à la pratique du zazen.",
    icon: "🌿",
  },
  {
    title: "Un conseil direct",
    desc: "Vous échangez directement avec Véronique pour choisir votre zafu.",
    icon: "💬",
  },
];
---

<section class="mt-14 sm:mt-20 mx-auto max-w-5xl scroll-mt-20" aria-labelledby="pourquoi-heading">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-1.5">
      Savoir-faire & Authenticité
    </p>
    <h2 id="pourquoi-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
      Pourquoi Myokan&nbsp;?
    </h2>
  </div>

  <div class="grid sm:grid-cols-3 gap-5 lg:gap-6">
    {piliers.map((p) => (
      <div class="p-6 sm:p-7 rounded-2xl bg-gray-50/70 dark:bg-gray-900/60 border border-gray-200/80 dark:border-gray-800 flex flex-col justify-between shadow-xs">
        <div>
          <span class="text-2xl mb-3 block" aria-hidden="true">{p.icon}</span>
          <h3 class="font-bold text-gray-900 dark:text-white text-lg mb-2 font-heading">
            {p.title}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            {p.desc}
          </p>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 text-center">
    <a 
      href="/a-propos/" 
      class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white underline hover:no-underline transition"
    >
      <span>Découvrir le savoir-faire de l'atelier</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
