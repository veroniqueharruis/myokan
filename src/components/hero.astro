---
import { Picture } from "astro:assets";
import heroImage from "assets/hero.webp";
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Zafu de méditation zen artisanal fait main par Myokan"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter text-gray-800">
      Zafus Myokan
    </h1>
    <p class="text-lg mt-4 text-gray-600 max-w-xl">
      Zafus traditionnels ou fantaisie, cousus à la main à Montpellier.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/zafus" class="px-6 py-3 bg-gray-800 text-white rounded-md hover:bg-gray-700 transition">
        Configurer un zafu
      </a>
      <a href="/contact" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-md hover:border-gray-500 transition">
        Passer commande
      </a>
    </div>
  </div>
</main>
