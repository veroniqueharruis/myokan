---
import { Picture } from "astro:assets";
import heroImage from "assets/hero.webp";
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Zafu de méditation zen artisanal fait main par Myokan"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">
      Artisanat zen depuis 1982 · Montpellier
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter text-gray-800">
      Coussins de zazen faits main
    </h1>
    <p class="text-xl mt-5 text-gray-600 max-w-xl leading-relaxed">
      Zafus, zabutons, fukusas et accessoires zen cousus à la main sur commande,
      dans la tradition transmise par maître Deshimaru.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/zafus" class="px-6 py-3.5 bg-gray-800 text-white rounded-md hover:bg-gray-700 transition font-medium">
        Configurer mon zafu
      </a>
      <a href="/contact" class="px-6 py-3.5 border border-gray-300 text-gray-700 rounded-md hover:border-gray-500 transition font-medium">
        Passer commande
      </a>
    </div>
    <p class="mt-5 text-sm text-gray-500">
      ou écrivez directement à <a href="mailto:myokan@hotmail.fr" class="underline hover:text-gray-800 transition">myokan@hotmail.fr</a>
    </p>
  </div>
</main>
