---
---

<section 
  class="relative pt-6 pb-10 sm:pt-10 sm:pb-14 lg:pt-12 lg:pb-20 overflow-hidden" 
  aria-labelledby="hero-title"
>
  <div class="grid lg:grid-cols-12 gap-y-8 lg:gap-y-0 gap-x-8 lg:gap-x-12 xl:gap-x-16 items-center">
    
    <!-- Zone 1 : En-tête (Eyebrow, H1, Texte) -->
    <header class="order-1 lg:col-span-7 lg:row-start-1 flex flex-col text-left">
      <!-- Eyebrow -->
      <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-3 sm:mb-4">
        Artisanat zen · Montpellier · Depuis 1982
      </p>

      <!-- Titre principal H1 unique -->
      <h1
        id="hero-title"
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] xl:text-[3.5rem] font-bold font-heading tracking-tight text-gray-900 dark:text-white leading-[1.12] max-w-xl break-words"
      >
        Zafus traditionnels, façonnés par une nonne zen
      </h1>

      <!-- Texte introductif -->
      <p class="mt-4 sm:mt-5 text-base sm:text-lg lg:text-xl text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl font-medium">
        Véronique Myokan Harruis confectionne chaque zafu dans la plus pure tradition japonaise du zen. Traditionnellement associé au zazen, le zafu peut aussi accompagner d’autres pratiques méditatives ou corporelles, servir d’assise au quotidien ou devenir un objet décoratif à part entière.
      </p>
    </header>

    <!-- Zone 2 : Image du zafu artisanal -->
    <div class="order-2 lg:order-none lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:row-span-2 flex justify-center w-full">
      <figure class="w-full max-w-md lg:max-w-none">
        <div class="overflow-hidden rounded-2xl bg-gray-100 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-800 shadow-sm aspect-[4/3] sm:aspect-[5/4] lg:aspect-[4/3] xl:aspect-[5/4]">
          <img
            src="/zafu-bleu-marine-motif.webp"
            alt="Zafu de méditation artisanal bleu marine avec bande à motifs, plis d'aisance traditionnels — Confection Atelier Myokan"
            width="800"
            height="450"
            class="w-full h-full object-cover object-[center_55%]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mt-2.5 text-center lg:text-left text-xs text-gray-500 dark:text-gray-400">
          Zafu traditionnel en toile de coton bleu marine · Bande à motifs · Rembourrage kapok végétal
        </figcaption>
      </figure>
    </div>

    <!-- Zone 3 : Actions principales & Réassurance -->
    <div class="order-3 lg:order-none lg:col-span-7 lg:row-start-2 flex flex-col text-left">
      <!-- Actions principales (CTAs) -->
      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
        <a
          href="/zafus/"
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 rounded-xl transition font-semibold text-base shadow-sm focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden group text-center"
        >
          <span>Découvrir les zafus</span>
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>

        <a
          href="/a-propos/"
          class="inline-flex items-center justify-center px-6 py-3.5 border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white hover:border-gray-500 dark:hover:border-gray-500 bg-transparent rounded-xl transition font-semibold text-base focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden text-center"
        >
          Pourquoi Myokan ?
        </a>
      </div>

      <!-- Ligne de réassurance sobre -->
      <div class="mt-6 sm:mt-7 pt-5 sm:pt-6 border-t border-gray-200/70 dark:border-gray-800 max-w-xl">
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 font-medium">
          Confection unitaire sur commande · Kapok végétal naturel dense · Échange direct avec l’artisane
        </p>
      </div>
    </div>

  </div>
</section>

