---
const sizesInfo = [
  { size: "S", height: "13 cm", desc: "Assise basse & lotus" },
  { size: "M", height: "15 cm", desc: "Standard polyvalent", isStandard: true },
  { size: "L", height: "17 cm", desc: "Assise haute & grands gabarits" },
];
---

<section class="mt-14 sm:mt-20 mx-auto max-w-4xl scroll-mt-20" aria-labelledby="choisir-heading">
  <div class="p-6 sm:p-10 rounded-3xl bg-amber-50/50 dark:bg-gray-900/60 border border-amber-200/70 dark:border-gray-800 text-center relative overflow-hidden shadow-xs">
    
    <div class="max-w-2xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold text-amber-800 dark:text-amber-400 mb-1.5">
        Aide au choix & posture
      </p>

      <h2 id="choisir-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white tracking-tight">
        Quel zafu vous convient&nbsp;?
      </h2>

      <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 mt-3 leading-relaxed">
        Hauteur, morphologie, posture : quelques repères suffisent pour choisir votre assise.
      </p>

      <!-- 3 indicateurs visuels compacts S · M · L -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 sm:gap-4">
        {sizesInfo.map((s) => (
          <div 
            class:list={[
              "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs border transition",
              s.isStandard
                ? "bg-white dark:bg-gray-800 border-amber-300 dark:border-amber-700/80 shadow-2xs font-semibold text-gray-900 dark:text-white"
                : "bg-white/70 dark:bg-gray-800/60 border-gray-200/80 dark:border-gray-700/80 text-gray-700 dark:text-gray-300"
            ]}
          >
            <span class="font-bold font-mono text-amber-800 dark:text-amber-300 text-sm">{s.size}</span>
            <span class="text-gray-400 dark:text-gray-500">·</span>
            <span>{s.height}</span>
            <span class="hidden sm:inline text-gray-400 dark:text-gray-500">·</span>
            <span class="hidden sm:inline text-gray-500 dark:text-gray-400 text-[11px]">{s.desc}</span>
          </div>
        ))}
      </div>

      <!-- Actions : CTA principal & lien posture contextuel -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a 
          href="/choisir-son-zafu/" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 rounded-xl transition font-semibold text-sm shadow-sm group text-center"
        >
          <span>Voir le guide pour choisir mon zafu</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Lien contextuel vers la posture (Section 6) -->
      <p class="mt-5 text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
        Le choix d’un zafu dépend notamment de votre morphologie, de votre souplesse et de votre posture.
        <a href="/pratique-zazen/#posture" class="font-semibold text-gray-900 dark:text-white underline hover:no-underline ml-1">
          Comprendre la posture et choisir son zafu →
        </a>
      </p>

    </div>

  </div>
</section>
