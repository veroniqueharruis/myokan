---
const criteres = [
  {
    num: "1",
    title: "Hauteur & Morphologie",
    subtitle: "Tailles S, M ou L",
    desc: "La hauteur d'assise permet à vos genoux de se poser au sol tout en basculant le bassin vers l'avant. Taille M (15 cm) pour la majorité, Taille S (13 cm) pour assise en lotus souple, Taille L (17 cm) pour grand gabarit ou hanches raides.",
  },
  {
    num: "2",
    title: "Rembourrage en Kapok",
    subtitle: "Plein ou housse vide",
    desc: "Fibre végétale naturelle soyeuse et imputrescible extraite de l'arbre kapokier. Elle offre un soutien ferme et pérenne qui ne s'écrase pas. Choisissez votre zafu garni prêt à l'emploi ou en housse seule prête à garnir.",
  },
  {
    num: "3",
    title: "Toile & Personnalisation",
    subtitle: "Coton robuste & finitions",
    desc: "Tissu 100 % coton résistant cousu avec plis d'aisance traditionnels. Optez pour le noir traditionnel sobre de dojo, des coloris personnalisés ou une confection sur mesure adaptée à vos besoins spécifiques.",
  },
];
---

<section class="mt-14 sm:mt-20 mx-auto max-w-5xl" aria-labelledby="choisir-heading">
  <div class="p-7 sm:p-10 lg:p-12 rounded-3xl bg-gray-50 dark:bg-gray-900/70 border border-gray-200 dark:border-gray-800 shadow-sm relative overflow-hidden">
    
    <!-- Accent décoratif discret inspiré de la tradition -->
    <div class="absolute -right-12 -bottom-12 w-48 h-48 rounded-full bg-amber-500/5 dark:bg-amber-400/5 pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-2xl">
      <span class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
        Guide d'assise & personnalisation
      </span>
      <h2 id="choisir-heading" class="text-3xl sm:text-4xl font-bold font-heading text-gray-900 dark:text-white mt-1.5 tracking-tight">
        Quel zafu vous convient ?
      </h2>
      <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-3 font-medium leading-relaxed">
        Taille, hauteur, posture, rembourrage : choisissez votre zafu en fonction de votre pratique.
      </p>
    </div>

    <!-- Les 3 repères de choix -->
    <div class="mt-8 grid sm:grid-cols-3 gap-5 lg:gap-6">
      {criteres.map((c) => (
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 flex flex-col justify-between shadow-xs">
          <div>
            <div class="flex items-center gap-2.5 mb-2.5">
              <span class="w-6 h-6 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-950 text-xs font-bold font-mono flex items-center justify-center shrink-0">
                {c.num}
              </span>
              <h3 class="font-bold text-base text-gray-900 dark:text-white">
                {c.title}
              </h3>
            </div>
            <p class="text-xs font-semibold text-amber-800 dark:text-amber-400 mb-2">
              {c.subtitle}
            </p>
            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              {c.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Actions principales : CTA direct vers le configurateur & lien guide posture -->
    <div class="mt-8 pt-6 border-t border-gray-200/80 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a 
          href="/choisir-son-zafu/" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gray-900 hover:bg-gray-800 text-white dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 rounded-xl transition font-semibold text-sm sm:text-base shadow-sm group text-center"
        >
          <span>Quel zafu choisir ?</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>

        <a 
          href="/zafus/" 
          class="inline-flex items-center justify-center px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white underline hover:no-underline transition text-center"
        >
          Accéder directement au configurateur →
        </a>
      </div>

      <span class="text-xs text-gray-500 dark:text-gray-400">
        Guide interactif & conseils personnalisés
      </span>
    </div>

  </div>
</section>
