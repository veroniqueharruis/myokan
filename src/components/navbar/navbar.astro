---
import Container from "@components/container.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "");

const isZafusActive = currentPath === "/zafus";
const isChoisirActive = currentPath === "/choisir-son-zafu";

const accessoires = [
  { title: "Zabutons (tapis de sol)", path: "/zabutons/" },
  { title: "Sacs à zafu en coton", path: "/sacs-zafus/" },
  { title: "Fukusas pour oryoki", path: "/fukusas/" },
  { title: "Oryokis (service complet)", path: "/oryokis/" },
  { title: "Sacs à kesa & ketsumyaku", path: "/kesas/" },
];

const isAccessoiresHubActive = currentPath === "/accessoires";
const isAccessoiresActive = isAccessoiresHubActive || accessoires.some(a => currentPath === a.path.replace(/\/$/, ""));
const isPratiqueActive = currentPath === "/pratique-zazen";
const isAtelierActive = currentPath === "/a-propos";
const isCommanderActive = currentPath === "/commander";
const isContactActive = currentPath === "/contact";
---

<Container>
  <header class="py-4 border-b border-gray-100 dark:border-gray-800">
    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center justify-between" aria-label="Navigation principale">
      <a href="/" class="text-xl shrink-0 flex items-center gap-3 group py-2 focus-visible:ring-2 rounded-md">
        <img
          src="/logo.jpg"
          alt="Sceau Myokan"
          width="40"
          height="40"
          class="rounded-sm object-cover transition group-hover:opacity-80"
        />
        <span class="flex flex-col">
          <span class="font-bold text-gray-900 dark:text-white font-heading text-2xl tracking-wide group-hover:text-gray-700 dark:group-hover:text-gray-300 transition leading-none">Myokan</span>
          <span class="text-xs uppercase tracking-wider text-gray-600 dark:text-gray-300 font-sans">Zafus & Artisanat Zen</span>
        </span>
      </a>

      <ul class="flex items-center gap-1 xl:gap-2 text-sm font-medium">
        <!-- 1. Zafus (Primary Product & Topic) -->
        <li>
          <a
            href="/zafus/"
            aria-current={isZafusActive ? "page" : undefined}
            class:list={[
              "px-3 py-2 rounded-md transition focus-visible:ring-2 font-semibold",
              isZafusActive 
                ? "text-gray-950 dark:text-white underline underline-offset-4 decoration-2" 
                : "text-gray-900 dark:text-gray-100 hover:text-gray-950 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800"
            ]}
          >
            Zafus
          </a>
        </li>

        <!-- 2. Accessoires (Secondary Commercial Category with dropdown) -->
        <li class="relative" id="accessoires-dropdown-container">
          <div class="flex items-center">
            <a
              href="/accessoires/"
              aria-current={isAccessoiresHubActive ? "page" : undefined}
              class:list={[
                "pl-3 pr-1 py-2 rounded-l-md transition focus-visible:ring-2",
                isAccessoiresActive 
                  ? "text-gray-950 dark:text-white font-semibold underline underline-offset-4 decoration-2" 
                  : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
              ]}
            >
              Accessoires
            </a>
            <button
              type="button"
              id="accessoires-menu-button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="accessoires-dropdown-menu"
              aria-label="Ouvrir le sous-menu des accessoires"
              class:list={[
                "pr-2 pl-0.5 py-2 rounded-r-md transition focus-visible:ring-2",
                isAccessoiresActive 
                  ? "text-gray-950 dark:text-white" 
                  : "text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
              ]}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200" id="accessoires-arrow" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
          </div>
          
          <ul
            id="accessoires-dropdown-menu"
            class="hidden absolute left-0 top-full mt-1 w-60 py-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg z-50 transition before:content-[''] before:block before:absolute before:-top-3 before:left-0 before:right-0 before:h-3"
            role="menu"
            aria-labelledby="accessoires-menu-button"
          >
            <li role="none">
              <a
                href="/accessoires/"
                role="menuitem"
                aria-current={isAccessoiresHubActive ? "page" : undefined}
                class:list={[
                  "block px-4 py-2 text-xs uppercase tracking-wider font-bold transition border-b border-gray-100 dark:border-gray-800 focus-visible:bg-gray-100 dark:focus-visible:bg-gray-800",
                  isAccessoiresHubActive 
                    ? "text-gray-950 dark:text-white bg-gray-50 dark:bg-gray-800/60" 
                    : "text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
                ]}
              >
                Tous les accessoires &rarr;
              </a>
            </li>
            {accessoires.map((a) => {
              const active = currentPath === a.path.replace(/\/$/, "");
              return (
                <li role="none">
                  <a
                    href={a.path}
                    role="menuitem"
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "block px-4 py-2 text-sm transition focus-visible:bg-gray-100 dark:focus-visible:bg-gray-800",
                      active 
                        ? "text-gray-950 dark:text-white font-semibold bg-gray-50 dark:bg-gray-800/60" 
                        : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
                    ]}
                  >
                    {a.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>

        <!-- 4. L'atelier (Brand / Trust) -->
        <li>
          <a
            href="/a-propos/"
            aria-current={isAtelierActive ? "page" : undefined}
            class:list={[
              "px-3 py-2 rounded-md transition focus-visible:ring-2",
              isAtelierActive 
                ? "text-gray-950 dark:text-white font-semibold underline underline-offset-4 decoration-2" 
                : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
          >
            L'atelier
          </a>
        </li>

        <!-- 5. Commander (Conversion Destination) -->
        <li>
          <a
            href="/commander/"
            aria-current={isCommanderActive ? "page" : undefined}
            class:list={[
              "px-3 py-2 rounded-md transition focus-visible:ring-2 font-semibold",
              isCommanderActive 
                ? "text-gray-950 dark:text-white underline underline-offset-4 decoration-2" 
                : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
          >
            Commander
          </a>
        </li>

        <!-- Highlighted Helper CTA: Quel zafu choisir ? -->
        <li>
          <a
            href="/choisir-son-zafu/"
            aria-current={isChoisirActive ? "page" : undefined}
            class:list={[
              "ml-1 xl:ml-2 px-3 py-1.5 rounded-full text-xs font-semibold transition border inline-flex items-center gap-1.5 shadow-2xs",
              isChoisirActive
                ? "bg-amber-100 text-amber-950 dark:bg-amber-950/60 dark:text-amber-200 border-amber-300 dark:border-amber-700 font-bold"
                : "bg-amber-50/90 text-amber-900 dark:bg-amber-950/30 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/60 hover:bg-amber-100 dark:hover:bg-amber-900/50"
            ]}
          >
            <span aria-hidden="true">🧭</span>
            <span>Quel zafu choisir ?</span>
          </a>
        </li>

        <!-- Dark mode toggle -->
        <li>
          <button
            type="button"
            id="theme-toggle"
            aria-label="Basculer entre thème clair et sombre"
            class="ml-1 p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition min-w-[40px] min-h-[40px] flex items-center justify-center focus-visible:ring-2"
          >
            <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <!-- Mobile navigation bar -->
    <div class="lg:hidden">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 py-1 focus-visible:ring-2 rounded-md group">
          <img
            src="/logo.jpg"
            alt="Sceau Myokan"
            width="36"
            height="36"
            class="rounded-sm object-cover transition group-hover:opacity-80"
          />
          <span class="flex flex-col">
            <span class="font-bold text-gray-900 dark:text-white font-heading text-xl tracking-wide leading-none">Myokan</span>
            <span class="text-[11px] uppercase tracking-wider text-gray-600 dark:text-gray-300 font-sans">Artisanat zen · Montpellier</span>
          </span>
        </a>
        
        <div class="flex items-center gap-1">
          <button
            type="button"
            id="theme-toggle-mobile"
            aria-label="Basculer le mode sombre"
            class="p-2.5 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition min-w-[44px] min-h-[44px] flex items-center justify-center focus-visible:ring-2"
          >
            <svg id="icon-sun-mobile" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg id="icon-moon-mobile" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>

          <button
            type="button"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-navigation-menu"
            aria-label="Ouvrir le menu de navigation"
            class="p-2.5 text-gray-700 dark:text-gray-200 hover:text-gray-950 dark:hover:text-white rounded-lg transition min-w-[44px] min-h-[44px] flex items-center justify-center focus-visible:ring-2"
          >
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile navigation panel -->
      <nav
        id="mobile-navigation-menu"
        class="hidden mt-4 border-t border-gray-200 dark:border-gray-800 pt-4 pb-2"
        aria-label="Navigation mobile"
      >
        <!-- 1. Zafus (Primary) -->
        <div class="mb-3.5">
          <p class="px-3 pb-1 text-xs font-bold text-gray-900 dark:text-white uppercase tracking-wider">
            Zafus artisanaux (Principal)
          </p>
          <ul class="space-y-1">
            <li>
              <a
                href="/zafus/"
                aria-current={isZafusActive ? "page" : undefined}
                class:list={[
                  "block px-3 py-2.5 rounded-lg text-base font-semibold transition",
                  isZafusActive 
                    ? "text-gray-950 dark:text-white bg-gray-100 dark:bg-gray-800" 
                    : "text-gray-800 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800/60"
                ]}
              >
                Tous nos zafus & configurateur
              </a>
            </li>
            <li>
              <a
                href="/choisir-son-zafu/"
                aria-current={isChoisirActive ? "page" : undefined}
                class:list={[
                  "block px-3 py-2 rounded-lg text-sm transition flex items-center justify-between",
                  isChoisirActive
                    ? "text-amber-950 dark:text-amber-200 font-semibold bg-amber-50 dark:bg-amber-950/50"
                    : "text-amber-900 dark:text-amber-300 hover:bg-amber-50/60 dark:hover:bg-amber-950/30"
                ]}
              >
                <span>🧭 Quel zafu choisir ? (Guide interactif)</span>
                <span class="text-xs">&rarr;</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- 2. Accessoires (Secondary Commercial) -->
        <div class="border-t border-gray-200 dark:border-gray-800 pt-3 mb-3.5">
          <div class="flex items-center justify-between px-3 pb-1">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Accessoires zen (Compléments)
            </p>
            <a href="/accessoires/" class="text-[11px] font-semibold text-gray-800 dark:text-gray-200 underline">
              Voir tout
            </a>
          </div>
          <ul class="space-y-0.5">
            {accessoires.map((a) => {
              const active = currentPath === a.path.replace(/\/$/, "");
              return (
                <li>
                  <a
                    href={a.path}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "block px-3 py-1.5 rounded-md text-sm transition",
                      active 
                        ? "text-gray-950 dark:text-white font-semibold bg-gray-100 dark:bg-gray-800" 
                        : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/60"
                    ]}
                  >
                    {a.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- 3. L'atelier & Contact -->
        <div class="border-t border-gray-200 dark:border-gray-800 pt-3 mb-3.5 space-y-1">
          <a
            href="/a-propos/"
            aria-current={isAtelierActive ? "page" : undefined}
            class:list={[
              "block px-3 py-2 rounded-md text-sm transition",
              isAtelierActive 
                ? "text-gray-950 dark:text-white font-semibold bg-gray-100 dark:bg-gray-800" 
                : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/60"
            ]}
          >
            L'atelier & Véronique Harruis
          </a>
          <a
            href="/contact/"
            aria-current={isContactActive ? "page" : undefined}
            class:list={[
              "block px-3 py-2 rounded-md text-sm transition",
              isContactActive 
                ? "text-gray-950 dark:text-white font-semibold bg-gray-100 dark:bg-gray-800" 
                : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/60"
            ]}
          >
            Contact & Informations
          </a>
          <a
            href="/commander/"
            aria-current={isCommanderActive ? "page" : undefined}
            class:list={[
              "block px-3 py-2.5 rounded-lg text-sm font-semibold transition mt-2 bg-gray-900 text-white dark:bg-white dark:text-gray-950 text-center shadow-sm hover:bg-gray-800 dark:hover:bg-gray-100",
            ]}
          >
            Commander un zafu / Tarifs & Devis
          </a>
        </div>

        <!-- 4. Repères & Posture (Secondary reference) -->
        <div class="border-t border-gray-200 dark:border-gray-800 pt-3">
          <p class="px-3 pb-1 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
            Repères & Posture
          </p>
          <ul class="space-y-0.5">
            <li>
              <a
                href="/pratique-zazen/"
                aria-current={isPratiqueActive ? "page" : undefined}
                class:list={[
                  "block px-3 py-1.5 rounded-md text-sm transition",
                  isPratiqueActive 
                    ? "text-gray-950 dark:text-white font-semibold bg-gray-100 dark:bg-gray-800" 
                    : "text-gray-700 dark:text-gray-300 hover:text-gray-950 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/60"
                ]}
              >
                Posture assise & tradition du zazen
              </a>
            </li>
            <li>
              <a
                href="/pratique-zazen/#posture"
                class="block px-3 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
              >
                ↳ Repères anatomiques d'assise
              </a>
            </li>
            <li>
              <a
                href="/pratique-zazen/#dojo-montpellier"
                class="block px-3 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
              >
                ↳ Dojo Zen de Montpellier
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </header>
</Container>


<script is:inline>
  (function () {
    // Theme toggle handling
    function syncIcons(isDark) {
      ["", "-mobile"].forEach(function (suffix) {
        var sun = document.getElementById("icon-sun" + suffix);
        var moon = document.getElementById("icon-moon" + suffix);
        if (sun) sun.classList.toggle("hidden", !isDark);
        if (moon) moon.classList.toggle("hidden", isDark);
      });
    }

    function toggleTheme() {
      var isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncIcons(isDark);
    }

    syncIcons(document.documentElement.classList.contains("dark"));

    var btn = document.getElementById("theme-toggle");
    var btnMobile = document.getElementById("theme-toggle-mobile");
    if (btn) btn.addEventListener("click", toggleTheme);
    if (btnMobile) btnMobile.addEventListener("click", toggleTheme);

    // Desktop Dropdown pour Accessoires
    var dropdownContainer = document.getElementById("accessoires-dropdown-container");
    var dropdownBtn = document.getElementById("accessoires-menu-button");
    var dropdownMenu = document.getElementById("accessoires-dropdown-menu");
    var dropdownArrow = document.getElementById("accessoires-arrow");
    var closeTimer = null;

    function clearCloseTimer() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    function openDropdown() {
      clearCloseTimer();
      if (!dropdownMenu) return;
      dropdownMenu.classList.remove("hidden");
      dropdownBtn?.setAttribute("aria-expanded", "true");
      if (dropdownArrow) dropdownArrow.style.transform = "rotate(180deg)";
    }

    function closeDropdown() {
      clearCloseTimer();
      if (!dropdownMenu) return;
      dropdownMenu.classList.add("hidden");
      dropdownBtn?.setAttribute("aria-expanded", "false");
      if (dropdownArrow) dropdownArrow.style.transform = "rotate(0deg)";
    }

    function scheduleClose() {
      clearCloseTimer();
      closeTimer = setTimeout(function () {
        if (!dropdownContainer?.contains(document.activeElement)) {
          closeDropdown();
        }
      }, 250);
    }

    if (dropdownBtn && dropdownMenu) {
      dropdownBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        var expanded = dropdownBtn.getAttribute("aria-expanded") === "true";
        if (expanded) {
          closeDropdown();
        } else {
          openDropdown();
        }
      });

      // Hover handling with smooth grace period
      dropdownContainer?.addEventListener("mouseenter", openDropdown);
      dropdownContainer?.addEventListener("mouseleave", scheduleClose);

      // Close menu when clicking outside
      document.addEventListener("click", function (e) {
        if (!dropdownContainer?.contains(e.target)) {
          closeDropdown();
        }
      });

      // Close menu when a link inside is clicked
      dropdownMenu.addEventListener("click", function (e) {
        if (e.target.closest("a")) {
          closeDropdown();
        }
      });

      // Close menu when keyboard focus leaves the dropdown container
      dropdownContainer?.addEventListener("focusout", function (e) {
        if (!dropdownContainer.contains(e.relatedTarget)) {
          closeDropdown();
        }
      });

      // Keyboard navigation
      dropdownBtn.addEventListener("keydown", function (e) {
        if (e.key === "ArrowDown" || e.key === "Down") {
          e.preventDefault();
          openDropdown();
          var firstLink = dropdownMenu.querySelector("a");
          firstLink?.focus();
        }
      });

      dropdownMenu.addEventListener("keydown", function (e) {
        var links = Array.from(dropdownMenu.querySelectorAll("a"));
        var index = links.indexOf(document.activeElement);
        if (e.key === "ArrowDown" || e.key === "Down") {
          e.preventDefault();
          var nextIndex = (index + 1) % links.length;
          links[nextIndex]?.focus();
        } else if (e.key === "ArrowUp" || e.key === "Up") {
          e.preventDefault();
          if (index <= 0) {
            dropdownBtn.focus();
          } else {
            links[index - 1]?.focus();
          }
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !dropdownMenu.classList.contains("hidden")) {
          closeDropdown();
          dropdownBtn.focus();
        }
      });
    }

    // Mobile Navigation Menu Toggle
    var mobileToggle = document.getElementById("mobile-menu-toggle");
    var mobileNav = document.getElementById("mobile-navigation-menu");
    var hamburgerIcon = document.getElementById("hamburger-icon");
    var closeIcon = document.getElementById("close-icon");

    if (mobileToggle && mobileNav) {
      mobileToggle.addEventListener("click", function () {
        var isOpen = !mobileNav.classList.contains("hidden");
        if (isOpen) {
          mobileNav.classList.add("hidden");
          mobileToggle.setAttribute("aria-expanded", "false");
          mobileToggle.setAttribute("aria-label", "Ouvrir le menu de navigation");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        } else {
          mobileNav.classList.remove("hidden");
          mobileToggle.setAttribute("aria-expanded", "true");
          mobileToggle.setAttribute("aria-label", "Fermer le menu de navigation");
          hamburgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !mobileNav.classList.contains("hidden")) {
          mobileNav.classList.add("hidden");
          mobileToggle.setAttribute("aria-expanded", "false");
          mobileToggle.setAttribute("aria-label", "Ouvrir le menu de navigation");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
          mobileToggle.focus();
        }
      });
    }
  })();
</script>
