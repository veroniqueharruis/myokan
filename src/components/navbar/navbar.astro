---
import Container from "@components/container.astro";

const produits = [
  { title: "Zafus", path: "/zafus" },
  { title: "Zabutons", path: "/zabutons" },
  { title: "Sacs à zafu", path: "/sacs-zafus" },
  { title: "Fukusas", path: "/fukusas" },
  { title: "Oryokis", path: "/oryokis" },
  { title: "Sacs à kesa", path: "/kesas" },
];
---

<Container>
  <header class="my-5">

    <!-- Desktop -->
    <nav class="hidden lg:flex items-center justify-between">
      <a href="/" class="text-lg shrink-0">
        <span class="font-bold text-gray-800">Zafus</span>
        <span class="text-gray-500">Myokan</span>
      </a>
      <ul class="flex items-center gap-1">
        <li class="relative group">
          <button class="flex items-center gap-1 px-3 py-2 text-gray-700 hover:text-gray-900 cursor-default select-none">
            Créations
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <ul class="absolute left-0 top-full hidden group-hover:block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md shadow-md w-44 py-1 z-50">
            {produits.map((p) => (
              <li>
                <a href={p.path} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900">
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li>
          <a href="/a-propos" class="px-3 py-2 text-gray-700 hover:text-gray-900">À propos</a>
          <a href="/contact" class="px-3 py-2 text-gray-700 hover:text-gray-900">Contact</a>
        </li>
        <li>
          <button id="theme-toggle" aria-label="Basculer le mode sombre" class="ml-2 p-2 rounded-md text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition">
            <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <!-- Mobile -->
    <div class="lg:hidden">
      <div class="flex items-center justify-between">
        <a href="/" class="text-lg">
          <span class="font-bold text-gray-800">Zafus</span>
          <span class="text-gray-500">Myokan</span>
        </a>
        <div class="flex items-center gap-1">
          <button id="theme-toggle-mobile" aria-label="Basculer le mode sombre" class="p-2 rounded-md text-gray-500 hover:text-gray-800 transition">
            <svg id="icon-sun-mobile" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg id="icon-moon-mobile" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
          <label for="nav-toggle" class="cursor-pointer p-2 text-gray-700" aria-label="Ouvrir le menu">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </label>
        </div>
      </div>
      <input type="checkbox" id="nav-toggle" class="peer hidden" />
      <nav class="hidden peer-checked:block mt-3 border-t border-gray-100 pt-3">
        <p class="px-2 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wide">Créations</p>
        <ul class="mb-3">
          {produits.map((p) => (
            <li>
              <a href={p.path} class="block px-2 py-2 text-gray-700 hover:text-gray-900">{p.title}</a>
            </li>
          ))}
        </ul>
        <div class="border-t border-gray-100 pt-3">
          <a href="/a-propos" class="block px-2 py-2 text-gray-700 hover:text-gray-900">À propos</a>
          <a href="/contact" class="block px-2 py-2 text-gray-700 hover:text-gray-900">Contact</a>
        </div>
      </nav>
    </div>

  </header>
</Container>

<script is:inline>
  function syncIcons(isDark) {
    ["", "-mobile"].forEach(function(suffix) {
      var sun = document.getElementById("icon-sun" + suffix);
      var moon = document.getElementById("icon-moon" + suffix);
      if (sun) sun.classList.toggle("hidden", !isDark);
      if (moon) moon.classList.toggle("hidden", isDark);
    });
  }

  function toggleTheme() {
    var isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncIcons(isDark);
  }

  // Init icons on load
  syncIcons(document.documentElement.classList.contains("dark"));

  var btn = document.getElementById("theme-toggle");
  var btnMobile = document.getElementById("theme-toggle-mobile");
  if (btn) btn.addEventListener("click", toggleTheme);
  if (btnMobile) btnMobile.addEventListener("click", toggleTheme);
</script>
