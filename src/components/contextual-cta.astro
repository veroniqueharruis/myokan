---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  primaryCta: {
    label: string;
    href: string;
  };
  secondaryCta?: {
    label: string;
    href: string;
  };
  variant?: "default" | "highlight" | "dark" | "minimal";
  class?: string;
}

const {
  title,
  description,
  eyebrow,
  primaryCta,
  secondaryCta,
  variant = "default",
  class: className = "",
} = Astro.props;

const variantStyles = {
  default: "bg-gray-50 dark:bg-gray-900/60 border-gray-200/80 dark:border-gray-800 text-gray-900 dark:text-white",
  highlight: "bg-amber-50/80 dark:bg-amber-950/25 border-amber-200/80 dark:border-amber-900/50 text-gray-900 dark:text-white",
  dark: "bg-gray-900 dark:bg-gray-850 border-gray-800 text-white",
  minimal: "bg-transparent border-t border-b border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white rounded-none p-0 py-8",
};

const primaryBtnStyles = {
  default: "bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 shadow-2xs",
  highlight: "bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 shadow-2xs",
  dark: "bg-white text-gray-950 hover:bg-gray-100 shadow-2xs",
  minimal: "bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 shadow-2xs",
};

const secondaryBtnStyles = {
  default: "border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 hover:border-gray-500 dark:hover:border-gray-400 bg-white dark:bg-gray-800/80",
  highlight: "border border-amber-300 dark:border-amber-700/80 text-amber-950 dark:text-amber-200 hover:bg-amber-100/50 dark:hover:bg-amber-900/40 bg-white dark:bg-gray-800/80",
  dark: "border border-gray-700 text-gray-200 hover:border-gray-500 hover:text-white bg-transparent",
  minimal: "border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 hover:border-gray-500 bg-transparent",
};
---

<aside 
  class:list={[
    "rounded-2xl border p-6 sm:p-8 transition",
    variantStyles[variant],
    className
  ]}
  aria-label={title}
>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="max-w-2xl">
      {eyebrow && (
        <span class:list={[
          "text-[11px] uppercase tracking-wider font-semibold block mb-1.5",
          variant === "highlight" 
            ? "text-amber-900 dark:text-amber-300" 
            : variant === "dark" 
              ? "text-amber-400" 
              : "text-gray-500 dark:text-gray-400"
        ]}>
          {eyebrow}
        </span>
      )}
      <h3 class:list={[
        "text-xl sm:text-2xl font-bold font-heading tracking-tight",
        variant === "dark" ? "text-white" : "text-gray-900 dark:text-white"
      ]}>
        {title}
      </h3>
      <p class:list={[
        "mt-2 text-xs sm:text-sm leading-relaxed",
        variant === "dark" ? "text-gray-300" : "text-gray-600 dark:text-gray-300"
      ]}>
        {description}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 shrink-0">
      <a
        href={primaryCta.href}
        class:list={[
          "inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold transition text-center",
          primaryBtnStyles[variant]
        ]}
      >
        <span>{primaryCta.label}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class:list={[
            "inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-semibold transition text-center",
            secondaryBtnStyles[variant]
          ]}
        >
          <span>{secondaryCta.label}</span>
        </a>
      )}
    </div>
  </div>
</aside>
